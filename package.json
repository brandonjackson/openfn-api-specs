{
  "name": "openfn-api-specs",
  "version": "0.1.0",
  "description": "Maintained OpenAPI specs and standalone data-object schemas for every OpenFn adaptor.",
  "license": "LGPL-3.0",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "openfn-api-specs": "dist/cli.js",
    "api-specs": "dist/cli.js"
  },
  "files": [
    "dist",
    "specs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "specs": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "prepare": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5"
  }
}
