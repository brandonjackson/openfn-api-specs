{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primero/Flag",
  "title": "Flag",
  "x-openfn-adaptor": "primero",
  "x-source": {
    "openapi": "#/components/schemas/Flag",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A flag raised on a record.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "cases",
        "incidents",
        "tracing_requests",
        "registry_records",
        "families"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "message": {
      "type": "string"
    },
    "flagged_by": {
      "type": "string"
    },
    "removed": {
      "type": "boolean"
    },
    "unflag_message": {
      "type": [
        "string",
        "null"
      ]
    },
    "unflagged_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "unflagged_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "system_generated_followup": {
      "type": "boolean"
    },
    "record_access_denied": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "record": {
      "allOf": [
        {
          "$ref": "RecordIdentifier.json"
        }
      ]
    },
    "short_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "hidden_name": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "owned_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "owned_by_agency_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    }
  },
  "additionalProperties": true,
  "example": {
    "id": 1,
    "record_id": "b3222e84-a5d7-4692-a643-1ab3d41f17d6",
    "record_type": "cases",
    "date": "2019-08-01",
    "message": "Follow up required",
    "flagged_by": "primero",
    "removed": false,
    "created_at": "2019-08-01T18:00:00.000Z",
    "system_generated_followup": false
  }
}
