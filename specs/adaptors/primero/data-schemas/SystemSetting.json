{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primero/SystemSetting",
  "title": "SystemSetting",
  "x-openfn-adaptor": "primero",
  "x-source": {
    "openapi": "#/components/schemas/SystemSetting",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Deployment-wide settings: locales, age ranges, approval labels and enabled options.",
  "properties": {
    "default_locale": {
      "type": "string"
    },
    "locales": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_language": {
      "type": "string"
    },
    "case_code_format": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_populate_list": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "reporting_location_config": {
      "type": "object",
      "additionalProperties": true
    },
    "age_ranges": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "primary_age_range": {
      "type": "string"
    },
    "welcome_email_text_i18n": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Localised text keyed by locale code (`en`, `fr`, `ar`, `es`, ...)."
    },
    "approval_forms_to_alert": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "approvals_labels": {
      "type": "object",
      "additionalProperties": true
    },
    "export_config_id": {
      "type": "object",
      "additionalProperties": true
    },
    "duplicate_export_field": {
      "type": [
        "string",
        "null"
      ]
    },
    "primero_version": {
      "type": "string"
    },
    "system_options": {
      "type": "object",
      "additionalProperties": true
    },
    "agencies": {
      "type": "array",
      "items": {
        "$ref": "Agency.json"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "PrimeroModule.json"
      }
    }
  },
  "additionalProperties": true
