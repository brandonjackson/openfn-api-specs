{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primero/FormField",
  "title": "FormField",
  "x-openfn-adaptor": "primero",
  "x-source": {
    "openapi": "#/components/schemas/FormField",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A field definition inside a form section.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "description": "e.g. `text_field`, `textarea`, `numeric_field`, `date_field`, `select_box`, `subform`, `photo_upload_box`."
    },
    "form_section_id": {
      "type": "integer"
    },
    "visible": {
      "type": "boolean"
    },
    "mobile_visible": {
      "type": "boolean"
    },
    "show_on_minify_form": {
      "type": "boolean"
    },
    "editable": {
      "type": "boolean"
    },
    "display_name": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Localised text keyed by locale code (`en`, `fr`, `ar`, `es`, ...)."
    },
    "help_text": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Localised text keyed by locale code (`en`, `fr`, `ar`, `es`, ...)."
    },
    "guiding_questions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Localised text keyed by locale code (`en`, `fr`, `ar`, `es`, ...)."
    },
    "order": {
      "type": "integer"
    },
    "multi_select": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "option_strings_source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Lookup the options come from, e.g. `lookup lookup-risk-level`."
    },
    "option_strings_text": {
      "description": "Inline options, when not sourced from a lookup."
    },
    "subform_section_id": {
      "type": [
        "integer",
        "null"
      ]
    },
    "link_to_path_external": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "date_validation": {
      "type": [
        "string",
        "null"
      ]
    },
    "matchable": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "required": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "disabled": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true
