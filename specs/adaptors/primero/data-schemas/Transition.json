    "id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "enum": [
        "Assign",
        "Referral",
        "Transfer",
        "TransferRequest"
      ]
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "description": "`in_progress`, `accepted`, `rejected`, `done`, `revoked`."
    },
    "record_id": {
      "type": "string",
      "format": "uuid"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "Child",
        "Incident",
        "TracingRequest"
      ]
    },
    "transitioned_to": {
      "type": "string"
    },
    "transitioned_by": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_overridden": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "service_record_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "rejection_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_access_denied": {
      "type": [
        "boolean",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "example": {
    "id": "6b0d0a70-2fd7-4d4c-9c7a-5b1e6f0a1234",
    "type": "Referral",
    "record_id": "b3222e84-a5d7-4692-a643-1ab3d41f17d6",
    "record_type": "Child",
    "transitioned_to": "social_worker",
    "transitioned_by": "primero",
    "notes": "Home visit needed.",
    "created_at": "2019-08-01T18:00:00.000Z"
  }
