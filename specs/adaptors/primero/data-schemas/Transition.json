{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primero/Transition",
  "title": "Transition",
  "x-openfn-adaptor": "primero",
  "x-source": {
    "openapi": "#/components/schemas/Transition",
