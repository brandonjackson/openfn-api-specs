{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "primero/Export",
  "title": "Export",
  "x-openfn-adaptor": "primero",
  "x-source": {
    "openapi": "#/components/schemas/Export",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A bulk export job.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "processing",
        "success",
        "failure",
        "archived"
      ]
    },
    "owned_by": {
      "type": "string"
    },
    "completed_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "record_type": {
      "type": "string"
    },
    "file_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "export_format": {
      "type": "string",
      "description": "e.g. `csv`, `xls`, `json`, `unhcr_csv`."
    },
    "export_file": {
      "type": [
        "string",
        "null"
      ],
      "description": "Relative URL of the generated file, once the job completes."
    }
  },
  "additionalProperties": true
}
