{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openlmis/CceAlert",
  "title": "CCE alert",
  "x-openfn-adaptor": "openlmis",
  "x-source": {
    "openapi": "#/components/schemas/CceAlert",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A single CCE alert",
  "properties": {
    "alert_id": {
      "type": "string",
      "title": "Alert id"
    },
    "alert_type": {
      "enum": [
        "no_data",
        "warning_hot",
        "warning_freezing",
        "not_working_hot",
        "not_working_freezing",
        "warning_power"
      ],
      "title": "Alert type"
    },
    "device_id": {
      "type": "string",
      "title": "Device id"
    },
    "start_ts": {
      "type": "string",
      "title": "Alert start"
    },
    "end_ts": {
      "type": [
        "string",
        "null"
      ],
      "title": "Alert end"
    },
    "status": {
      "$ref": "CceAlertStatusMessages.json"
    },
    "dismissed": {
      "type": [
        "boolean",
        "null"
      ],
      "title": "Dismissed"
    }
  },
  "required": [
    "alert_id",
    "alert_type",
    "device_id",
    "start_ts",
    "status"
  ]
}
