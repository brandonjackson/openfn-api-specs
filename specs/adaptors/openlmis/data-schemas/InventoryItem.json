{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openlmis/InventoryItem",
  "title": "InventoryItem",
  "x-openfn-adaptor": "openlmis",
  "x-source": {
    "openapi": "#/components/schemas/InventoryItem",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A single CCE Inventory item",
  "properties": {
    "id": {
      "type": "string",
      "title": "id"
    },
    "facility": {
      "$ref": "ReferenceObjectDto.json"
    },
    "catalogItem": {
      "$ref": "CatalogItem.json"
    },
    "program": {
      "$ref": "ReferenceObjectDto.json"
    },
    "equipmentTrackingId": {
      "type": "string",
      "title": "equipmentTrackingId"
    },
    "referenceName": {
      "type": "string",
      "title": "referenceName"
    },
    "yearOfInstallation": {
      "type": "integer",
      "title": "yearOfInstallation"
    },
    "yearOfWarrantyExpiry": {
      "type": "integer",
      "title": "yearOfWarrantyExpiry"
    },
    "source": {
      "type": "string",
      "title": "source"
    },
    "functionalStatus": {
      "enum": [
        "FUNCTIONING",
        "AWAITING_REPAIR",
        "UNSERVICEABLE",
        "NEEDS_ATTENTION"
      ],
      "title": "functionalStatus"
    },
    "reasonNotWorkingOrNotInUse": {
      "enum": [
        "NEEDS_SPARE_PARTS",
        "NO_FINANCE",
        "NO_FUEL",
        "SURPLUS",
        "DEAD",
        "NOT_IN_USE",
        "DECOMMISSIONED"
      ],
      "title": "reasonNotWorkingOrNotInUse"
    },
    "utilization": {
      "enum": [
        "ACTIVE",
        "NOT_IN_USE",
        "IN_STORE_FOR_ALLOCATION"
      ],
      "title": "utilization"
    },
    "voltageStabilizer": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "voltageStabilizer"
    },
    "backupGenerator": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ],
      "title": "backupGenerator"
    },
    "voltageRegulator": {
      "enum": [
        "YES",
        "NO",
        "UNKNOWN",
        "NOT_APPLICABLE",
        "NA"
      ],
      "title": "voltageRegulator"
    },
    "manualTemperatureGauge": {
      "enum": [
        "BUILD_IN",
        "PAIRED",
        "NO_GAUGE"
      ],
      "title": "manualTemperatureGauge"
    },
    "remoteTemperatureMonitor": {
      "enum": [
        "BUILD_IN",
        "PAIRED",
        "NO_RTM"
      ],
      "title": "remoteTemperatureMonitor"
    },
    "remoteTemperatureMonitorId": {
      "type": "string",
      "title": "remoteTemperatureMonitorId"
    },
    "additionalNotes": {
      "type": "string",
      "title": "additionalNotes"
    },
    "decommissionDate": {
      "type": [
        "string",
        "null"
      ],
      "title": "decommissionDate"
    },
    "modifiedDate": {
      "type": [
        "string",
        "null"
      ],
      "title": "modifiedDate"
    },
    "lastModifier": {
      "type": [
        "object",
        "null"
      ],
      "title": "lastModifier"
    }
  },
  "required": [
    "catalogItem",
    "facility",
    "program",
    "yearOfInstallation",
    "functionalStatus",
    "referenceName",
    "utilization",
    "voltageStabilizer",
    "backupGenerator",
    "voltageRegulator",
    "manualTemperatureGauge",
    "remoteTemperatureMonitor"
  ]
}
