{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openlmis/BasicRequisitionDto",
  "title": "BasicRequisitionDto",
  "x-openfn-adaptor": "openlmis",
  "x-source": {
    "openapi": "#/components/schemas/BasicRequisitionDto",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Basic information about a single requisition",
  "properties": {
    "id": {
      "type": "string",
      "title": "id"
    },
    "emergency": {
      "type": "boolean",
      "title": "emergency"
    },
    "reportOnly": {
      "type": "boolean",
      "title": "reportOnly"
    },
    "createdDate": {
      "type": "string",
      "title": "createdDate"
    },
    "modifiedDate": {
      "type": "string",
      "title": "modifiedDate"
    },
    "status": {
      "enum": [
        "INITIATED",
        "REJECTED",
        "SUBMITTED",
        "AUTHORIZED",
        "IN_APPROVAL",
        "APPROVED",
        "RELEASED",
        "SKIPPED"
      ],
      "title": "status"
    },
    "statusChanges": {
      "type": [
        "object",
        "null"
      ],
      "title": "statusChanges"
    },
    "processingPeriod?": {
      "$ref": "BasicProcessingPeriod.json"
    },
    "facility?": {
      "$ref": "BasicFacilityDto.json"
    },
    "program?": {
      "$ref": "BasicProgramDto.json"
    },
    "extraData": {
      "type": "object",
      "title": "extraData"
    }
  },
  "required": [
    "id",
    "emergency",
    "status"
  ]
