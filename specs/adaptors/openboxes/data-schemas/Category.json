{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openboxes/Category",
  "title": "Category",
  "x-openfn-adaptor": "openboxes",
  "x-source": {
    "openapi": "#/components/schemas/Category",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A product category. Categories form a tree via parentCategory. Responses always carry `id`; request bodies and embedded references carry a subset.",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "parentCategory": {
      "allOf": [
        {
          "$ref": "CategoryRef.json"
        }
      ]
    }
  },
  "example": {
    "id": "1",
    "name": "Medicines",
    "parentCategory": {
      "id": "ROOT",
      "name": "ROOT"
    }
  }
}
