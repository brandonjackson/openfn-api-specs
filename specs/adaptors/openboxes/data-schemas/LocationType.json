{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openboxes/LocationType",
  "title": "LocationType",
  "x-openfn-adaptor": "openboxes",
  "x-source": {
    "openapi": "#/components/schemas/LocationType",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A location's type, e.g. Depot, Ward, Bin Location or Supplier.",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Localisable name; may carry `|fr:` style translations."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "locationTypeCode": {
      "type": "string",
      "enum": [
        "DEPOT",
        "WARD",
        "PHARMACY",
        "SUPPLIER",
        "BIN_LOCATION",
        "VIRTUAL",
        "INTERNAL",
        "REGION",
        "ZONE",
        "CLINIC",
        "DISPENSARY",
        "PATIENT",
        "EXTERNAL",
        "STOCK_COUNT",
        "PRODUCTION",
        "STAGING_AREA",
        "RECEIVING",
        "OTHER"
      ]
    }
  },
  "example": {
    "id": "2",
    "name": "Depot",
    "description": "Depot",
    "locationTypeCode": "DEPOT"
  }
}
