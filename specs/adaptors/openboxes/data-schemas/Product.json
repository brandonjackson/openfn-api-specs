{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openboxes/Product",
  "title": "Product",
  "x-openfn-adaptor": "openboxes",
  "x-source": {
    "openapi": "#/components/schemas/Product",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A product (item) in the catalogue. Responses always carry `id`; request bodies and embedded product references carry a subset (often just name and productCode).",
  "properties": {
    "id": {
      "type": "string"
    },
    "productCode": {
      "type": [
        "string",
        "null"
      ],
      "description": "Auto-generated when not supplied on create."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "anyOf": [
        {
          "$ref": "CategoryRef.json"
        },
        {
          "type": "string"
        }
      ],
      "description": "Category reference; some endpoints render it as the category name only."
    },
    "unitOfMeasure": {
      "type": [
        "string",
        "null"
      ]
    },
    "pricePerUnit": {
      "type": [
        "number",
        "null"
      ]
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "handlingIcons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lotAndExpiryControl": {
      "type": "boolean"
    },
    "active": {
      "type": "boolean"
    },
    "displayNames": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "updatedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "dateCreated": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "lastUpdated": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "example": {
    "id": "ff80818155df9de40155df9e329b0009",
    "productCode": "00003",
    "name": "Aspirin 20mg",
    "category": {
      "id": "1",
      "name": "Medicines"
    },
    "description": null,
    "dateCreated": "2016-07-12T14:58:55Z",
    "lastUpdated": "2016-07-12T14:58:55Z"
  }
}
