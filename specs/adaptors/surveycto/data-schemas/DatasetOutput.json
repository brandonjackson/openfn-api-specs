{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "surveycto/DatasetOutput",
  "title": "DatasetOutput",
  "x-openfn-adaptor": "surveycto",
  "x-source": {
    "openapi": "#/components/schemas/DatasetOutput",
    "capturedAt": "2026-09-14"
  },
  "type": "object",
  "properties": {
    "idFormatOptions": {
      "$ref": "IdFormatOptions.json"
    },
    "totalRecords": {
      "type": "integer",
      "description": "Number of rows/records in the dataset"
    },
    "groupId": {
      "type": "integer",
      "description": "ID of the group that owns this dataset. Groups are used to organize and control access to datasets."
    },
    "fieldNames": {
      "type": "string",
      "description": "Comma-separated list of field names"
    },
    "title": {
      "type": "string",
      "description": "Dataset title"
    },
    "createdOn": {
      "type": "string",
      "description": "Dataset creation date"
    },
    "version": {
      "type": "integer",
      "description": "Dataset version number"
    },
    "discriminator": {
      "$ref": "DatasetDiscriminator.json"
    },
    "uniqueRecordField": {
      "type": "string",
      "description": "Field name used for unique record identification"
    },
    "modifiedOn": {
      "type": "string",
      "description": "Dataset last modification date"
    },
    "allowOfflineUpdates": {
      "type": "boolean",
      "description": "Whether offline updates are allowed"
    },
    "id": {
      "type": "string",
      "description": "Dataset identifier",
      "example": "cases"
    },
    "casesManagementOptions": {
      "$ref": "CasesManagementOptions.json"
    },
    "lastIncomingDataDate": {
      "type": "string",
      "description": "Timestamp of the last incoming data"
    },
    "status": {
      "$ref": "DatasetStatus.json"
    }
  }
}
