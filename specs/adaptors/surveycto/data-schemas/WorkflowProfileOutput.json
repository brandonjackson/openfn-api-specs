{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "surveycto/WorkflowProfileOutput",
  "title": "WorkflowProfileOutput",
  "x-openfn-adaptor": "surveycto",
  "x-source": {
    "openapi": "#/components/schemas/WorkflowProfileOutput",
    "capturedAt": "2026-09-14"
  },
  "type": "object",
  "properties": {
    "createdAt": {
      "type": "string",
      "description": "Creation time, ISO 8601, UTC.",
      "readOnly": true,
      "example": "2026-02-11T10:00:00Z"
    },
    "name": {
      "type": "string",
      "description": "Unique profile name.",
      "example": "Field Worker Profile"
    },
    "description": {
      "type": "string",
      "description": "Optional description.",
      "example": "Simplified interface for field data collectors"
    },
    "id": {
      "type": "integer",
      "description": "Server-assigned profile ID. Use it in /{id} URLs and when attaching the profile to roles.",
      "readOnly": true,
      "example": "1"
    },
    "config": {
      "$ref": "WorkflowProfileConfig.json"
    },
    "version": {
      "type": "integer",
      "description": "Starts at 1 and is incremented by the server on every successful update. Read-only.",
      "readOnly": true,
      "example": "2"
    },
    "updatedAt": {
      "type": "string",
      "description": "Last-update time, ISO 8601, UTC.",
      "readOnly": true,
      "example": "2026-02-11T10:05:00Z"
    }
  },
  "description": "A workflow profile as returned by the API."
}
