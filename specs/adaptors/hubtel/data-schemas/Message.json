{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hubtel/Message",
  "title": "Message",
  "x-openfn-adaptor": "hubtel",
  "x-source": {
    "openapi": "#/components/schemas/Message",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Status of a sent message.",
  "properties": {
    "rate": {
      "type": "number",
      "description": "Cost per SMS."
    },
    "units": {
      "type": "integer",
      "description": "Default value is 0 (personal-account API)."
    },
    "batchId": {
      "type": [
        "string",
        "null"
      ],
      "description": "Batch the message belongs to, or null."
    },
    "messageId": {
      "type": "string",
      "description": "Unique identifier of the message."
    },
    "content": {
      "type": "string",
      "description": "Content of the message."
    },
    "status": {
      "type": "string",
      "description": "Delivery status from the telco DLR.",
      "example": "Delivered",
      "x-documented-values": [
        "Delivered",
        "Sent",
        "Pending",
        "Blacklisted",
        "Undeliverable",
        "Failed",
        "Unrouteable",
        "Error",
        "Rejected",
        "NACK/0x0000000b",
        "NACK/0x0000000a"
      ]
    },
    "clientReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "networkId": {
      "type": [
        "string",
        "null"
      ]
    },
    "updateTime": {
      "type": "string",
      "description": "When the telco delivered the message."
    },
    "time": {
      "type": "string",
      "description": "When the message was sent."
    },
    "to": {
      "type": "string",
      "description": "Recipient MSISDN."
    },
    "from": {
      "type": "string",
      "description": "Sender ID."
    }
  },
  "example": {
    "rate": 0.0309,
    "batchId": null,
    "messageId": "eadbfcd0-94d1-438f-ad32-0013f34042c2",
    "content": "The Job is the JOB",
    "status": "Delivered",
    "updateTime": "2023-05-30T16:43:15",
    "time": "2023-05-30T16:43:13.7208383Z",
    "to": "233200000000",
    "from": "MySenderId"
  }
}
