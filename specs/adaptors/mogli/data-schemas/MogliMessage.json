{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mogli/MogliMessage",
  "title": "MogliMessage",
  "x-openfn-adaptor": "mogli",
  "x-source": {
    "openapi": "#/components/schemas/MogliMessage",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A Mogli_SMS__SMS__c record. Standard Salesforce system fields plus the Mogli fields whose API names Mogli documents; Mogli also documents, by label only, Direction (Incoming/Outgoing), Message, Scheduled Delivery, Gateway, Contact/Lead/Opportunity/Campaign lookups and Attachments, whose API names are org-visible via describeMogliMessage but not published, so they are left to additionalProperties.",
  "additionalProperties": true,
  "properties": {
    "attributes": {
      "type": "object",
      "readOnly": true,
      "properties": {
        "type": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "Id": {
      "type": "string",
      "readOnly": true
    },
    "Name": {
      "type": "string",
      "readOnly": true,
      "description": "Auto-number record name."
    },
    "OwnerId": {
      "type": "string"
    },
    "CreatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "CreatedById": {
      "type": "string"
    },
    "LastModifiedDate": {
      "type": "string",
      "format": "date-time"
    },
    "LastModifiedById": {
      "type": "string"
    },
    "SystemModstamp": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "IsDeleted": {
      "type": "boolean",
      "readOnly": true
    },
    "Mogli_SMS__Status__c": {
      "type": "string",
      "description": "Picklist; documented values include Queued, Scheduled, Sent Successfully, Received Successfully."
    },
    "Mogli_SMS__Phone_Number__c": {
      "type": "string",
      "description": "Recipient/sender number in E.164 (+<country><number>)."
    },
    "Mogli_SMS__Mogli_Template__c": {
      "type": "string",
      "description": "Name of the Mogli Template used (string, since Grays Peak v5.171)."
    }
  },
  "example": {
    "Id": "a0X000000000000AAA",
    "Mogli_SMS__Status__c": "Queued",
    "Mogli_SMS__Phone_Number__c": "+10000000000"
  }
}
