{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flutterwave/Customer",
  "title": "Customer",
  "x-openfn-adaptor": "flutterwave",
  "x-source": {
    "openapi": "#/components/schemas/Customer",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "ID of the customer"
    },
    "address": {
      "$ref": "Address.json"
    },
    "email": {
      "type": "string",
      "description": "The Customer's email address",
      "pattern": "^[a-zA-Z0-9_+&*-]+(?:\\.[a-zA-Z0-9_+&*-]+)*@(?:[a-zA-Z0-9-]+\\.)+[a-zA-Z]{2,}$"
    },
    "name": {
      "$ref": "PersonName.json"
    },
    "phone": {
      "$ref": "Phone.json"
    },
    "meta": {
      "type": "object"
    },
    "created_datetime": {
      "type": "string",
      "format": "date-time"
    }
  }
}
