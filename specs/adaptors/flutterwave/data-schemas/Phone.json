{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flutterwave/Phone",
  "title": "Phone",
  "x-openfn-adaptor": "flutterwave",
  "x-source": {
    "openapi": "#/components/schemas/Phone",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "country_code": {
      "type": "string",
      "description": "The dialling country code e.g. 234 for NG",
      "pattern": "^[0-9]{1,3}$"
    },
    "number": {
      "type": "string",
      "description": "Unformatted 7-10-digit phone number without the country code",
      "pattern": "^[0-9]{7,10}$"
    }
  },
  "required": [
    "country_code",
    "number"
  ],
  "description": "The customer's mobile number"
}
