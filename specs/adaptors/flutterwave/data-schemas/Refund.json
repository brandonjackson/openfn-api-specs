{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "flutterwave/Refund",
  "title": "Refund",
  "x-openfn-adaptor": "flutterwave",
  "x-source": {
    "openapi": "#/components/schemas/Refund",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "ID of the refund"
    },
    "amount_refunded": {
      "type": "number",
      "description": "The payment amount in decimals",
      "minimum": 0.01
    },
    "meta": {
      "type": "object"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the refund",
      "enum": [
        "duplicate",
        "fraudulent",
        "requested_by_customer",
        "expired_uncaptured_charge"
      ]
    },
    "status": {
      "type": "string",
      "description": "Status of the refund",
      "enum": [
        "pending",
        "requires_action",
        "succeeded",
        "failed",
        "cancelled",
        "completed",
        "new"
      ]
    },
    "charge_id": {
      "type": "string",
      "description": "ID of the charge tied to this refund"
    },
    "created_datetime": {
      "type": "string"
    }
  },
  "description": "A refund of a previously created charge"
}
