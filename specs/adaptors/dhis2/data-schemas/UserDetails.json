      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userGroupIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userOrgUnitIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userRoleIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "userRoleLongIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64"
      }
    },
    "userSearchOrgUnitIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "username": {
      "type": "string"
    }
  }
