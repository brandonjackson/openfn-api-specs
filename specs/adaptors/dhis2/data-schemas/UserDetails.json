{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dhis2/UserDetails",
  "title": "UserDetails",
  "x-openfn-adaptor": "dhis2",
  "x-source": {
    "openapi": "#/components/schemas/UserDetails",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "required": [
    "allAuthorities",
    "authorities",
    "managedGroupLongIds",
    "twoFactorType",
    "userDataOrgUnitIds",
    "userEffectiveSearchOrgUnitIds",
    "userGroupIds",
    "userOrgUnitIds",
    "userRoleIds",
    "userRoleLongIds",
    "userSearchOrgUnitIds"
