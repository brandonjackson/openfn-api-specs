      "items": {
        "type": "string"
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "$ref": "GrantedAuthority.json"
      }
    },
    "code": {
      "type": "string"
    },
    "credentialsNonExpired": {
      "type": "boolean"
    },
    "dataViewMaxOrganisationUnitLevel": {
      "type": "integer",
      "format": "int32"
    },
    "email": {
      "type": "string"
    },
    "emailVerified": {
      "type": "boolean"
    },
    "enabled": {
      "type": "boolean"
    },
    "externalAuth": {
      "type": "boolean"
    },
    "firstName": {
      "type": "string"
    },
    "id": {
      "type": "integer",
      "format": "int64"
    },
    "managedGroupLongIds": {
      "type": "array",
      "items": {
        "type": "integer",
        "format": "int64"
      }
    },
    "name": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "secret": {
      "type": "string"
    },
    "super": {
      "type": "boolean"
    },
    "surname": {
      "type": "string"
    },
    "twoFactorEnabled": {
      "type": "boolean"
    },
    "twoFactorType": {
      "$ref": "TwoFactorType.json"
    },
    "uID": {
      "type": "string",
      "format": "uid",
      "minLength": 11,
      "maxLength": 11,
      "pattern": "^[a-zA-Z][a-zA-Z0-9]{10}$"
    },
    "uid": {
      "type": "string"
    },
    "userDataOrgUnitIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
