{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/ChatSessionFileUpload",
  "title": "File upload settings",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/ChatSessionFileUpload",
    "capturedAt": "2026-09-03"
  },
  "properties": {
    "enabled": {
      "type": "boolean",
      "description": "Indicates if uploads are enabled for the session."
    },
    "max_file_size": {
      "anyOf": [
        {
          "type": "integer",
          "description": "Maximum upload size in megabytes."
        },
        {
          "type": "null"
        }
      ]
    },
    "max_files": {
      "anyOf": [
        {
          "type": "integer",
          "description": "Maximum number of uploads allowed during the session."
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "enabled",
    "max_file_size",
    "max_files"
  ],
  "description": "Upload permissions and limits applied to the session."
}
