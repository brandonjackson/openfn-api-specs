{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/ProvenanceResource",
  "title": "ProvenanceResource",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/ProvenanceResource",
    "capturedAt": "2026-09-03"
  },
  "properties": {
    "object": {
      "$ref": "ProvenanceCheckObject.json",
      "description": "The object type. Always `content_provenance_check` for this endpoint."
    },
    "created_at": {
      "type": "integer",
      "format": "unixtime",
      "description": "The Unix timestamp, in seconds, when the provenance check was created."
    },
    "results": {
      "items": {
        "oneOf": [
          {
            "$ref": "C2PAProvenanceResult.json"
          },
          {
            "$ref": "SynthIDProvenanceResult.json"
          }
        ],
        "discriminator": {
          "propertyName": "type"
        }
      },
      "type": "array",
      "description": "The provenance results that apply to the uploaded file. Image results include C2PA and SynthID; audio results include SynthID."
    }
  },
  "type": "object",
  "required": [
    "object",
    "created_at",
    "results"
  ]
}
