{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/ChatCompletionRequestMessageContentPartImage",
  "title": "Image content part",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/ChatCompletionRequestMessageContentPartImage",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "description": "Learn about [image inputs](/docs/guides/vision).\n",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "image_url"
      ],
      "description": "The type of the content part.",
      "x-stainless-const": true
    },
    "image_url": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Either a URL of the image or the base64 encoded image data.",
          "format": "uri"
        },
        "detail": {
          "type": "string",
          "description": "Specifies the detail level of the image. Learn more in the [Vision guide](/docs/guides/vision#low-or-high-fidelity-image-understanding).",
          "enum": [
            "auto",
            "low",
            "high"
          ],
          "default": "auto"
        }
      },
      "required": [
        "url"
      ]
    },
    "prompt_cache_breakpoint": {
      "$ref": "PromptCacheBreakpointParam.json"
    }
  },
  "required": [
    "type",
    "image_url"
  ]
}
