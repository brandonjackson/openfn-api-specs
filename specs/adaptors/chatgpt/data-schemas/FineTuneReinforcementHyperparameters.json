{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/FineTuneReinforcementHyperparameters",
  "title": "FineTuneReinforcementHyperparameters",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/FineTuneReinforcementHyperparameters",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "description": "The hyperparameters used for the reinforcement fine-tuning job.",
  "properties": {
    "batch_size": {
      "description": "Number of examples in each batch. A larger batch size means that model parameters are updated less frequently, but with lower variance.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      ],
      "default": "auto"
    },
    "learning_rate_multiplier": {
      "description": "Scaling factor for the learning rate. A smaller learning rate may be useful to avoid overfitting.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "default": "auto"
    },
    "n_epochs": {
      "description": "The number of epochs to train the model for. An epoch refers to one full cycle through the training dataset.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      ],
      "default": "auto"
    },
    "reasoning_effort": {
      "description": "Level of reasoning effort.\n",
      "type": "string",
      "enum": [
        "default",
        "low",
        "medium",
        "high"
      ],
      "default": "default"
    },
    "compute_multiplier": {
      "description": "Multiplier on amount of compute used for exploring search space during training.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "number",
          "maximum": 10,
          "exclusiveMinimum": 0.00001
        }
      ],
      "default": "auto"
    },
    "eval_interval": {
      "description": "The number of training steps between evaluation runs.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "default": "auto"
    },
    "eval_samples": {
      "description": "Number of evaluation samples to generate per training step.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1
        }
      ],
      "default": "auto"
    }
  }
}
