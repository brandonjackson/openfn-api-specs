{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/FineTuneSupervisedHyperparameters",
  "title": "FineTuneSupervisedHyperparameters",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/FineTuneSupervisedHyperparameters",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "description": "The hyperparameters used for the fine-tuning job.",
  "properties": {
    "batch_size": {
      "description": "Number of examples in each batch. A larger batch size means that model parameters are updated less frequently, but with lower variance.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      ],
      "default": "auto"
    },
    "learning_rate_multiplier": {
      "description": "Scaling factor for the learning rate. A smaller learning rate may be useful to avoid overfitting.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "default": "auto"
    },
    "n_epochs": {
      "description": "The number of epochs to train the model for. An epoch refers to one full cycle through the training dataset.\n",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ],
          "x-stainless-const": true
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      ],
      "default": "auto"
    }
  }
}
