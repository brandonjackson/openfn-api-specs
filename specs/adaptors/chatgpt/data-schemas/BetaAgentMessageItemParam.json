{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/BetaAgentMessageItemParam",
  "title": "Agent message",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/BetaAgentMessageItemParam",
    "capturedAt": "2026-09-03"
  },
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "Beta_AgentTagParam.json",
          "description": "The agent that produced this item."
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "anyOf": [
        {
          "type": "string",
          "description": "The unique ID of this agent message item.",
          "example": "amsg_123"
        },
        {
          "type": "null"
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "agent_message"
      ],
      "description": "The item type. Always `agent_message`.",
      "default": "agent_message",
      "x-stainless-const": true
    },
    "author": {
      "type": "string",
      "description": "The sending agent identity."
    },
    "recipient": {
      "type": "string",
      "description": "The destination agent identity."
    },
    "content": {
      "items": {
        "oneOf": [
          {
            "$ref": "BetaInputTextContentParam.json"
          },
          {
            "$ref": "BetaInputImageContentParamAutoParam.json"
          },
          {
            "$ref": "BetaEncryptedContentParam.json"
          }
        ],
        "description": "A plaintext, image, or encrypted agent message content part.",
        "discriminator": {
          "propertyName": "type"
        }
      },
      "type": "array",
      "description": "Plaintext, image, or encrypted content sent between agents."
    }
  },
  "type": "object",
  "required": [
    "type",
    "author",
    "recipient",
    "content"
  ],
  "description": "A message routed between agents.",
  "x-oai-beta": "responses_multi_agent=v1"
}
