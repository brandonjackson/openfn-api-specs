{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/BetaProgramOutputItemParam",
  "title": "BetaProgramOutputItemParam",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/BetaProgramOutputItemParam",
    "capturedAt": "2026-09-03"
  },
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "Beta_AgentTagParam.json",
