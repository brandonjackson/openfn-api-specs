{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/Eval",
  "title": "Eval",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/Eval",
    "capturedAt": "2026-11-16"
  },
  "type": "object",
  "description": "An Eval object with a data source config and testing criteria.\nAn Eval represents a task to be done for your LLM integration.\nLike:\n - Improve the quality of my chatbot\n - See how well my chatbot handles customer support\n - Check if o4-mini is better at my usecase than gpt-6-astra\n",
  "properties": {
    "object": {
      "type": "string",
      "enum": [
        "eval"
      ],
      "default": "eval",
      "description": "The object type.",
      "x-stainless-const": true
    },
    "id": {
      "type": "string",
      "description": "Unique identifier for the evaluation."
    },
    "name": {
      "type": "string",
      "description": "The name of the evaluation.",
      "example": "Chatbot effectiveness Evaluation"
    },
    "data_source_config": {
      "type": "object",
      "description": "Configuration of data sources used in runs of the evaluation.",
      "oneOf": [
        {
          "$ref": "EvalCustomDataSourceConfig.json"
        },
        {
          "$ref": "EvalLogsDataSourceConfig.json"
        },
        {
          "$ref": "EvalStoredCompletionsDataSourceConfig.json"
        }
      ]
    },
    "testing_criteria": {
      "description": "A list of testing criteria.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "EvalGraderLabelModel.json"
          },
          {
            "$ref": "EvalGraderStringCheck.json"
          },
          {
            "$ref": "EvalGraderTextSimilarity.json"
          },
          {
            "$ref": "EvalGraderPython.json"
          },
          {
            "$ref": "EvalGraderScoreModel.json"
          }
        ]
      }
    },
    "created_at": {
      "type": "integer",
      "format": "unixtime",
      "description": "The Unix timestamp (in seconds) for when the eval was created."
    },
    "metadata": {
      "$ref": "Metadata.json"
    }
  },
  "required": [
    "id",
    "data_source_config",
    "object",
    "testing_criteria",
    "name",
    "created_at",
    "metadata"
  ],
  "x-oaiMeta": {
    "name": "The eval object",
    "group": "evals",
    "example": "{\n  \"object\": \"eval\",\n  \"id\": \"eval_67abd54d9b0081909a86353f6fb9317a\",\n  \"data_source_config\": {\n    \"type\": \"custom\",\n    \"schema\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"item\": {\"type\": \"object\", \"properties\": {\"label\": {\"type\": \"string\"}}, \"required\": [\"label\"]},\n        \"sample\": {\n          \"type\": \"object\",\n          \"properties\": {\n            \"model\": {\"type\": \"string\"},\n            \"choices\": {\n              \"type\": \"array\",\n              \"items\": {\n                \"type\": \"object\",\n                \"properties\": {\n                  \"message\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                      \"role\": {\"type\": \"string\", \"enum\": [\"assistant\"]},\n                      \"content\": {\"type\": [\"string\", \"array\", \"null\"]},\n                      \"refusal\": {\"type\": [\"boolean\", \"null\"]},\n                      \"tool_calls\": {\n                        \"type\": [\"array\", \"null\"],\n                        \"items\": {\n                          \"type\": \"object\",\n                          \"properties\": {\n                            \"type\": {\"type\": \"string\", \"enum\": [\"function\"]},\n                            \"function\": {\n                              \"type\": \"object\",\n                              \"properties\": {\"name\": {\"type\": \"string\"}, \"arguments\": {\"type\": \"string\"}},\n                              \"required\": [\"name\", \"arguments\"]\n                            },\n                            \"id\": {\"type\": \"string\"}\n                          },\n                          \"required\": [\"type\", \"function\", \"id\"]\n                        }\n                      },\n                      \"function_call\": {\n                        \"type\": [\"object\", \"null\"],\n                        \"properties\": {\"name\": {\"type\": \"string\"}, \"arguments\": {\"type\": \"string\"}},\n                        \"required\": [\"name\", \"arguments\"]\n                      }\n                    },\n                    \"required\": [\"role\"]\n                  },\n                  \"finish_reason\": {\"type\": \"string\"}\n                },\n                \"required\": [\"index\", \"message\", \"finish_reason\"]\n              }\n            },\n            \"output_text\": {\"type\": \"string\"},\n            \"output_json\": {\"type\": \"object\"},\n            \"output_tools\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}},\n            \"output_reasoning_summary\": {\"type\": [\"string\", \"null\"]},\n            \"output_audio\": {\"type\": [\"object\", \"null\"]},\n            \"input_tools\": {\"type\": \"array\", \"items\": {\"type\": \"object\"}}\n          },\n          \"required\": [\"model\", \"choices\"]\n        }\n      },\n      \"required\": [\"item\", \"sample\"]\n    }\n  },\n  \"testing_criteria\": [\n    {\n      \"name\": \"My string check grader\",\n      \"type\": \"string_check\",\n      \"input\": \"{{sample.output_text}}\",\n      \"reference\": \"{{item.label}}\",\n      \"operation\": \"eq\"\n    }\n  ],\n  \"name\": \"External Data Eval\",\n  \"created_at\": 1739314509,\n  \"metadata\": {\n    \"test\": \"synthetics\"\n  }\n}\n"
  }
}
