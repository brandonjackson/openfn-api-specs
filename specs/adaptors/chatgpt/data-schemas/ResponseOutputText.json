{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/ResponseOutputText",
  "title": "Assistant message content",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/ResponseOutputText",
    "capturedAt": "2026-09-03"
  },
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "output_text"
      ],
      "description": "Type discriminator that is always `output_text`.",
      "default": "output_text",
      "x-stainless-const": true
    },
    "text": {
      "type": "string",
      "description": "Assistant generated text."
    },
    "annotations": {
      "items": {
        "oneOf": [
          {
            "$ref": "FileAnnotation.json"
          },
          {
            "$ref": "UrlAnnotation.json"
          }
        ],
        "description": "Annotation object describing a cited source.",
        "discriminator": {
          "propertyName": "type"
        }
      },
      "type": "array",
      "description": "Ordered list of annotations attached to the response text."
    }
  },
  "type": "object",
  "required": [
    "type",
    "text",
    "annotations"
  ],
  "description": "Assistant response text accompanied by optional annotations."
}
