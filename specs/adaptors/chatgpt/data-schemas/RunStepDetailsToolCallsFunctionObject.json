{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chatgpt/RunStepDetailsToolCallsFunctionObject",
  "title": "Function tool call",
  "x-openfn-adaptor": "chatgpt",
  "x-source": {
    "openapi": "#/components/schemas/RunStepDetailsToolCallsFunctionObject",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The ID of the tool call object."
    },
    "type": {
      "type": "string",
      "description": "The type of tool call. This is always going to be `function` for this type of tool call.",
      "enum": [
        "function"
      ],
      "x-stainless-const": true
    },
    "function": {
      "type": "object",
      "description": "The definition of the function that was called.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the function."
        },
        "arguments": {
          "type": "string",
          "description": "The arguments passed to the function."
        },
        "output": {
          "anyOf": [
            {
              "type": "string",
              "description": "The output of the function. This will be `null` if the outputs have not been [submitted](/docs/api-reference/runs/submitToolOutputs) yet."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "arguments",
        "output"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "function"
  ]
}
