{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenFn Lightning Collections API",
    "version": "2.20.1+main.71ce1f0",
    "description": "Key/value storage scoped to a Lightning project, served at /collections on an OpenFn Lightning instance. The collections adaptor (collections.get/set/remove/each) reaches it with undici against configuration.collections_endpoint and a Bearer collections_token (a run token inside a workflow, or a personal access token). Modelled from the Lightning router (scope \"/collections\") and LightningWeb.CollectionsController at main 71ce1f0. Collection creation/renaming lives in the REST API (/api/projects/{project_id}/collections/{id}, see the openfn adaptor spec).",
    "x-openfn-adaptor": "collections"
  },
  "servers": [
    {
      "url": "https://{host}/collections",
      "description": "Lightning collections endpoint (configuration.collections_endpoint / WORKER_COLLECTIONS_URL).",
      "variables": {
        "host": {
          "default": "app.openfn.org",
          "description": "Lightning host."
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Items",
      "description": "Items in a named collection."
    }
  ],
  "paths": {
    "/{name}": {
      "get": {
        "operationId": "listCollectionItems",
        "summary": "Stream items matching a key pattern and date filters",
        "tags": [
          "Items"
        ],
        "description": "Answers a chunked JSON body {\"items\": [...], \"cursor\": ...}. Unknown query parameters are refused (400 invalid_parameter). Used by collections.get() with a pattern or filters, and by collections.each().",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/project_id"
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Key or pattern; * is a wildcard (e.g. 2024-01*). Default all.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Items in this response (server default 1000). The adaptor sends its pageSize here.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 1000
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Cursor from the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "created_after",
            "in": "query",
            "required": false,
            "description": "Items created after (the adaptor maps createdAfter).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "created_before",
            "in": "query",
            "required": false,
            "description": "Items created before (the adaptor maps createdBefore).",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "required": false,
            "description": "Items updated after.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "updated_before",
            "in": "query",
            "required": false,
            "description": "Items updated before.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Items and cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionItemList"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "post": {
        "operationId": "upsertCollectionItems",
        "summary": "Upsert many items",
        "tags": [
          "Items"
        ],
        "description": "Used by collections.set(). Existing keys are replaced.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/project_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertItemsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Count written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpsertResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      },
      "delete": {
        "operationId": "deleteCollectionItems",
        "summary": "Delete items matching a key pattern (or all)",
        "tags": [
          "Items"
        ],
        "description": "Used by collections.remove() with a pattern or filters. Only key is read; the date filters the adaptor may also send are ignored by the server.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/project_id"
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Key or pattern with * wildcards; omitted deletes every item.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Count deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/{name}/{key}": {
      "get": {
        "operationId": "getCollectionItem",
        "summary": "Get one item by key",
        "tags": [
          "Items"
        ],
        "description": "Used by collections.get(name, key) without wildcards. 204 with an empty body when the key is missing.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/key"
          },
          {
            "$ref": "#/components/parameters/project_id"
          }
        ],
        "responses": {
          "200": {
            "description": "The item.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionItem"
                }
              }
            }
          },
          "204": {
            "description": "No item with that key."
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      },
      "put": {
        "operationId": "putCollectionItem",
        "summary": "Upsert one item",
        "tags": [
          "Items"
        ],
        "description": "Not called by the adaptor (set() always POSTs to /{name}), but served by Lightning.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/key"
          },
          {
            "$ref": "#/components/parameters/project_id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutItemRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpsertResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          }
        }
      },
      "delete": {
        "operationId": "deleteCollectionItem",
        "summary": "Delete one item by key",
        "tags": [
          "Items"
        ],
        "description": "Used by collections.remove(name, key). A missing key answers deleted: 0, never 404.",
        "parameters": [
          {
            "$ref": "#/components/parameters/name"
          },
          {
            "$ref": "#/components/parameters/key"
          },
          {
            "$ref": "#/components/parameters/project_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted count (0 or 1).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "collections_token: a run token, personal access token, or service-account token with collections:write."
      }
    },
    "parameters": {
      "name": {
        "name": "name",
        "in": "path",
        "required": true,
        "description": "Collection name (resolved within the caller's projects; add project_id when the name is ambiguous).",
        "schema": {
          "type": "string"
        }
      },
      "key": {
        "name": "key",
        "in": "path",
        "required": true,
        "description": "Item key (exact).",
        "schema": {
          "type": "string"
        }
      },
      "project_id": {
        "name": "project_id",
        "in": "query",
        "required": false,
        "description": "Disambiguates a collection name that exists in several projects (409 ambiguous_name otherwise). The adaptor sends configuration.project_id when set.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "400: invalid_request (unreadable Authorization header), invalid_parameter, malformed (body is not a JSON object).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "401: unauthenticated (no bearer token) or invalid_token (unknown, revoked or expired token).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "403: forbidden (no permission, or the record may not exist) or insufficient_scope (token lacks the grant).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "404: not_found (record or route does not exist), only to callers allowed to learn that.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "409: id_taken, scheduled_for_deletion, concurrent_edit, being_edited, in_use or ambiguous_name.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "422: invalid (see errors).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "ServiceUnavailable": {
        "description": "503: not_ready (adaptor catalogue still loading; retry-after 5) or service_unavailable.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          },
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "ProblemEntry": {
        "type": "object",
        "description": "One error entry in a problem document. Exactly one of pointer/parameter/header/path says where the problem is.",
        "required": [
          "code",
          "detail"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable entry code (an Ecto validation code or a Lightning entry code, e.g. unknown_key, taken, type, not_found)."
          },
          "detail": {
            "type": "string",
            "description": "Human-readable message; may change."
          },
          "pointer": {
            "type": "string",
            "description": "JSON Pointer into the request body, e.g. #/members/0/email."
          },
          "parameter": {
            "type": "string",
            "description": "Query parameter name."
          },
          "header": {
            "type": "string",
            "description": "Request header name, lower case."
          },
          "path": {
            "type": "string",
            "description": "Path segment name, e.g. id or project_id."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem document (LightningWeb.API.Problem). Sent as application/problem+json when Accept names it, application/json otherwise. Branch on `code`. Lightning releases up to v2.20.1 answered most API errors with ad-hoc JSON instead (the Unreleased changelog entry calls the switch breaking).",
        "required": [
          "type",
          "status",
          "title",
          "code",
          "detail"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "Always about:blank.",
            "example": "about:blank"
          },
          "status": {
            "type": "integer",
            "description": "HTTP status."
          },
          "title": {
            "type": "string",
            "description": "HTTP reason phrase."
          },
          "code": {
            "type": "string",
            "description": "Stable response code (LightningWeb.API.Codes).",
            "enum": [
              "bad_request",
              "invalid_request",
              "malformed",
              "invalid_parameter",
              "invalid_header",
              "unauthenticated",
              "invalid_token",
              "exceeds_limit",
              "forbidden",
              "insufficient_scope",
              "trigger_disabled",
              "not_found",
              "not_acceptable",
              "request_timeout",
              "scheduled_for_deletion",
              "id_taken",
              "being_edited",
              "concurrent_edit",
              "in_use",
              "ambiguous_name",
              "export_conflict",
              "content_too_large",
              "uri_too_long",
              "unsupported_media_type",
              "invalid",
              "too_many_runs",
              "too_many_requests",
              "internal",
              "not_implemented",
              "bad_gateway",
              "service_unavailable",
              "not_ready",
              "timeout"
            ]
          },
          "detail": {
            "type": "string",
            "description": "Fixed human-readable explanation of the code."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemEntry"
            }
          },
          "scope": {
            "type": "string",
            "description": "On insufficient_scope: the token grant the route needs."
          }
        },
        "additionalProperties": true,
        "example": {
          "type": "about:blank",
          "status": 400,
          "title": "Bad Request",
          "code": "invalid_parameter",
          "detail": "A path or query parameter is not valid. See errors.",
          "errors": [
            {
              "path": "id",
              "code": "type",
              "detail": "is not a UUID"
            }
          ]
        }
      },
      "CollectionItem": {
        "type": "object",
        "description": "A key/value entry of a collection (Lightning.Collections.Item Jason encoder). value is the stored string, usually JSON the adaptor serialised with JSON.stringify and parses back.",
        "required": [
          "key",
          "value"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "description": "Stored string, at most 1,000,000 bytes (typically JSON-encoded)."
          },
          "created": {
            "type": "string",
            "description": "inserted_at.",
            "format": "date-time"
          },
          "updated": {
            "type": "string",
            "description": "updated_at.",
            "format": "date-time"
          }
        },
        "example": {
          "key": "patient-001",
          "value": "{\"name\":\"Example Patient\",\"ward\":\"A\"}",
          "created": "2026-01-15T10:00:00.000000Z",
          "updated": "2026-01-15T10:00:00.000000Z"
        }
      },
      "CollectionItemList": {
        "type": "object",
        "description": "Streamed (chunked) page of items. cursor is null when nothing is left; otherwise pass it back as ?cursor=.",
        "required": [
          "items",
          "cursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollectionItem"
            }
          },
          "cursor": {
            "type": "string",
            "description": "Opaque (base64 item id).",
            "nullable": true
          }
        }
      },
      "UpsertResult": {
        "type": "object",
        "required": [
          "upserted"
        ],
        "properties": {
          "upserted": {
            "type": "integer",
            "description": "Number of items written."
          },
          "error": {
            "type": "string",
            "description": "Always null on success.",
            "nullable": true
          }
        }
      },
      "DeleteResult": {
        "type": "object",
        "required": [
          "deleted"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "The key or key pattern deleted (null when DELETE /{name} had no key).",
            "nullable": true
          },
          "deleted": {
            "type": "integer",
            "description": "Number of items deleted; 0 for a missing key (never 404)."
          }
        }
      },
      "UpsertItemsRequest": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "description": "The adaptor sends batches of at most 1000.",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string",
                  "description": "JSON-encoded value."
                }
              }
            }
          }
        }
      },
      "PutItemRequest": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "string",
            "description": "JSON-encoded value."
          }
        }
      }
    }
  }
}
