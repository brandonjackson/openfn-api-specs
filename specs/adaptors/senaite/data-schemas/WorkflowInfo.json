{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "senaite/WorkflowInfo",
  "title": "WorkflowInfo",
  "x-openfn-adaptor": "senaite",
  "x-source": {
    "openapi": "#/components/schemas/WorkflowInfo",
    "capturedAt": "2026-11-28"
  },
  "type": "object",
  "description": "Current workflow state of an object and the transitions the caller may run on it now.",
  "required": [
    "uid",
    "portal_type",
    "review_state",
    "transitions"
  ],
  "properties": {
    "uid": {
      "type": "string"
    },
    "portal_type": {
      "type": "string"
    },
    "review_state": {
      "type": "string",
      "description": "e.g. `active`, `sample_due`, `to_be_verified`."
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Pass as `transition` in an update body to run it."
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  }
}
