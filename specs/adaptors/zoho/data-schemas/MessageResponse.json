{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoho/MessageResponse",
  "title": "MessageResponse",
  "x-openfn-adaptor": "zoho",
  "x-source": {
    "openapi": "#/components/schemas/MessageResponse",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "response": {
      "type": "object",
      "properties": {
        "uri": {
          "type": "string",
          "description": "The resource URI the action ran against, e.g. /api/{ownerEmail}/{workspace}/{view}."
        },
        "action": {
          "type": "string",
          "description": "The ZOHO_ACTION that was executed."
        },
        "result": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "description": "Present on some actions, e.g. 'Success'."
            },
            "dbid": {
              "type": "string",
              "description": "Workspace ID, on CREATEBLANKDB and COPYDATABASE."
            },
            "groupId": {
              "type": "string",
              "description": "On CREATEGROUP."
            }
          },
          "description": "Confirmation message."
        }
      },
      "required": [
        "action",
        "result"
      ]
    }
  },
  "required": [
    "response"
  ],
  "description": "Envelope for actions that return only a confirmation message."
}
