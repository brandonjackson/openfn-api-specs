{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoho/ImportSummary",
  "title": "ImportSummary",
  "x-openfn-adaptor": "zoho",
  "x-source": {
    "openapi": "#/components/schemas/ImportSummary",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "totalColumnCount": {
      "type": "integer",
      "description": "Columns present in the imported data."
    },
    "selectedColumnCount": {
      "type": "integer",
      "description": "Columns imported (see ZOHO_SELECTED_COLUMNS)."
    },
    "totalRowCount": {
      "type": "integer",
      "description": "Rows present in the imported data."
    },
    "successRowCount": {
      "type": "integer",
      "description": "Rows imported without errors."
    },
    "warnings": {
      "type": "integer",
      "description": "Rows imported with warnings (ZOHO_ON_IMPORT_ERROR=SETCOLUMNEMPTY)."
    },
    "importOperation": {
      "type": "string",
      "description": "'created' when the table was created (ZOHO_CREATE_TABLE=true), else 'updated'."
    },
    "importType": {
      "type": "string",
      "description": "APPEND, TRUNCATEADD or UPDATEADD."
    }
  },
  "description": "Import counts. Field names from Zoho's v1 SDKs' ImportResult (the v1 Import Data page has no sample response)."
}
