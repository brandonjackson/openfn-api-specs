{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "zoho/OAuthToken",
  "title": "OAuthToken",
  "x-openfn-adaptor": "zoho",
  "x-source": {
    "openapi": "#/components/schemas/OAuthToken",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string",
      "description": "Only on the authorization_code grant."
    },
    "api_domain": {
      "type": "string",
      "format": "uri"
    },
    "token_type": {
      "type": "string"
    },
    "expires_in": {
      "type": "integer",
      "description": "Seconds; access tokens last one hour."
    }
  },
  "required": [
    "access_token"
  ],
  "description": "Zoho Accounts OAuth 2.0 token response."
}
