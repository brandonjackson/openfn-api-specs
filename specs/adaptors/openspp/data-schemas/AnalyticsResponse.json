{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/AnalyticsResponse",
  "title": "AnalyticsResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/AnalyticsResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Response from POST /aggregation/compute.",
  "properties": {
    "total_count": {
      "type": "integer",
      "description": "Total registrants matching the scope"
    },
    "statistics": {
      "type": "object",
      "description": "Computed statistics keyed by name"
    },
    "breakdown": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Breakdown by group_by dimensions (if requested)"
    },
    "from_cache": {
      "type": "boolean",
      "description": "Whether result was served from cache"
    },
    "computed_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of computation"
    },
    "access_level": {
      "type": "string",
      "description": "Access level: 'aggregate' or 'individual'"
    }
  },
  "required": [
    "total_count",
    "from_cache",
    "computed_at",
    "access_level"
  ]
