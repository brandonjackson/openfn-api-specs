{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Identifier",
  "title": "Identifier",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Identifier",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "External identifier for a resource",
  "properties": {
    "system": {
      "type": "string",
      "description": "Namespace URI for the identifier type",
      "example": "urn:gov:ph:psa:national-id"
    },
    "value": {
      "type": "string",
      "description": "The identifier value",
      "example": "PH-123456789"
    },
    "period": {
      "anyOf": [
        {
          "$ref": "Period.json"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Time period when identifier is/was valid"
    }
  },
  "required": [
    "system",
    "value"
  ]
}
