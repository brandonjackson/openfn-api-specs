{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ScenarioResponse",
  "title": "ScenarioResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ScenarioResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Simulation scenario details.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Scenario ID"
    },
    "name": {
      "type": "string",
      "description": "Scenario name"
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario description"
    },
    "category": {
      "type": [
        "string",
        "null"
      ],
      "description": "Scenario category"
    },
    "target_type": {
      "type": "string",
      "description": "Target type: 'group' or 'individual'"
    },
    "state": {
      "type": "string",
      "description": "Scenario state: 'draft', 'ready', 'archived'"
    },
    "targeting_expression": {
      "type": [
        "string",
        "null"
      ],
      "description": "CEL expression for targeting beneficiaries"
    },
    "targeting_expression_explanation": {
      "type": [
        "string",
        "null"
      ],
      "description": "Human-readable explanation of targeting expression"
    },
    "ideal_population_expression": {
      "type": [
        "string",
        "null"
      ],
      "description": "CEL expression for ideal population calculation"
    },
    "budget_amount": {
      "type": "number",
      "description": "Total budget amount"
    },
    "budget_strategy": {
      "type": "string",
      "description": "Budget strategy: 'none', 'cap_total', or 'proportional_reduction'"
    },
    "targeting_preview_count": {
      "type": "integer",
      "description": "Number of beneficiaries in targeting preview"
    },
    "targeting_preview_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Error message from targeting preview, if any"
    },
    "run_count": {
      "type": "integer",
      "description": "Total number of runs for this scenario"
    },
    "latest_beneficiary_count": {
      "type": "integer",
      "description": "Beneficiary count from latest run"
    },
    "latest_equity_score": {
      "type": "number",
      "description": "Equity score from latest run"
    },
    "entitlement_rules": {
      "type": "array",
      "items": {
        "$ref": "EntitlementRuleResponse.json"
      },
      "description": "List of entitlement rules"
    },
    "program_id": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Reference program ID"
    }
  },
  "required": [
    "id",
    "name",
    "target_type",
    "state",
    "budget_amount",
    "budget_strategy",
    "targeting_preview_count",
    "run_count",
    "latest_beneficiary_count",
    "latest_equity_score",
    "entitlement_rules"
  ]
}
