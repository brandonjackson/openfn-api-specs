{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/OdooArea",
  "title": "OdooArea",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/OdooArea",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "`spp.area` — a node of the administrative area hierarchy.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string",
      "example": "Central District"
    },
    "code": {
      "type": "string"
    },
    "altnames": {
      "type": "string"
    },
    "area_level": {
      "type": "integer"
    },
    "parent_id": {
      "description": "Parent area. Odoo many2one, serialised as [id, display_name].",
      "example": [
        1,
        "Country"
      ]
    },
    "kind": {
      "description": "Area kind (Region, District, ...). Odoo many2one, serialised as [id, display_name].",
      "example": [
        2,
        "District"
      ]
    }
  }
}
