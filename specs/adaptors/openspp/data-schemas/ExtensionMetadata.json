{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ExtensionMetadata",
  "title": "ExtensionMetadata",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ExtensionMetadata",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Metadata describing an API extension provided by an optional module.\n\nExtensions allow domain-specific modules to add fields and functionality\nto core resources. For example, the farmer registry module adds farm-related\nfields to Individual and Group resources.",
  "properties": {
    "url": {
      "type": "string",
      "description": "Unique URI identifying this extension",
      "example": "urn:openspp:extension:farmer"
    },
    "module": {
      "type": "string",
      "description": "Odoo module providing this extension",
      "example": "spp_farmer_registry"
    },
    "appliesTo": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Resource types this extension can be applied to",
      "example": [
        "Individual",
        "Group"
      ]
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional fields provided by this extension",
      "example": [
        "farm_size",
        "crops",
        "livestock_count"
      ]
    }
  },
  "required": [
    "url",
    "module",
    "appliesTo",
    "fields"
  ]
}
