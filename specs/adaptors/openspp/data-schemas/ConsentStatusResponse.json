{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ConsentStatusResponse",
  "title": "ConsentStatusResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ConsentStatusResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Schema for consent status check response.\n\nStatus values align with W3C Data Privacy Vocabulary (DPV) ConsentStatus.",
  "properties": {
    "consent_id": {
      "type": "string",
      "description": "External consent identifier"
    },
    "status": {
      "type": "string",
      "enum": [
        "requested",
        "given",
        "renewed",
        "refused",
        "withdrawn",
        "expired",
        "invalidated",
        "not_found"
      ]
    },
    "grantee": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Organization granted access"
    },
    "effective_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "expiry_date": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "scopes": {
      "type": "array",
      "items": {
        "$ref": "ConsentScopeSchema.json"
      }
    },
    "legal_basis": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    }
  },
  "required": [
    "consent_id",
    "status"
  ]
}
