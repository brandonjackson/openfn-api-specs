{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/RunSummary",
  "title": "RunSummary",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/RunSummary",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Summary data for a simulation run (list view).",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Run ID"
    },
    "scenario_id": {
      "type": "integer",
      "description": "Scenario ID"
    },
    "scenario_name": {
      "type": "string",
      "description": "Scenario name"
    },
    "state": {
      "type": "string",
      "description": "Run state"
    },
    "beneficiary_count": {
      "type": "integer",
      "description": "Number of beneficiaries"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost"
    },
    "coverage_rate": {
      "type": "number",
      "description": "Coverage rate"
    },
    "equity_score": {
      "type": "number",
      "description": "Equity score"
    },
    "gini_coefficient": {
      "type": "number",
      "description": "Gini coefficient"
    },
    "executed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Execution timestamp"
    },
    "execution_duration_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Execution duration in seconds"
    }
  },
  "required": [
    "id",
    "scenario_id",
    "scenario_name",
    "state",
    "beneficiary_count",
    "total_cost",
    "coverage_rate",
    "equity_score",
    "gini_coefficient"
  ]
