{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/BatchResultItem",
  "title": "BatchResultItem",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/BatchResultItem",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Result for a single geometry in a batch query.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Geometry identifier matching the request"
    },
    "total_count": {
      "type": "integer",
      "description": "Total number of registrants in this geometry"
    },
    "query_method": {
      "type": "string",
      "description": "Method used for query (coordinates, area_fallback)"
    },
    "areas_matched": {
      "type": "integer",
      "description": "Number of areas intersecting this geometry"
    },
    "statistics": {
      "type": "object",
      "description": "Statistics computed for this geometry"
    },
    "access_level": {
      "type": [
        "string",
        "null"
      ],
      "description": "Access level applied to statistics (aggregate or individual)"
    },
    "from_cache": {
      "type": "boolean",
      "description": "Whether statistics were served from cache",
      "default": false
    },
    "computed_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 timestamp when statistics were computed"
    }
  },
  "required": [
    "id",
    "total_count",
    "query_method",
    "areas_matched",
    "statistics"
  ]
}
