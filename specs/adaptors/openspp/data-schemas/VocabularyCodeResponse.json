{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/VocabularyCodeResponse",
  "title": "VocabularyCodeResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/VocabularyCodeResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Schema for a single vocabulary code.",
  "properties": {
    "code": {
      "type": "string",
      "description": "Machine-readable code",
      "example": "M"
    },
    "display": {
      "type": "string",
      "description": "Human-readable label",
      "example": "Male"
    },
    "definition": {
      "type": [
        "string",
        "null"
      ],
      "description": "Formal definition of what this code means"
    },
    "deprecated": {
      "type": "boolean",
      "description": "Whether this code is deprecated",
      "default": false
    },
    "parent_code": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent code for hierarchical vocabularies"
    },
    "level": {
      "type": "integer",
      "description": "Level in hierarchy (0 for root)",
      "default": 0
    }
  },
  "required": [
    "code",
    "display"
  ]
}
