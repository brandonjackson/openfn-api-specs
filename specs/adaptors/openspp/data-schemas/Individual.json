{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Individual",
  "title": "Individual",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Individual",
    "capturedAt": "2026-11-27"
  },
