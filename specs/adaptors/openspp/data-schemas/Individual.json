      "default": "Individual",
      "enum": [
        "Individual"
      ]
    },
    "identifier": {
      "type": "array",
      "items": {
        "$ref": "Identifier.json"
      },
      "description": "External identifiers for this individual",
      "minItems": 1
    },
    "active": {
      "type": "boolean",
      "description": "Whether record is active",
      "default": true
    },
    "name": {
      "anyOf": [
        {
          "$ref": "HumanName.json"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "birthDate": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "birthDateEstimated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "default": false
    },
    "gender": {
      "anyOf": [
        {
          "$ref": "CodeableConcept.json"
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "telecom": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "ContactPoint.json"
          }
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "address": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "Address.json"
          }
        },
        {
          "enum": [
            null
          ]
        }
      ]
    },
    "photo": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Base64-encoded photo"
