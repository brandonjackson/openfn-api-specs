{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Individual",
  "title": "Individual",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Individual",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "An individual registrant, addressed by external identifier (never a database id).",
  "properties": {
    "identifier": {
      "type": "string",
      "description": "External identifier, `<namespace-uri>|<value>`.",
      "example": "urn:openspp:id:spp-id|IND_Q4VGGZPF"
    },
    "name": {
      "type": "string",
      "example": "Jane Doe"
    },
    "given_name": {
      "type": "string"
    },
    "family_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "gender": {
      "type": "string",
      "description": "Vocabulary code (urn:openspp:vocabulary:gender)."
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "address": {
      "type": "string"
    },
    "area": {
      "type": "string",
      "description": "Administrative area identifier."
    },
    "active": {
      "type": "boolean"
    },
    "extension": {
      "$ref": "ApiExtension.json"
    }
  }
}
