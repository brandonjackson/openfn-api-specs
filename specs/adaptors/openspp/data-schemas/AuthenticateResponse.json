{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/AuthenticateResponse",
  "title": "AuthenticateResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/AuthenticateResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Session info returned by /web/session/authenticate.",
  "properties": {
    "jsonrpc": {
      "type": "string",
      "example": "2.0"
    },
    "id": {
      "type": "integer",
      "example": 1
    },
    "result": {
      "type": "object",
      "properties": {
        "uid": {
          "type": "integer",
          "description": "Authenticated user id — the `uid` passed to execute_kw.",
          "example": 2
        },
        "db": {
          "type": "string",
          "example": "openspp"
        },
        "username": {
          "type": "string",
          "example": "admin"
        },
        "name": {
          "type": "string",
          "example": "OpenSPP Administrator"
        },
        "server_version": {
          "type": "string",
          "example": "17.0"
        },
        "user_context": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "error": {
      "$ref": "JsonRpcError.json"
    }
  }
}
