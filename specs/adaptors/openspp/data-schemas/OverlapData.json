{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/OverlapData",
  "title": "OverlapData",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/OverlapData",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Overlap data between two runs.",
  "properties": {
    "run_a_id": {
      "type": "integer",
      "description": "First run ID"
    },
    "run_a_name": {
      "type": "string",
      "description": "First run scenario name"
    },
    "run_b_id": {
      "type": "integer",
      "description": "Second run ID"
    },
    "run_b_name": {
      "type": "string",
      "description": "Second run scenario name"
    },
    "overlap_count": {
      "type": "integer",
      "description": "Number of beneficiaries in both runs"
    },
    "union_count": {
      "type": "integer",
      "description": "Total unique beneficiaries across both runs"
    },
    "jaccard_index": {
      "type": "number",
      "description": "Jaccard similarity index (overlap / union)"
    }
  },
  "required": [
    "run_a_id",
    "run_a_name",
    "run_b_id",
    "run_b_name",
    "overlap_count",
    "union_count",
    "jaccard_index"
  ]
}
