{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ProximityQueryResponse",
  "title": "ProximityQueryResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ProximityQueryResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Response from proximity-based spatial query.",
  "properties": {
    "total_count": {
      "type": "integer",
      "description": "Number of registrants matching the proximity criteria"
    },
    "query_method": {
      "type": "string",
      "description": "Method used for query (coordinates, area_fallback)"
    },
    "areas_matched": {
      "type": "integer",
      "description": "Number of areas matched (0 for coordinate-based queries)"
    },
    "reference_points_count": {
      "type": "integer",
      "description": "Number of reference points used in the query"
    },
    "radius_km": {
      "type": "number",
      "description": "Radius used for the query (km)"
    },
    "relation": {
      "type": "string",
      "description": "Relation used: 'within' or 'beyond'"
    },
    "statistics": {
      "type": "object",
      "description": "Computed aggregate statistics"
    },
    "access_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Access level applied to statistics (aggregate or individual)"
    },
    "from_cache": {
      "type": "boolean",
      "description": "Whether statistics were served from cache",
      "default": false
    },
    "computed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "ISO 8601 timestamp when statistics were computed"
    }
  },
  "required": [
    "total_count",
    "query_method",
    "areas_matched",
    "reference_points_count",
    "radius_km",
    "relation",
    "statistics"
  ]
}
