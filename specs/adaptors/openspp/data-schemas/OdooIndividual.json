{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/OdooIndividual",
  "title": "OdooIndividual",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/OdooIndividual",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "`res.partner` with is_registrant=true and is_group=false — an individual registrant.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "spp_id": {
      "type": "string",
      "example": "IND_Q4VGGZPF"
    },
    "name": {
      "type": "string",
      "example": "Jane Doe"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "gender": {
      "type": "string",
      "example": "Female"
    },
    "birthdate": {
      "type": "string",
      "format": "date"
    },
    "is_registrant": {
      "type": "boolean"
    },
    "is_group": {
      "type": "boolean"
    },
    "category_id": {
      "type": "array",
      "description": "Registrant category tags (many2many ids).",
      "items": {
        "type": "integer"
      }
    },
    "area_id": {
      "description": "Administrative area. Odoo many2one, serialised as [id, display_name].",
      "example": [
        12,
        "Central District"
      ]
    }
  }
}
