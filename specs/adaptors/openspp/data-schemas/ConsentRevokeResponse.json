{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ConsentRevokeResponse",
  "title": "ConsentRevokeResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ConsentRevokeResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Schema for consent withdrawal response.\n\nUses DPV terminology: 'withdrawn' instead of 'revoked'.",
  "properties": {
    "consent_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "default": "withdrawn",
      "enum": [
        "withdrawn"
      ]
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When consent was withdrawn"
    },
    "message": {
      "type": "string",
      "default": "Consent has been successfully withdrawn"
    }
  },
  "required": [
    "consent_id",
    "revoked_at"
  ]
}
