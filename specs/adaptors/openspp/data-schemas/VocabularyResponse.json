{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/VocabularyResponse",
  "title": "VocabularyResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/VocabularyResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Schema for a single vocabulary.",
  "properties": {
    "namespace_uri": {
      "type": "string",
      "description": "Globally unique namespace URI",
      "example": "urn:iso:std:iso:5218"
    },
    "name": {
      "type": "string",
      "description": "Human-readable name",
      "example": "Gender"
    },
    "version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Version of the vocabulary",
      "example": "2024"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Detailed description"
    },
    "reference_url": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Link to official documentation"
    },
    "domain": {
      "type": "string",
      "description": "Domain area (core, social_assistance, health, etc.)",
      "example": "core"
    },
    "is_hierarchical": {
      "type": "boolean",
      "description": "Whether codes have parent/child relationships",
      "default": false
    },
    "code_count": {
      "type": "integer",
      "description": "Number of codes in this vocabulary",
      "default": 0
    }
  },
  "required": [
    "namespace_uri",
    "name",
    "domain"
  ]
}
