      "type": "integer"
    },
    "partner_id": {
      "description": "The enrolled registrant. Odoo many2one, serialised as [id, display_name].",
      "example": [
        42,
        "Jane Doe"
      ]
    },
    "program_id": {
      "description": "The programme. Odoo many2one, serialised as [id, display_name].",
