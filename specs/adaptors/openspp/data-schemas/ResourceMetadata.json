{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ResourceMetadata",
  "title": "ResourceMetadata",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ResourceMetadata",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Metadata describing supported operations and search parameters for a resource.\n\nThis provides information about what operations can be performed on a resource\n(read, search, create, update, delete) and what search parameters are available.",
  "properties": {
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supported operations on this resource",
      "example": [
        "read",
        "search",
        "create",
        "update"
      ]
    },
    "searchParams": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Available search parameters for this resource",
      "example": [
        "identifier",
        "name",
        "birthdate",
        "gender",
        "address"
      ]
    }
  },
  "required": [
    "operations"
  ]
}
