      "default": 10
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "FilterMetadata.json"
      },
      "description": "Available filters"
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "PresetMetadata.json"
      },
      "description": "Available presets"
    }
  },
  "required": [
    "resource"
  ]
