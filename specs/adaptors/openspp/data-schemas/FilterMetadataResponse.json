{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/FilterMetadataResponse",
  "title": "FilterMetadataResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/FilterMetadataResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Response for filter metadata endpoint.",
  "properties": {
