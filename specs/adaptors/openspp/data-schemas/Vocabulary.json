{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Vocabulary",
  "title": "Vocabulary",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Vocabulary",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A controlled vocabulary.",
  "properties": {
    "namespace_uri": {
      "type": "string",
      "description": "Globally unique vocabulary identifier.",
      "example": "urn:openspp:vocabulary:gender"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "code_count": {
      "type": "integer",
      "description": "Number of codes in the vocabulary."
    }
  }
}
