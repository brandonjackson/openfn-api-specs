{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/DistributionData",
  "title": "DistributionData",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/DistributionData",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Distribution analysis data for entitlements.",
  "properties": {
    "count": {
      "type": "integer",
      "description": "Number of beneficiaries"
    },
    "total": {
      "type": "number",
      "description": "Total amount distributed"
    },
    "minimum": {
      "type": "number",
      "description": "Minimum entitlement amount"
    },
    "maximum": {
      "type": "number",
      "description": "Maximum entitlement amount"
    },
    "mean": {
      "type": "number",
      "description": "Mean entitlement amount"
    },
    "median": {
      "type": "number",
      "description": "Median entitlement amount"
    },
    "standard_deviation": {
      "type": "number",
      "description": "Standard deviation"
    },
    "gini_coefficient": {
      "type": "number",
      "description": "Gini coefficient"
    },
    "percentiles": {
      "type": "object",
      "description": "Percentile values (p25, p50, p75, etc.)"
    }
  },
  "required": [
    "count",
    "total",
    "minimum",
    "maximum",
    "mean",
    "median",
    "standard_deviation",
    "gini_coefficient",
    "percentiles"
  ]
}
