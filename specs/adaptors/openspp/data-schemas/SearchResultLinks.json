{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/SearchResultLinks",
  "title": "SearchResultLinks",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/SearchResultLinks",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Pagination links for search results",
  "properties": {
    "self": {
      "type": "string",
      "description": "URL for the current page of results"
    },
    "next": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "URL for the next page of results, null if on last page"
    },
    "prev": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "URL for the previous page of results, null if on first page"
    }
  },
  "required": [
    "self"
  ]
}
