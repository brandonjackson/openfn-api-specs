{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/TokenResponse",
  "title": "TokenResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/TokenResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "OAuth 2.0 client-credentials token response from POST /api/v2/spp/token.",
  "properties": {
    "access_token": {
      "type": "string",
      "description": "JWT bearer token."
    },
    "token_type": {
      "type": "string",
      "example": "Bearer"
    },
    "expires_in": {
      "type": "integer",
      "description": "Token lifetime in seconds.",
      "example": 3600
    },
    "scope": {
      "type": "string"
    }
  }
}
