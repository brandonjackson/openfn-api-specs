{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/DataPushResponse",
  "title": "DataPushResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/DataPushResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Response from push endpoint.",
  "properties": {
    "success": {
      "type": "boolean",
      "description": "Whether the operation was successful"
    },
    "processed": {
      "type": "integer",
      "description": "Number of values processed"
    },
    "inserted": {
      "type": "integer",
      "description": "Number of new values inserted",
      "default": 0
    },
    "updated": {
      "type": "integer",
      "description": "Number of existing values updated",
      "default": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "DataPushError.json"
      },
      "description": "List of errors if any"
    }
  },
  "required": [
    "success",
    "processed"
  ]
}
