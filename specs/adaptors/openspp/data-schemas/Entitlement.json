{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Entitlement",
  "title": "Entitlement",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Entitlement",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A cash or in-kind entitlement. Cash entitlements carry `amount`/`currency`; in-kind entitlements carry `product`/`qty`/`unit`.",
  "properties": {
    "code": {
      "type": "string",
      "description": "Entitlement identifier (UUID)."
    },
    "program": {
      "type": "string"
    },
    "cycle": {
      "type": "string"
    },
    "beneficiary": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Transfer amount (cash entitlements)."
    },
    "currency": {
      "type": "string",
      "description": "Currency code (cash entitlements)."
    },
    "product": {
      "type": "string",
      "description": "Product identifier (in-kind entitlements)."
    },
    "qty": {
      "type": "number",
      "description": "Quantity (in-kind entitlements)."
    },
    "unit": {
      "type": "string",
      "description": "Unit of measure (in-kind entitlements)."
    },
    "valid_from": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    }
  }
}
