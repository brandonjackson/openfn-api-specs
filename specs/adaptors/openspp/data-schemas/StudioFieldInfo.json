{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/StudioFieldInfo",
  "title": "StudioFieldInfo",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/StudioFieldInfo",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Information about a Studio custom field.",
  "properties": {
    "technicalName": {
      "type": "string",
      "description": "Odoo field name (x_*)"
    },
    "label": {
      "type": "string",
      "description": "Display label"
    },
    "fieldType": {
      "type": "string",
      "description": "Field type (text, integer, etc.)"
    },
    "targetType": {
      "type": "string",
      "description": "Target registry (individual/group)"
    },
    "helpText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Help text"
    },
    "isRequired": {
      "type": "boolean",
      "description": "Whether field is required",
      "default": false
    },
    "placementZone": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Form placement zone"
    },
    "apiExposed": {
      "type": "boolean",
      "description": "Whether exposed via API",
      "default": true
    },
    "selectionOptions": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "For selection/multi_select: [{'value': 'x', 'label': 'X'}]"
    },
    "isReadonly": {
      "type": "boolean",
      "description": "Whether field is read-only",
      "default": false
    },
    "isSearchable": {
      "type": "boolean",
      "description": "Whether field is searchable",
      "default": false
    },
    "sequence": {
      "type": "integer",
      "description": "Order within placement zone",
      "default": 10
    },
    "visibilityField": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Field that controls visibility"
    },
    "visibilityOperator": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Comparison operator"
    },
    "visibilityValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Value to compare"
    },
    "linkModel": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "For link fields: target model"
    },
    "linkDomain": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "For link fields: domain filter"
    }
  },
  "required": [
    "technicalName",
    "label",
    "fieldType",
    "targetType"
  ]
}
