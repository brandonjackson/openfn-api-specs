{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/AuthenticationMetadata",
  "title": "AuthenticationMetadata",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/AuthenticationMetadata",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Metadata describing authentication configuration for the API.\n\nCurrently supports OAuth2 client credentials flow for API authentication.",
  "properties": {
    "type": {
      "type": "string",
      "description": "Authentication type",
      "example": "oauth2"
    },
    "tokenEndpoint": {
      "type": "string",
      "description": "URL endpoint for obtaining access tokens",
      "example": "/api/v2/spp/oauth/token"
    },
    "grantTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Supported OAuth2 grant types",
      "example": [
        "client_credentials"
      ]
    }
  },
  "required": [
    "type",
    "tokenEndpoint",
    "grantTypes"
  ]
}
