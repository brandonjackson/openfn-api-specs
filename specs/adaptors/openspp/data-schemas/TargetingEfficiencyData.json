{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/TargetingEfficiencyData",
  "title": "TargetingEfficiencyData",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/TargetingEfficiencyData",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Targeting efficiency metrics (requires ideal population).",
  "properties": {
    "true_positives": {
      "type": "integer",
      "description": "Beneficiaries in ideal population"
    },
    "false_positives": {
      "type": "integer",
      "description": "Beneficiaries outside ideal population"
    },
    "false_negatives": {
      "type": "integer",
      "description": "Ideal population not covered"
    },
    "total_simulated": {
      "type": "integer",
      "description": "Total simulated beneficiaries"
    },
    "total_ideal": {
      "type": "integer",
      "description": "Total ideal population"
    },
    "leakage_rate": {
      "type": "number",
      "description": "Leakage rate (false positives / total simulated)"
    },
    "undercoverage_rate": {
      "type": "number",
      "description": "Undercoverage rate (false negatives / total ideal)"
    }
  },
  "required": [
    "true_positives",
    "false_positives",
    "false_negatives",
    "total_simulated",
    "total_ideal",
    "leakage_rate",
    "undercoverage_rate"
  ]
}
