{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/OdooGroup",
  "title": "OdooGroup",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/OdooGroup",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "`res.partner` with is_registrant=true and is_group=true — a group/household registrant.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Odoo database id"
    },
    "spp_id": {
      "type": "string",
      "description": "OpenSPP external registrant id",
      "example": "GRP_Q4VGGZPF"
    },
    "name": {
      "type": "string",
      "example": "Doe Household"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "is_registrant": {
      "type": "boolean"
    },
    "is_group": {
      "type": "boolean"
    },
    "kind": {
      "description": "Group kind (Household, Family, ...). Odoo many2one, serialised as [id, display_name].",
      "example": [
        1,
        "Household"
      ]
    },
    "area_id": {
      "description": "Administrative area the group lives in. Odoo many2one, serialised as [id, display_name].",
      "example": [
        12,
        "Central District"
      ]
    },
    "registration_date": {
      "type": "string",
      "format": "date"
    }
  }
}
