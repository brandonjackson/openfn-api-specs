{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/Group",
  "title": "Group",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/Group",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A group/household registrant, addressed by external identifier.",
  "properties": {
    "identifier": {
      "type": "string",
      "example": "urn:openspp:id:spp-id|GRP_Q4VGGZPF"
    },
    "name": {
      "type": "string",
      "example": "Doe Household"
    },
    "kind": {
      "type": "string",
      "description": "Group kind vocabulary code."
    },
    "members": {
      "type": "array",
      "description": "Member individual identifiers.",
      "items": {
        "type": "string"
      }
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "area": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "extension": {
      "$ref": "ApiExtension.json"
    }
  }
}
