{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ContactPoint",
  "title": "ContactPoint",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ContactPoint",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Contact information (phone, email, etc.)",
  "properties": {
    "system": {
      "type": "string",
      "pattern": "^(phone|email|fax|url|sms)$"
    },
    "value": {
      "type": "string"
    },
    "use": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(home|work|mobile)$"
    },
    "rank": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Preferred order"
    }
  },
  "required": [
    "system",
    "value"
  ]
}
