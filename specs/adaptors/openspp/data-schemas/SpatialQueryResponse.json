{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/SpatialQueryResponse",
  "title": "SpatialQueryResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/SpatialQueryResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Response from spatial query.",
  "properties": {
    "total_count": {
      "type": "integer",
      "description": "Total number of registrants in query area"
    },
    "query_method": {
      "type": "string",
      "description": "Method used for query (coordinates, area_fallback)"
    },
    "areas_matched": {
      "type": "integer",
      "description": "Number of areas intersecting query polygon"
    },
    "statistics": {
      "type": "object",
      "description": "Computed aggregate statistics"
    },
    "access_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "Access level applied to statistics (aggregate or individual)"
    },
    "from_cache": {
      "type": "boolean",
      "description": "Whether statistics were served from cache",
      "default": false
    },
    "computed_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "enum": [
            null
          ]
        }
      ],
      "description": "ISO 8601 timestamp when statistics were computed"
    }
  },
  "required": [
    "total_count",
    "query_method",
    "areas_matched",
    "statistics"
  ]
}
