{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ComparisonResponse",
  "title": "ComparisonResponse",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ComparisonResponse",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Comparison between simulation runs.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Comparison ID"
    },
    "name": {
      "type": "string",
      "description": "Comparison name"
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "ComparisonRunData.json"
      },
      "description": "Run data being compared"
    },
    "overlap_data": {
      "type": "array",
      "items": {
        "$ref": "OverlapData.json"
      },
      "description": "Overlap analysis between runs"
    },
    "staleness_warning": {
      "type": [
        "string",
        "null"
      ],
      "description": "Warning if scenarios were modified after runs"
    }
  },
  "required": [
    "id",
    "name",
    "runs"
  ]
}
