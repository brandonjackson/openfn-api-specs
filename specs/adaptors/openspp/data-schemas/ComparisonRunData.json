{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openspp/ComparisonRunData",
  "title": "ComparisonRunData",
  "x-openfn-adaptor": "openspp",
  "x-source": {
    "openapi": "#/components/schemas/ComparisonRunData",
    "capturedAt": "2026-11-27"
  },
  "type": "object",
  "description": "Data for a single run in a comparison.",
  "properties": {
    "run_id": {
      "type": "integer",
      "description": "Run ID"
    },
    "scenario_name": {
      "type": "string",
      "description": "Scenario name"
    },
    "beneficiary_count": {
      "type": "integer",
      "description": "Number of beneficiaries selected"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost of entitlements"
    },
    "coverage_rate": {
      "type": "number",
      "description": "Coverage rate (beneficiaries / total registry)"
    },
    "equity_score": {
      "type": "number",
      "description": "Equity score (1 - Gini coefficient)"
    },
    "gini_coefficient": {
      "type": "number",
      "description": "Gini coefficient measuring inequality"
    },
    "has_disparity": {
      "type": "boolean",
      "description": "Whether significant disparity was detected"
    },
    "leakage_rate": {
      "type": "number",
      "description": "Leakage rate (beneficiaries outside ideal population)"
    },
    "undercoverage_rate": {
      "type": "number",
      "description": "Undercoverage rate (ideal population not covered)"
    },
    "budget_utilization": {
      "type": "number",
      "description": "Budget utilization rate"
    },
    "executed_at": {
      "type": [
        "string",
        "null"
      ],
      "description": "Execution timestamp (ISO 8601)"
    }
  },
  "required": [
    "run_id",
    "scenario_name",
    "beneficiary_count",
    "total_cost",
    "coverage_rate",
    "equity_score",
    "gini_coefficient",
    "has_disparity",
    "leakage_rate",
    "undercoverage_rate",
    "budget_utilization"
  ]
}
