{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicmobile/SchedulerDoc",
  "title": "SchedulerDoc",
  "x-openfn-adaptor": "medicmobile",
  "x-source": {
    "openapi": "#/components/schemas/SchedulerDoc",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Replication ID, or null if state is completed or failed."
    },
    "state": {
      "type": "string",
      "description": "initializing, running, completed, pending, crashing, error, failed"
    },
    "database": {
      "type": "string",
      "description": "Database where the replication document came from."
    },
    "doc_id": {
      "type": "string",
      "description": "Replication document ID."
    },
    "node": {
      "type": "string",
      "description": "Cluster node where the job is running."
    },
    "source": {
      "type": "string",
      "description": "Replication source."
    },
    "target": {
      "type": "string",
      "description": "Replication target."
    },
    "start_time": {
      "type": "string",
      "description": "Timestamp of when the replication was started."
    },
    "last_updated": {
      "type": "string",
      "description": "Timestamp of last state update."
    },
    "info": {
      "$ref": "ReplicationStats.json"
    },
    "error_count": {
      "type": "integer",
      "description": "Consecutive errors since the replication was last updated."
    }
  }
}
