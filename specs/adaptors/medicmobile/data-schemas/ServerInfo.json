{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicmobile/ServerInfo",
  "title": "ServerInfo",
  "x-openfn-adaptor": "medicmobile",
  "x-source": {
    "openapi": "#/components/schemas/ServerInfo",
    "capturedAt": "2026-11-13"
