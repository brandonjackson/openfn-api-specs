        "version": {
          "type": "string"
        }
      }
    },
    "version": {
      "type": "string",
      "description": "CouchDB version."
    }
  },
  "example": {
    "couchdb": "Welcome",
    "features": [
      "access-ready",
      "partitioned",
      "pluggable-storage-engines",
      "reshard",
      "scheduler"
    ],
