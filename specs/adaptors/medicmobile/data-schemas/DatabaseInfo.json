{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medicmobile/DatabaseInfo",
  "title": "DatabaseInfo",
  "x-openfn-adaptor": "medicmobile",
  "x-source": {
    "openapi": "#/components/schemas/DatabaseInfo",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Information about a database.",
  "properties": {
    "cluster": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "description": "Replicas."
        },
        "q": {
          "type": "integer",
          "description": "Shards."
        },
        "r": {
          "type": "integer",
          "description": "Read quorum."
        },
        "w": {
          "type": "integer",
          "description": "Write quorum."
        }
      }
    },
    "compact_running": {
      "type": "boolean",
      "description": "Set to true if the database compaction routine is operating on this database."
    },
    "db_name": {
      "type": "string",
      "description": "The name of the database."
    },
    "disk_format_version": {
      "type": "integer",
      "description": "The version of the physical format used for the data when it is stored on disk."
    },
    "doc_count": {
      "type": "integer",
      "description": "A count of the documents in the specified database."
    },
    "doc_del_count": {
      "type": "integer",
      "description": "Number of deleted documents."
    },
    "instance_start_time": {
      "type": "string",
      "description": "Always \"0\". (Returned for legacy reasons.)"
    },
    "props": {
      "type": "object",
      "description": "Database properties.",
      "properties": {
        "partitioned": {
          "type": "boolean",
          "description": "Whether the database is partitioned."
        }
      }
    },
    "purge_seq": {
      "description": "Update sequence (an opaque string in CouchDB 2.x+ clusters; a number on single-node 1.x databases)."
    },
    "sizes": {
      "type": "object",
      "properties": {
        "active": {
          "type": "integer",
          "description": "Size of live data inside the database, in bytes."
        },
        "external": {
          "type": "integer",
          "description": "Uncompressed size of database contents in bytes."
        },
        "file": {
          "type": "integer",
          "description": "Size of the database file on disk in bytes."
        }
      }
    },
    "update_seq": {
      "description": "Update sequence (an opaque string in CouchDB 2.x+ clusters; a number on single-node 1.x databases)."
    }
  },
  "example": {
    "cluster": {
      "n": 3,
      "q": 8,
      "r": 2,
      "w": 2
    },
    "compact_running": false,
    "db_name": "receipts",
    "disk_format_version": 6,
    "doc_count": 6146,
    "doc_del_count": 64637,
    "instance_start_time": "0",
    "props": {},
    "purge_seq": 0,
    "sizes": {
      "active": 65031503,
      "external": 66982448,
      "file": 137433211
    },
    "update_seq": "292786-g1AAAAF..."
  }
}
