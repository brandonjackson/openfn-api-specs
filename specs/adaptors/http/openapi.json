  "servers": [
    {
      "url": "{baseUrl}",
      "description": "configuration.baseUrl of whatever API the job targets.",
      "variables": {
        "baseUrl": {
          "default": "https://api.example.org",
          "description": "Placeholder; set per credential."
        }
      }
    }
  ],
