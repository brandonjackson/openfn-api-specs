  "paths": {
    "/{resource}": {
      "get": {
        "operationId": "getCollection",
        "summary": "GET a collection path of the target API",
        "tags": [
          "Resources"
        ],
        "description": "GET {baseUrl}/{resource} - made by get(path) or request(\"GET\", path). The path is any path the job passes; {resource}/{id} stand for its segments (OpenAPI cannot express a multi-segment wildcard). Response bodies are parsed as JSON when the server says so (parseAs), otherwise text or a stream.",
        "parameters": [
          {
            "$ref": "#/components/parameters/resource"
          }
        ],
        "responses": {
          "200": {
            "description": "Whatever the target API returns.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Resource"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/Resource"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "Error from the target API; the adaptor throws on 4xx/5xx unless options.errors suppresses it."
          }
        }
      },
      "post": {
        "operationId": "postCollection",
