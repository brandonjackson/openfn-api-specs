{
  "openapi": "3.0.3",
  "info": {
    "title": "Generic HTTP target (OpenFn http adaptor)",
    "version": "7.3.3",
    "description": "The http adaptor is a generic HTTP client: request/get/post/put/patch/del send any method to any path under configuration.baseUrl (or an absolute URL when baseUrl is unset), with optional Basic (username/password) or Bearer (access_token) auth, TLS options, query, headers and JSON/form/XML/text bodies. There is no vendor API, so this document models the operation surface itself: every HTTP method the adaptor can emit, at collection-level and item-level path templates, carrying arbitrary JSON. info.x-openfn-local-operations lists the exports that make no request.",
    "x-openfn-adaptor": "http",
    "x-openfn-local-operations": [
      {
        "name": "parseXML",
        "kind": "adaptor",
        "description": "Parses an XML string with cheerio and runs a callback; no request."
