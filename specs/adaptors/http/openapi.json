  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Sent when configuration.username and password are set (and no access_token)."
      },
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Sent when configuration.access_token is set."
      }
    },
    "parameters": {
      "resource": {
        "name": "resource",
        "in": "path",
        "required": true,
        "description": "First segment(s) of the job-supplied path.",
        "schema": {
          "type": "string"
        }
      },
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "Last segment of the job-supplied path.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Resource": {
        "type": "object",
        "additionalProperties": true,
        "description": "Any JSON object returned by, or sent to, the target API. The adaptor imposes no shape."
      }
    }
