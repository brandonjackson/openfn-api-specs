{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsWorkflowRunErrorEvent",
  "title": "BetaManagedAgentsWorkflowRunErrorEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsWorkflowRunErrorEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A workflow run met an error, or an error kept a run from being created. A run that ends with a `result.type` of `error` emits this event before its `workflow_run.status_ended`, with the same `error`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "workflow_run_id",
    "error"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "workflow_run.error",
      "examples": [
        "workflow_run.error"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_01JQ8ZB7T3X5Z7C9E1G3J5L7"
      ]
    },
    "processed_at": {
      "description": "Timestamp when this event was processed.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-10-01T18:05:02.301Z"
      ]
    },
    "workflow_run_id": {
      "description": "Identifier of the run that met the error, or `null` when the error kept a run from being created.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "examples": [
        "wrun_011CZm5tR2nHw6Jc9Ys4PdKf"
      ]
    },
    "error": {
      "description": "Why the run did not finish, or was not created.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsWorkflowRunError.json"
        }
      ],
      "examples": [
        {
          "type": "program_error",
          "message": "The workflow run's plan failed."
        }
      ]
    }
  },
  "example": {
    "type": "workflow_run.error",
    "id": "sevt_01JQ8ZB7T3X5Z7C9E1G3J5L7",
    "processed_at": "2026-10-01T18:05:02.301Z",
    "workflow_run_id": "wrun_011CZm5tR2nHw6Jc9Ys4PdKf",
    "error": {
      "type": "program_error",
      "message": "The workflow run's plan failed."
    }
  }
}
