{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaEnrollmentUrl",
  "title": "BetaEnrollmentUrl",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaEnrollmentUrl",
    "capturedAt": "2026-11-13"
  },
  "description": "A URL to give to the entity that a user profile represents, so that the entity can enroll in a program.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "url",
    "expires_at",
    "type"
  ],
  "properties": {
    "url": {
      "description": "Enrollment URL to send to the end user. Valid until `expires_at`.",
      "type": "string",
      "examples": [
        "https://platform.claude.com/user-profiles/enrollment/M3J0bGJxZ2ppMnptbnB1"
      ]
    },
    "expires_at": {
      "description": "When this enrollment URL expires, in RFC 3339 format.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-03-15T10:15:00Z"
      ]
    },
    "type": {
      "description": "Object type. Always `enrollment_url`.",
      "type": "string",
      "const": "enrollment_url",
      "examples": [
        "enrollment_url"
      ]
    }
  },
  "example": {
    "type": "enrollment_url",
    "url": "https://platform.claude.com/user-profiles/enrollment/M3J0bGJxZ2ppMnptbnB1",
    "expires_at": "2026-03-15T10:15:00Z"
  }
}
