{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaPluginInstallationSetting",
  "title": "PluginInstallationSetting",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaPluginInstallationSetting",
    "capturedAt": "2026-11-13"
  },
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time",
      "title": "Created At",
      "description": "When the target was first given a setting for this Plugin.",
      "examples": [
        "2026-03-14T09:26:53.589793Z"
      ]
    },
    "installation_preference": {
      "type": "string",
      "enum": [
        "auto_install",
        "available",
        "not_available",
        "required"
      ],
      "title": "Installation Preference",
      "description": "The setting the target holds for this Plugin. One of `required`, `auto_install`, `available`, `not_available`; a value this API does not yet name is returned as stored.",
      "examples": [
        "required"
      ]
    },
    "plugin_id": {
      "type": "string",
      "title": "Plugin Id",
      "description": "The Plugin's ID.",
      "examples": [
        "plugin_01JyHfbRkZvD1gW7oTqXc3Ne"
      ]
    },
    "target": {
      "oneOf": [
        {
          "$ref": "BetaPluginTargetOrganization.json"
        },
        {
          "$ref": "BetaPluginTargetRbacGroup.json"
        },
        {
          "$ref": "BetaPluginTargetOrganizationMember.json"
        }
      ],
      "title": "Target",
      "description": "Whose setting this is: `organization` (the Plugin's own organization-wide setting) or `rbac_group` (one RBAC Group's own setting); `organization_member` does not occur here.",
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "organization": "#/components/schemas/BetaPluginTargetOrganization",
          "organization_member": "#/components/schemas/BetaPluginTargetOrganizationMember",
          "rbac_group": "#/components/schemas/BetaPluginTargetRbacGroup"
        }
      }
    },
    "type": {
      "type": "string",
      "const": "plugin_installation_setting",
      "title": "Type",
      "description": "Always `plugin_installation_setting`.",
      "default": "plugin_installation_setting"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "title": "Updated At",
      "description": "When its setting last changed.",
      "examples": [
        "2026-03-14T09:26:53.589793Z"
      ]
    }
  },
  "type": "object",
  "required": [
    "created_at",
    "installation_preference",
    "plugin_id",
    "target",
    "type",
    "updated_at"
  ],
  "description": "The installation setting an organization-owned Plugin holds for one\ntarget. It has no ID of its own: it is addressed by the Plugin's ID and the\ntarget."
}
