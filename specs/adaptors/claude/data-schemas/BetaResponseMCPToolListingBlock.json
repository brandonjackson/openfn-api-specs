      "type": "string"
    },
    "tools": {
      "items": {
        "$ref": "BetaResponseMCPTool.json"
      },
      "title": "Tools",
      "type": "array"
    },
    "type": {
      "const": "mcp_tool_listing",
      "default": "mcp_tool_listing",
      "title": "Type",
      "type": "string"
    }
  },
  "required": [
