{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsWorkflowRunStatusIdleEvent",
  "title": "BetaManagedAgentsWorkflowRunStatusIdleEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsWorkflowRunStatusIdleEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A workflow run is idle. Emitted each time the run goes idle, whatever the cause. If the run ends while idle, no `workflow_run.status_running` comes between this event and its `workflow_run.status_ended`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "workflow_run_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "workflow_run.status_idle",
      "examples": [
        "workflow_run.status_idle"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_01JQ8Z9A4C6E8G1J2L4N6Q8S"
      ]
    },
    "processed_at": {
      "description": "Timestamp when this event was processed.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-10-01T18:03:20.118Z"
      ]
    },
    "workflow_run_id": {
      "description": "Identifier of the run. The same value is on all of the run's `workflow_run.*` events.",
      "type": "string",
      "examples": [
        "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
      ]
    }
  },
  "example": {
    "type": "workflow_run.status_idle",
    "id": "sevt_01JQ8Z9A4C6E8G1J2L4N6Q8S",
    "processed_at": "2026-10-01T18:03:20.118Z",
    "workflow_run_id": "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
  }
}
