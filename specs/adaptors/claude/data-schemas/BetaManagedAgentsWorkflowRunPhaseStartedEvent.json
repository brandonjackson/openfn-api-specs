{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsWorkflowRunPhaseStartedEvent",
  "title": "BetaManagedAgentsWorkflowRunPhaseStartedEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsWorkflowRunPhaseStartedEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A workflow run's plan entered a phase.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "workflow_run_id",
    "workflow_run_phase_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "workflow_run.phase_started",
      "examples": [
        "workflow_run.phase_started"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_01JQ8Z7M3P5R7T9V1X3Z5B7D"
      ]
    },
    "processed_at": {
      "description": "Timestamp when this event was processed.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-10-01T18:02:14.020Z"
      ]
    },
    "workflow_run_id": {
      "description": "Identifier of the run. The same value is on all of the run's `workflow_run.*` events.",
      "type": "string",
      "examples": [
        "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
      ]
    },
    "workflow_run_phase_id": {
      "description": "Identifier of the phase, as in `phases` on the run's `workflow_run.created` event.",
      "type": "string",
      "examples": [
        "wrph_011CZm4Kq7RtY2Wn8Vx3LbHd"
      ]
    }
  },
  "example": {
    "type": "workflow_run.phase_started",
    "id": "sevt_01JQ8Z7M3P5R7T9V1X3Z5B7D",
    "processed_at": "2026-10-01T18:02:14.020Z",
    "workflow_run_id": "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd",
    "workflow_run_phase_id": "wrph_011CZm4Kq7RtY2Wn8Vx3LbHd"
  }
