{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsVault",
  "title": "BetaManagedAgentsVault",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsVault",
    "capturedAt": "2026-11-13"
  },
  "description": "A vault that stores credentials for use by agents during sessions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "display_name",
    "metadata",
    "created_at",
    "updated_at",
    "archived_at"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "vault",
      "examples": [
        "vault"
      ]
    },
    "id": {
      "description": "The unique ID of the vault (`vlt_...`).",
      "type": "string",
      "examples": [
        "vlt_011CZkZDLs7fYzm1hXNPeRjv"
      ]
    },
    "display_name": {
      "description": "Human-readable name for the vault.",
      "type": "string",
      "examples": [
        "Example vault"
      ]
    },
    "metadata": {
      "description": "Arbitrary key-value metadata attached to the vault.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "examples": [
        {
          "environment": "production"
        }
      ]
    },
    "created_at": {
      "$ref": "BetaTimestamp.json",
      "examples": [
        "2026-03-15T10:00:00Z"
      ]
    },
    "updated_at": {
      "$ref": "BetaTimestamp.json",
      "examples": [
        "2026-03-15T10:00:00Z"
      ]
    },
    "archived_at": {
      "description": "When the vault was archived. Null if not archived.",
      "anyOf": [
        {
          "$ref": "BetaTimestamp.json"
        },
        {
          "type": "null"
        }
      ],
      "examples": [
        null
      ]
    }
  },
  "example": {
    "type": "vault",
    "id": "vlt_011CZkZDLs7fYzm1hXNPeRjv",
    "display_name": "Example vault",
    "metadata": {
      "environment": "production"
    },
    "created_at": "2026-03-15T10:00:00Z",
    "updated_at": "2026-03-15T10:00:00Z",
    "archived_at": null
  }
}
