{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsSpanOutcomeEvaluationStartEvent",
  "title": "BetaManagedAgentsSpanOutcomeEvaluationStartEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsSpanOutcomeEvaluationStartEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "Emitted when an outcome evaluation cycle begins.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "iteration",
    "outcome_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "span.outcome_evaluation_start",
      "examples": [
        "span.outcome_evaluation_start"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_011CZkZTUy4mGhu8peVXnmzr"
      ]
    },
    "processed_at": {
      "description": "Timestamp when outcome evaluation started.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-03-15T10:02:14Z"
      ]
    },
    "iteration": {
      "description": "0-indexed revision cycle. 0 is the first evaluation; 1 is the re-evaluation after the first revision; etc.",
      "type": "integer",
      "format": "int32",
      "examples": [
        0
      ]
    },
    "outcome_id": {
      "description": "The `outc_` ID of the outcome being evaluated.",
      "type": "string",
      "examples": [
        "outc_011CZkZRSw2kEfs6ncTVmjxP"
      ]
    }
  },
  "example": {
    "type": "span.outcome_evaluation_start",
    "id": "sevt_011CZkZTUy4mGhu8peVXnmzr",
    "processed_at": "2026-03-15T10:02:14Z",
    "iteration": 0,
    "outcome_id": "outc_011CZkZRSw2kEfs6ncTVmjxP"
  }
}
