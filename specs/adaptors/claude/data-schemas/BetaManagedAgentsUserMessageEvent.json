{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsUserMessageEvent",
  "title": "BetaManagedAgentsUserMessageEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsUserMessageEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A user message event in the session conversation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "content"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "user.message",
      "examples": [
        "user.message"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_011CZkZGPp1iBcp4kaQSihUm"
      ]
    },
    "content": {
      "description": "Array of content blocks comprising the user message.",
      "type": "array",
      "items": {
        "$ref": "BetaManagedAgentsUserContentBlock.json"
      },
      "examples": [
        [
          {
            "type": "text",
            "text": "Where is my order #1234?"
          }
        ]
      ]
    },
    "processed_at": {
      "description": "Timestamp when the agent finished processing this message.",
      "anyOf": [
        {
          "$ref": "BetaTimestamp.json"
        },
        {
          "type": "null"
        }
      ],
      "examples": [
        "2026-03-15T10:00:00Z"
      ]
    }
  },
  "example": {
    "type": "user.message",
    "id": "sevt_011CZkZGPp1iBcp4kaQSihUm",
    "content": [
      {
        "type": "text",
        "text": "Where is my order #1234?"
      }
    ],
    "processed_at": "2026-03-15T10:00:00Z"
  }
}
