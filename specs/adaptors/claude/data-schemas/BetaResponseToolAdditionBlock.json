        {
          "$ref": "BetaResponseToolChangeMCPToolReference.json"
        },
        {
          "$ref": "BetaResponseToolChangeMCPToolsetReference.json"
        },
        {
          "$ref": "BetaResponseToolChangeToolDefinition.json"
        }
      ],
      "title": "Tool"
    },
    "type": {
