{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsUserLocation",
  "title": "BetaManagedAgentsUserLocation",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsUserLocation",
    "capturedAt": "2026-11-13"
  },
  "description": "Approximate user location for search result localization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "description": "Location precision. Only \"approximate\" is supported.",
      "type": "string",
      "const": "approximate"
    },
    "city": {
      "description": "City name.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "region": {
      "description": "Region or state name.",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "country": {
      "description": "Two-letter ISO 3166-1 country code, uppercase.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "timezone": {
      "description": "IANA timezone identifier, e.g. \"America/Los_Angeles\".",
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
