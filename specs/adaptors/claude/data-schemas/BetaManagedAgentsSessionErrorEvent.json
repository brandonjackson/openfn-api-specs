{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsSessionErrorEvent",
  "title": "BetaManagedAgentsSessionErrorEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsSessionErrorEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "An error event indicating a problem occurred during session execution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "error"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "session.error"
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string"
    },
    "processed_at": {
      "description": "Timestamp when the error occurred.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ]
    },
    "error": {
      "type": "object",
      "discriminator": {
        "propertyName": "type",
        "mapping": {
          "unknown_error": "#/components/schemas/BetaManagedAgentsUnknownError",
          "model_overloaded_error": "#/components/schemas/BetaManagedAgentsModelOverloadedError",
          "model_rate_limited_error": "#/components/schemas/BetaManagedAgentsModelRateLimitedError",
          "model_request_failed_error": "#/components/schemas/BetaManagedAgentsModelRequestFailedError",
          "mcp_connection_failed_error": "#/components/schemas/BetaManagedAgentsMcpConnectionFailedError",
          "mcp_authentication_failed_error": "#/components/schemas/BetaManagedAgentsMcpAuthenticationFailedError",
          "billing_error": "#/components/schemas/BetaManagedAgentsBillingError",
          "credential_host_unreachable_error": "#/components/schemas/BetaManagedAgentsCredentialHostUnreachableError",
          "tool_use_limit_reached_error": "#/components/schemas/BetaManagedAgentsToolUseLimitReachedError",
          "compaction_limit_reached_error": "#/components/schemas/BetaManagedAgentsCompactionLimitReachedError",
          "repository_authentication_error": "#/components/schemas/BetaManagedAgentsRepositoryAuthenticationError",
          "repository_forbidden_error": "#/components/schemas/BetaManagedAgentsRepositoryForbiddenError",
          "repository_not_found_error": "#/components/schemas/BetaManagedAgentsRepositoryNotFoundError",
          "repository_checkout_error": "#/components/schemas/BetaManagedAgentsRepositoryCheckoutError",
          "repository_clone_error": "#/components/schemas/BetaManagedAgentsRepositoryCloneError"
        }
      },
      "oneOf": [
        {
          "$ref": "BetaManagedAgentsUnknownError.json"
        },
        {
          "$ref": "BetaManagedAgentsModelOverloadedError.json"
        },
        {
          "$ref": "BetaManagedAgentsModelRateLimitedError.json"
        },
        {
          "$ref": "BetaManagedAgentsModelRequestFailedError.json"
        },
        {
          "$ref": "BetaManagedAgentsMcpConnectionFailedError.json"
        },
        {
          "$ref": "BetaManagedAgentsMcpAuthenticationFailedError.json"
        },
        {
          "$ref": "BetaManagedAgentsBillingError.json"
        },
        {
          "$ref": "BetaManagedAgentsCredentialHostUnreachableError.json"
        },
        {
          "$ref": "BetaManagedAgentsToolUseLimitReachedError.json"
        },
        {
          "$ref": "BetaManagedAgentsCompactionLimitReachedError.json"
        },
        {
          "$ref": "BetaManagedAgentsRepositoryAuthenticationError.json"
        },
        {
          "$ref": "BetaManagedAgentsRepositoryForbiddenError.json"
        },
        {
          "$ref": "BetaManagedAgentsRepositoryNotFoundError.json"
        },
        {
          "$ref": "BetaManagedAgentsRepositoryCheckoutError.json"
        },
        {
          "$ref": "BetaManagedAgentsRepositoryCloneError.json"
        }
      ]
    }
  }
}
