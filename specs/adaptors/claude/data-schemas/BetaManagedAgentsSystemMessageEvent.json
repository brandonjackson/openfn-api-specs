{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsSystemMessageEvent",
  "title": "BetaManagedAgentsSystemMessageEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsSystemMessageEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A mid-conversation system message event. Carries system-role content that is appended to the session as a `role: \"system\"` turn.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "content"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "system.message"
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string"
    },
    "content": {
      "description": "System content blocks. Text-only.",
      "type": "array",
      "items": {
        "$ref": "BetaManagedAgentsSystemContentBlock.json"
      }
    },
    "processed_at": {
      "description": "Timestamp when this system message was processed.",
      "anyOf": [
        {
          "$ref": "BetaTimestamp.json"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
