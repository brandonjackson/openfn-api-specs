{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsWorkflowRunStatusRunningEvent",
  "title": "BetaManagedAgentsWorkflowRunStatusRunningEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsWorkflowRunStatusRunningEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A workflow run is running. Emitted when the run starts to execute, and each time it resumes after being idle. A run that starts idle emits `workflow_run.status_idle` first.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "workflow_run_id"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "workflow_run.status_running",
      "examples": [
        "workflow_run.status_running"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_01JQ8Z6Y1M3P5R7T9V1X3Z5B"
      ]
    },
    "processed_at": {
      "description": "Timestamp when this event was processed.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-10-01T18:02:11.430Z"
      ]
    },
    "workflow_run_id": {
      "description": "Identifier of the run. The same value is on all of the run's `workflow_run.*` events.",
      "type": "string",
      "examples": [
        "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
      ]
    }
  },
  "example": {
    "type": "workflow_run.status_running",
    "id": "sevt_01JQ8Z6Y1M3P5R7T9V1X3Z5B",
    "processed_at": "2026-10-01T18:02:11.430Z",
    "workflow_run_id": "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
  }
}
