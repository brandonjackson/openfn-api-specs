{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsMultiagentWorkflowsEnabled",
  "title": "BetaManagedAgentsMultiagentWorkflowsEnabled",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsMultiagentWorkflowsEnabled",
    "capturedAt": "2026-11-13"
  },
  "description": "The agent can start workflow runs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "inline_agents",
    "predefined_agents"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "enabled",
      "examples": [
        "enabled"
      ]
    },
    "inline_agents": {
      "description": "Whether a run's plan can define inline agents, which are not saved.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsMultiagentInlineAgents.json"
        }
      ],
      "examples": [
        {
          "type": "disabled"
        }
      ]
    },
    "predefined_agents": {
      "description": "Predefined agents, which are saved agents that a run's plan can use, each resolved to a specific version.",
      "type": "array",
      "items": {
        "$ref": "BetaManagedAgentsAgentReference.json"
      },
      "examples": [
        [
          {
            "type": "agent",
            "id": "agent_011CZkYqphY8vELVzwCUpqiQ",
            "version": 1
          }
        ]
      ]
    }
  },
  "example": {
    "type": "enabled",
    "inline_agents": {
      "type": "disabled"
    },
    "predefined_agents": [
      {
        "type": "agent",
        "id": "agent_011CZkYqphY8vELVzwCUpqiQ",
        "version": 1
      }
    ]
  }
}
