{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaUserProfileActionUrl",
  "title": "BetaUserProfileActionUrl",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaUserProfileActionUrl",
    "capturedAt": "2026-11-13"
  },
  "description": "A URL to give to the person who takes the requested action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "url",
    "expires_at"
  ],
  "properties": {
    "type": {
      "description": "Object type. Always `user_profile_action_url`.",
      "type": "string",
      "const": "user_profile_action_url",
      "examples": [
        "user_profile_action_url"
      ]
    },
    "url": {
      "description": "The URL to give to the person who takes the action. Anyone who holds it can open it until `expires_at`.",
      "type": "string",
      "examples": [
        "https://platform.claude.com/user-profiles/enrollment/M3J0bGJxZ2ppMnptbnB1"
      ]
    },
    "expires_at": {
      "description": "When the URL stops working, in RFC 3339 format.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-03-15T10:15:00Z"
      ]
    }
  },
  "example": {
    "type": "user_profile_action_url",
    "url": "https://platform.claude.com/user-profiles/enrollment/M3J0bGJxZ2ppMnptbnB1",
    "expires_at": "2026-03-15T10:15:00Z"
  }
}
