{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsWorkflowRunStatusEndedEvent",
  "title": "BetaManagedAgentsWorkflowRunStatusEndedEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsWorkflowRunStatusEndedEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A workflow run ended. Emitted once per run, as the last of the run's `workflow_run.*` events.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "processed_at",
    "workflow_run_id",
    "result"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "workflow_run.status_ended",
      "examples": [
        "workflow_run.status_ended"
      ]
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string",
      "examples": [
        "sevt_01JQ8ZC1V5B7N9M1K3J5H7GA"
      ]
    },
    "processed_at": {
      "description": "Timestamp when this event was processed.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ],
      "examples": [
        "2026-10-01T18:05:02.337Z"
      ]
    },
    "workflow_run_id": {
      "description": "Identifier of the run. The same value is on all of the run's `workflow_run.*` events.",
      "type": "string",
      "examples": [
        "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd"
      ]
    },
    "result": {
      "description": "How the run ended.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsWorkflowRunResult.json"
        }
      ],
      "examples": [
        {
          "type": "completed"
        }
      ]
    }
  },
  "example": {
    "type": "workflow_run.status_ended",
    "id": "sevt_01JQ8ZC1V5B7N9M1K3J5H7GA",
    "processed_at": "2026-10-01T18:05:02.337Z",
    "workflow_run_id": "wrun_011CZm3vQ8pKx2Lr7Nq9TbYd",
    "result": {
      "type": "completed"
    }
  }
}
