{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsSessionThreadStatusTerminatedEvent",
  "title": "BetaManagedAgentsSessionThreadStatusTerminatedEvent",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsSessionThreadStatusTerminatedEvent",
    "capturedAt": "2026-11-13"
  },
  "description": "A session thread has terminated and will accept no further input. Emitted on the thread's own stream and cross-posted to the primary stream for child threads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "id",
    "session_thread_id",
    "processed_at",
    "agent_name"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "session.thread_status_terminated"
    },
    "id": {
      "description": "Unique identifier for this event.",
      "type": "string"
    },
    "session_thread_id": {
      "description": "Public sthr_ ID of the thread that terminated.",
      "type": "string"
    },
    "processed_at": {
      "description": "Timestamp of the status transition.",
      "allOf": [
        {
          "$ref": "BetaTimestamp.json"
        }
      ]
    },
    "agent_name": {
      "description": "Name of the agent the thread runs.",
      "type": "string"
    }
  }
}
