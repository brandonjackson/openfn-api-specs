{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claude/BetaManagedAgentsMultiagent20261001",
  "title": "BetaManagedAgentsMultiagent20261001",
  "x-openfn-adaptor": "claude",
  "x-source": {
    "openapi": "#/components/schemas/BetaManagedAgentsMultiagent20261001",
    "capturedAt": "2026-11-13"
  },
  "description": "Resolved multiagent configuration with three members, each enabled or disabled on its own.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "workflows",
    "subagents",
    "advisor"
  ],
  "properties": {
    "type": {
      "type": "string",
      "const": "multiagent_20261001",
      "examples": [
        "multiagent_20261001"
      ]
    },
    "workflows": {
      "description": "Whether the agent can start workflow runs.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsMultiagentWorkflows.json"
        }
      ],
      "examples": [
        {
          "type": "enabled",
          "inline_agents": {
            "type": "enabled"
          },
          "predefined_agents": []
        }
      ]
    },
    "subagents": {
      "description": "Whether the agent can spawn session threads.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsMultiagentSubagents.json"
        }
      ],
      "examples": [
        {
          "type": "enabled",
          "inline_agents": {
            "type": "enabled"
          },
          "predefined_agents": [
            {
              "type": "agent",
              "id": "agent_011CZkYqphY8vELVzwCUpqiQ",
              "version": 1
            }
          ]
        }
      ]
    },
    "advisor": {
      "description": "Whether the session's primary thread can consult an advisor model.",
      "allOf": [
        {
          "$ref": "BetaManagedAgentsMultiagentAdvisor.json"
        }
      ],
      "examples": [
        {
          "type": "disabled"
        }
      ]
    }
  },
  "example": {
    "type": "multiagent_20261001",
    "workflows": {
      "type": "enabled",
      "inline_agents": {
        "type": "enabled"
      },
      "predefined_agents": []
    },
    "subagents": {
      "type": "enabled",
      "inline_agents": {
        "type": "enabled"
      },
      "predefined_agents": [
        {
          "type": "agent",
          "id": "agent_011CZkYqphY8vELVzwCUpqiQ",
          "version": 1
        }
      ]
    },
    "advisor": {
      "type": "disabled"
    }
  }
}
