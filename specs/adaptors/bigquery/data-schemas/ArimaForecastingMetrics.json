{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigquery/ArimaForecastingMetrics",
  "title": "ArimaForecastingMetrics",
  "x-openfn-adaptor": "bigquery",
  "x-source": {
    "openapi": "#/components/schemas/ArimaForecastingMetrics",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "Model evaluation metrics for ARIMA forecasting models.",
  "properties": {
    "arimaFittingMetrics": {
      "type": "array",
      "description": "Arima model fitting metrics.",
      "deprecated": true,
      "items": {
        "$ref": "ArimaFittingMetrics.json"
      }
    },
    "arimaSingleModelForecastingMetrics": {
      "type": "array",
      "description": "Repeated as there can be many metric sets (one for each model) in auto-arima and the large-scale case.",
      "items": {
        "$ref": "ArimaSingleModelForecastingMetrics.json"
      }
    },
    "seasonalPeriods": {
      "type": "array",
      "description": "Seasonal periods. Repeated because multiple periods are supported for one time series.",
      "deprecated": true,
      "items": {
        "type": "string",
        "enum": [
          "SEASONAL_PERIOD_TYPE_UNSPECIFIED",
          "NO_SEASONALITY",
          "DAILY",
          "WEEKLY",
          "MONTHLY",
          "QUARTERLY",
          "YEARLY",
          "HOURLY"
        ]
      }
    },
    "hasDrift": {
      "type": "array",
      "description": "Whether Arima model fitted with drift or not. It is always false when d is not 1.",
      "deprecated": true,
      "items": {
        "type": "boolean"
      }
    },
    "nonSeasonalOrder": {
      "type": "array",
      "description": "Non-seasonal order.",
      "deprecated": true,
      "items": {
        "$ref": "ArimaOrder.json"
      }
    },
    "timeSeriesId": {
      "type": "array",
      "description": "Id to differentiate different time series for the large-scale case.",
      "deprecated": true,
      "items": {
        "type": "string"
      }
    }
  }
}
