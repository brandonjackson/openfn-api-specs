{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigquery/ClusteringMetrics",
  "title": "ClusteringMetrics",
  "x-openfn-adaptor": "bigquery",
  "x-source": {
    "openapi": "#/components/schemas/ClusteringMetrics",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Evaluation metrics for clustering models.",
  "properties": {
    "daviesBouldinIndex": {
      "type": "number",
      "format": "double",
      "description": "Davies-Bouldin index."
    },
    "clusters": {
      "type": "array",
      "description": "Information for all clusters.",
      "items": {
        "$ref": "Cluster.json"
      }
    },
    "meanSquaredDistance": {
      "type": "number",
      "format": "double",
      "description": "Mean of squared distances between each sample to its cluster centroid."
    }
  }
}
