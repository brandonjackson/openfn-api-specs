{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bigquery/GenAiFunctionStats",
  "title": "GenAiFunctionStats",
  "x-openfn-adaptor": "bigquery",
  "x-source": {
    "openapi": "#/components/schemas/GenAiFunctionStats",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "Provides statistics for each Ai function call within a query.",
  "properties": {
    "functionName": {
      "type": "string",
      "description": "Name of the function."
    },
    "costOptimizationStats": {
      "$ref": "GenAiFunctionCostOptimizationStats.json"
    },
    "errorStats": {
      "$ref": "GenAiFunctionErrorStats.json"
    },
    "numProcessedRows": {
      "type": "string",
      "format": "int64",
      "description": "Number of rows processed by this GenAi function. This includes all cost_optimized, llm_inferred and failed_rows."
    },
    "cacheStats": {
      "$ref": "GenAiFunctionCacheStats.json"
    },
    "prompt": {
      "type": "string",
      "description": "User input prompt of the function (truncated to 20 chars)."
    }
  }
}
