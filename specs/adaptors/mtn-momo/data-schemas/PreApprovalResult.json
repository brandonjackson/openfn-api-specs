{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mtn-momo/PreApprovalResult",
  "title": "PreApprovalResult",
  "x-openfn-adaptor": "mtn-momo",
  "x-source": {
    "openapi": "#/components/schemas/PreApprovalResult",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "payer": {
      "$ref": "Party.json"
    },
    "payerCurrency": {
      "type": "string",
      "description": "ISO4217 Currency"
    },
    "payerMessage": {
      "type": "string",
      "description": "The mesage that is shown to the approver."
    },
    "status": {
      "enum": [
        "PENDING",
        "SUCCESSFUL",
        "FAILED"
      ],
      "type": "string"
    },
    "expirationDateTime": {
      "type": "integer",
      "description": "The expiry date +time of the preapproval, in YYYY-MM-DDTHH:mm:SS format"
    },
    "reason": {
      "$ref": "ErrorReason.json"
    }
  }
}
