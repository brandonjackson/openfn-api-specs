{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wigal-sms/HistoryRecord",
  "title": "HistoryRecord",
  "x-openfn-adaptor": "wigal-sms",
  "x-source": {
    "openapi": "#/components/schemas/HistoryRecord",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A sent message or call in the history.",
  "properties": {
    "apimessageid": {
      "type": "string",
      "description": "Your message id."
    },
    "status": {
      "type": "string",
      "enum": [
        "DELETED",
        "UNKNOWN",
        "EXPIRED",
        "WAITING",
        "FAILED",
        "REJECTD",
        "UNDELIV",
        "ACCEPTD",
        "DELIVRD",
        "BUSY",
        "ANSWERED"
      ]
    },
    "statusreason": {
      "type": "string"
    },
    "recipient": {
      "type": "string"
    },
    "statusdate": {
      "type": "string"
    },
    "bundlecredits": {
      "type": "number"
    },
    "charge": {
      "type": "number"
    },
    "service": {
      "type": "string"
    },
    "servicetype": {
      "type": "string"
    },
    "messagecount": {
      "type": "integer"
    },
    "charactercount": {
      "type": "integer"
    }
  },
  "example": {
    "apimessageid": "MGS1010101",
    "status": "DELIVRD",
    "statusreason": "DELIVRD",
    "recipient": "233200000000",
    "statusdate": "2024-06-26T13:06:14.087856",
    "bundlecredits": 0,
    "charge": 0.03,
    "service": "SMS",
    "servicetype": "TEXT",
    "messagecount": 1,
    "charactercount": 53
  }
}
