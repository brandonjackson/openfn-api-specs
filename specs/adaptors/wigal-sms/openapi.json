{
  "openapi": "3.0.3",
  "info": {
    "title": "Wigal Frog API",
    "version": "v3",
    "description": "Wigal's Frog messaging API (Ghana): SMS (general and personalised sends, history), SMS and voice OTP, voice calls (pre-recorded and interactive) and account balance, as documented on frogdocs.wigal.com.gh. Delivery reports, interactive-voice events and Smart USSD sessions are webhooks to the customer's own URLs and appear only as components.schemas. The OpenFn wigal-sms adaptor POSTs to /api/v3/sms/send on https://frogapi.wigal.com.gh with API-KEY and USERNAME headers.",
    "x-openfn-adaptor": "wigal-sms"
  },
  "servers": [
    {
      "url": "https://frogapi.wigal.com.gh",
      "description": "Live"
    }
  ],
  "tags": [
    {
      "name": "SMS"
    },
    {
      "name": "OTP"
    },
    {
      "name": "Voice"
    },
    {
      "name": "Account"
    }
  ],
  "security": [
    {
      "apiKey": [],
      "username": []
    }
  ],
  "paths": {
    "/api/v3/sms/send": {
      "post": {
        "operationId": "sendSms",
        "tags": [
          "SMS"
        ],
        "summary": "Send general or personalised SMS",
        "description": "One endpoint for both: a general send puts message/smstype at the top level; a personalised send puts them on each destination. Used by the adaptor's sendSms().",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendSmsRequest"
              },
              "examples": {
                "general": {
                  "value": {
                    "senderid": "MySenderId",
                    "destinations": [
                      {
                        "destination": "0200000000",
                        "msgid": "MGS1010101"
                      }
                    ],
                    "message": "This is a sample message.",
                    "smstype": "text"
                  }
                },
                "personalized": {
                  "value": {
                    "senderid": "MySenderId",
                    "destinations": [
                      {
                        "destination": "0200000000",
                        "message": "Hello, your order is ready",
                        "msgid": "MGS1010101",
                        "smstype": "text"
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acceptance"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request (status INVALID_REQUEST or ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid API credentials (status UNAUTHORIZED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden (status FORBIDDEN)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found, e.g. SENDER_ID_NOT_FOUND or invalid phone number",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (status ERROR)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
