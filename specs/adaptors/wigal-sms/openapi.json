          },
          "batchid": {
            "type": "string"
          },
          "callfrom": {
            "type": "string"
          },
          "callto": {
            "type": "string"
          },
          "clientid": {
            "type": "string",
            "description": "Your msgid."
          },
          "callstarttime": {
            "type": "string"
          },
          "callendtime": {
            "type": "string"
          },
          "callduration": {
            "type": "integer"
          },
          "direction": {
