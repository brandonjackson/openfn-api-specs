          "size": {
            "type": "integer"
          },
          "number": {
            "type": "integer"
          },
          "sort": {
            "$ref": "#/components/schemas/Sort"
          },
          "first": {
            "type": "boolean"
          },
          "numberOfElements": {
            "type": "integer"
          },
          "empty": {
            "type": "boolean"
          }
        }
      },
      "HistoryRecord": {
        "type": "object",
        "description": "A sent message or call in the history.",
        "properties": {
          "apimessageid": {
            "type": "string",
            "description": "Your message id."
          },
          "status": {
            "type": "string",
            "enum": [
              "DELETED",
              "UNKNOWN",
              "EXPIRED",
              "WAITING",
              "FAILED",
              "REJECTD",
              "UNDELIV",
              "ACCEPTD",
              "DELIVRD",
              "BUSY",
              "ANSWERED"
            ]
          },
          "statusreason": {
            "type": "string"
          },
          "recipient": {
            "type": "string"
          },
          "statusdate": {
            "type": "string"
          },
          "bundlecredits": {
            "type": "number"
          },
          "charge": {
            "type": "number"
          },
          "service": {
            "type": "string"
          },
          "servicetype": {
            "type": "string"
          },
          "messagecount": {
            "type": "integer"
          },
          "charactercount": {
            "type": "integer"
          }
        },
        "example": {
          "apimessageid": "MGS1010101",
          "status": "DELIVRD",
          "statusreason": "DELIVRD",
          "recipient": "233200000000",
          "statusdate": "2024-06-26T13:06:14.087856",
          "bundlecredits": 0,
          "charge": 0.03,
          "service": "SMS",
          "servicetype": "TEXT",
          "messagecount": 1,
          "charactercount": 53
        }
      },
      "HistoryRequest": {
        "type": "object",
        "description": "Filters for the history query. datefrom..dateto may span at most 3 months.",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "SMS",
              "USSD",
              "VOICE",
              "SIMACTIVE",
              "KYCVERIFY"
            ]
          },
          "servicetype": {
            "type": "string",
            "description": "TEXT, FLASH, CALL, RECORD, IVR, TEXT2SPEECH, OTP, SIMACTIVE or KYCVALIDATE."
          },
          "datefrom": {
            "type": "string",
            "format": "date"
          },
          "dateto": {
            "type": "string",
            "format": "date"
          },
          "senderid": {
            "type": "string",
            "description": "Approved sender ID."
          },
          "status": {
            "type": "string",
            "enum": [
              "DELETED",
              "UNKNOWN",
              "EXPIRED",
              "WAITING",
              "FAILED",
              "REJECTD",
              "UNDELIV",
              "ACCEPTD",
              "DELIVRD",
              "BUSY",
              "ANSWERED"
            ]
          },
          "msgid": {
            "type": "string",
            "description": "Message ID."
          }
        },
        "example": {
          "service": "SMS",
          "servicetype": "TEXT",
          "datefrom": "2024-04-01",
          "dateto": "2024-06-18",
          "senderid": "MySenderId",
          "status": "DELIVRD",
          "msgid": "MGS1010101"
        }
      },
      "InvoiceSummary": {
        "type": "object",
        "properties": {
          "invoicetype": {
            "type": "string",
            "description": "TOPUP, BUNDLE, CREDIT_NOTE, IOU, ..."
          },
          "count": {
            "type": "integer"
          },
          "totalamount": {
            "type": "number"
          }
        }
      },
      "MessageHistory": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "SUCCESS on success."
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/HistoryPage"
          }
        }
      },
      "OtpResult": {
        "type": "object",
        "description": "Result of an OTP generate or verify call.",
        "properties": {
          "status": {
            "type": "string",
            "description": "SUCCESS on success."
          },
          "message": {
            "type": "string"
          }
        },
        "example": {
          "status": "SUCCESS",
          "message": "OTP processed for delivery"
        }
      },
      "SendSmsRequest": {
        "type": "object",
        "required": [
          "senderid",
          "destinations"
        ],
        "description": "General send: one message for all destinations (top-level message/smstype). Personalised send: message and smstype set on each destination.",
        "properties": {
          "senderid": {
            "type": "string",
            "description": "Approved sender ID."
          },
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Destination"
            }
          },
          "message": {
            "type": "string",
            "description": "Message to send to every destination (general send)."
          },
          "smstype": {
            "type": "string",
            "description": "Message type. Default text."
          }
        },
        "example": {
          "senderid": "MySenderId",
          "destinations": [
            {
              "destination": "0200000000",
              "msgid": "MGS1010101"
            }
          ],
          "message": "This is a sample message.",
          "smstype": "text"
        }
      },
      "SendVoiceRequest": {
        "type": "object",
        "required": [
          "destinations"
        ],
        "properties": {
          "callerid": {
            "type": "string",
            "description": "Caller ID (a default is used if omitted)."
          },
          "soundurl": {
            "type": "string",
            "description": "URL of a WAV file (mono, a-law, 8 kHz, 64 kbps) to play. Not used by interactive calls."
          },
          "servicetype": {
            "type": "string",
            "description": "Service type. Default CALL."
          },
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Destination"
            }
          }
        },
        "example": {
          "callerid": "your_caller_id",
          "soundurl": "https://example.com/sound.wav",
          "servicetype": "CALL",
          "destinations": [
            {
              "destination": "0200000000",
              "msgid": "MSG123456789"
            }
          ]
        }
      },
      "Sort": {
        "type": "object",
        "properties": {
          "sorted": {
            "type": "boolean"
          },
          "empty": {
            "type": "boolean"
          },
          "unsorted": {
            "type": "boolean"
          }
        }
      },
      "UssdSession": {
        "type": "object",
        "description": "Smart USSD v2: JSON Frog POSTs to the content provider's URL, and the provider returns the same object with mode (MORE/END) and userdata (the menu text, ^ for newline) set. Smart USSD v1 sends the same fields (msisdn instead of phonenumber) as GET query parameters and expects a pipe-delimited reply.",
        "properties": {
          "network": {
            "type": "string"
          },
          "sessionid": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "START",
              "MORE",
              "END"
            ]
          },
          "phonenumber": {
            "type": "string"
          },
          "userdata": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "trafficid": {
            "type": "string"
          },
          "other": {
            "type": "string"
          }
        }
      },
      "VerifyOtpRequest": {
        "type": "object",
        "required": [
          "otpcode",
          "number"
        ],
        "properties": {
          "otpcode": {
            "type": "string",
            "description": "The OTP code to verify."
          },
          "number": {
            "type": "string",
            "description": "Recipient phone number."
          }
        },
        "example": {
          "otpcode": "8a2b3",
          "number": "0200000000"
        }
      },
