  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "API-KEY",
        "description": "Frog API key."
      },
      "username": {
        "type": "apiKey",
        "in": "header",
        "name": "USERNAME",
        "description": "Frog account username (sent with every request alongside API-KEY)."
      }
    },
    "schemas": {
      "Acceptance": {
        "type": "object",
        "description": "Acknowledgement that messages or calls were queued.",
        "properties": {
          "status": {
            "type": "string",
            "description": "ACCEPTD when the request was queued (Frog's spelling)."
          },
          "message": {
            "type": "string",
            "description": "Message Accepted For Processing on success."
          }
        },
        "example": {
          "status": "ACCEPTD",
          "message": "Message Accepted For Processing"
        }
      },
      "AccountBalance": {
        "type": "object",
        "description": "Balances on the Frog account.",
        "properties": {
          "paidcashbalance": {
            "type": "number",
            "description": "Paid cash balance."
          },
          "cashbalance": {
            "type": "number",
            "description": "Cash balance."
          },
          "bundles": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "Remaining units per service bundle (SMS, VOICE, USSD, KYCVERIFY, SIMACTIVE, ...)."
          },
          "invoicesummary": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InvoiceSummary"
            }
          },
          "activebundleinvoices": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleInvoice"
            }
          }
        },
        "example": {
          "paidcashbalance": 0,
          "cashbalance": 677.56,
          "bundles": {
            "VOICE": 15,
            "SMS": 82,
            "USSD": 100
          },
          "invoicesummary": [
            {
              "invoicetype": "TOPUP",
              "count": 2,
              "totalamount": 2
            }
          ],
          "activebundleinvoices": [
            {
              "id": 387,
              "description": "Mashup Bundle",
              "enddate": "2024-08-30",
              "invoicetype": "BUNDLE",
              "details": [
                {
                  "service": "SMS",
                  "quantity": 100,
                  "used": 18
                }
              ]
            }
          ]
        }
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "SUCCESS on success."
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/components/schemas/AccountBalance"
          }
        }
      },
      "BundleInvoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "enddate": {
            "type": "string",
            "format": "date"
          },
          "invoicetype": {
            "type": "string"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleUsage"
            }
          }
        }
      },
      "BundleUsage": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "used": {
            "type": "integer"
          }
        }
      },
      "DeliveryReport": {
        "type": "object",
        "description": "Webhook POSTed to the account's callback URL when a message's status changes (not returned by any endpoint).",
        "properties": {
          "msgid": {
            "type": "string",
            "description": "Message ID."
          },
          "status": {
            "type": "string",
            "enum": [
              "DELETED",
              "UNKNOWN",
              "EXPIRED",
              "WAITING",
              "FAILED",
              "REJECTD",
              "UNDELIV",
              "ACCEPTD",
              "DELIVRD",
              "BUSY",
              "ANSWERED"
            ]
          },
          "reason": {
            "type": "string"
          },
          "destination": {
            "type": "string"
          },
          "statusdate": {
            "type": "string"
          },
          "handlecharge": {
            "type": "integer"
          },
          "topupcharge": {
            "type": "integer"
          }
        },
        "example": {
          "msgid": "MGS1010101",
          "status": "DELIVRD",
          "reason": "DELIVRD",
          "destination": "233200000000",
          "statusdate": "2024-04-23T14:59:14.143+00:00",
          "handlecharge": 4,
          "topupcharge": 0
        }
      },
      "Destination": {
        "type": "object",
        "required": [
          "destination"
        ],
        "properties": {
          "destination": {
            "type": "string",
            "description": "Recipient phone number."
          },
          "msgid": {
            "type": "string",
            "description": "Your message id, echoed in delivery reports."
          },
          "message": {
            "type": "string",
            "description": "Per-recipient message (personalised send only)."
          },
          "smstype": {
            "type": "string",
            "description": "Per-recipient message type (personalised send only). Default text."
          }
        }
      },
      "Error": {
        "type": "object",
        "description": "Error body.",
        "properties": {
          "status": {
            "type": "string",
            "description": "Error status, e.g. ERROR, INVALID_REQUEST, UNAUTHORIZED, FORBIDDEN, SENDER_ID_NOT_FOUND."
          },
          "message": {
            "type": "string",
            "description": "Error description."
          },
          "data": {
            "nullable": true,
            "description": "Always null on errors."
          }
        }
      },
      "GenerateOtpRequest": {
        "type": "object",
        "required": [
          "number",
          "messagetemplate"
        ],
        "description": "messagetemplate placeholders: %OTPCODE% (required), %EXPIRY%, %SERVICE%, %LENGTH%, %TYPE%.",
        "properties": {
          "number": {
            "type": "string",
            "description": "Recipient phone number."
          },
          "expiry": {
            "type": "integer",
            "description": "Minutes before the OTP expires."
          },
          "length": {
            "type": "integer",
            "description": "Length of the OTP code."
          },
          "messagetemplate": {
            "type": "string",
            "description": "Message template with placeholders."
          },
          "type": {
            "type": "string",
            "enum": [
              "NUMERIC",
              "ALPHA",
              "ALPHANUMERIC"
            ]
          },
          "senderid": {
            "type": "string",
            "description": "Approved sender ID."
          }
        },
        "example": {
          "number": "0200000000",
          "expiry": 1,
          "length": 5,
          "messagetemplate": "Hello, your OTP is : %OTPCODE%. It will expire after %EXPIRY% mins",
          "type": "ALPHANUMERIC",
          "senderid": "MySenderId"
        }
      },
      "GenerateVoiceOtpRequest": {
        "type": "object",
        "required": [
          "number",
          "messagetemplate"
        ],
        "properties": {
          "number": {
            "type": "string",
            "description": "Recipient phone number."
          },
          "expiry": {
            "type": "integer",
            "description": "Minutes before the OTP expires."
          },
          "length": {
            "type": "integer"
          },
          "messagetemplate": {
            "type": "string",
            "description": "Spoken template with placeholders (%OTPCODE% required)."
          },
          "type": {
            "type": "string",
            "enum": [
              "NUMERIC",
              "ALPHA",
              "ALPHANUMERIC"
            ]
          },
          "callerid": {
            "type": "string",
            "nullable": true,
            "description": "Caller ID; a generic number is used when null."
          },
          "ttsvoicename": {
            "type": "string",
            "nullable": true,
            "description": "Text-to-speech voice.",
            "enum": [
              "Charon",
              "Fenrir",
              "Orus",
              "Puck",
              "Achernar",
              "Aoede",
              "Erinome",
              "Gacrux",
              "Kore",
              "Leda",
              "Sulafat",
              "Zephyr",
              null
            ]
          }
        },
        "example": {
          "number": "0200000000",
          "expiry": 15,
          "length": 5,
          "messagetemplate": "Hello, your OTP is : %OTPCODE%.",
          "type": "NUMERIC",
          "callerid": null,
          "ttsvoicename": null
        }
      },
      "HistoryPage": {
        "type": "object",
        "description": "Spring-style page of history records.",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HistoryRecord"
            }
          },
          "pageable": {
            "type": "object",
            "properties": {
              "pageNumber": {
                "type": "integer"
              },
              "pageSize": {
                "type": "integer"
              },
              "sort": {
                "$ref": "#/components/schemas/Sort"
              },
              "offset": {
                "type": "integer"
              },
              "unpaged": {
                "type": "boolean"
              },
              "paged": {
                "type": "boolean"
              }
