      "items": {
        "$ref": "Account.json"
      }
    },
    "collectionChannel": {
      "type": "string",
      "example": "RESERVED_ACCOUNT"
    },
    "reservationReference": {
      "type": "string",
      "example": "96ZPXECUD84UQTB00931"
    },
    "reservedAccountType": {
