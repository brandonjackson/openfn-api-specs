{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/WhatsAppMessageHistory",
  "title": "WhatsAppMessageHistory",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/WhatsAppMessageHistory",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "WhatsApp message history entry with delivery status information",
  "required": [
    "id",
    "message_id"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the message history entry",
      "example": "1234567890123456"
    },
    "message_id": {
      "type": "string",
      "description": "WhatsApp message ID (WAMID) for the message",
      "example": "wamid.HBgLMTY0NzM3Nzc3NzUVAgARGBI5QTNEQTA2RjdGMEY4RTRGAA=="
    },
    "events": {
      "type": "object",
      "description": "Message delivery status events and occurrences",
      "properties": {
        "data": {
          "type": "array",
          "description": "Array of delivery status events",
          "items": {
            "$ref": "MessageDeliveryStatusEvent.json"
          }
        },
        "paging": {
          "$ref": "PaginationInfo.json"
        }
      }
    }
  }
}
