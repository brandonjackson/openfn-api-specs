{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/GroupInfo",
  "title": "GroupInfo",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/GroupInfo",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Group ID"
    },
    "messaging_product": {
      "type": "string"
    },
    "join_approval_mode": {
      "type": "string",
      "enum": [
        "approval_required",
        "auto_approve"
      ],
      "description": "Join approval mode for the group"
    },
    "subject": {
      "type": "string",
      "description": "Group subject"
    },
    "description": {
      "type": "string",
      "description": "Group description"
    },
    "suspended": {
      "type": "boolean",
      "description": "Returns true if the group has been suspended by WhatsApp"
    },
    "creation_timestamp": {
      "type": "integer",
      "description": "UNIX timestamp in seconds at which the group was created"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "GroupsQueryParticipants.json"
      },
      "description": "List of participants in the group"
    },
    "total_participant_count": {
      "type": "integer",
      "description": "Total number of participants in the group, excluding your business"
    }
  }
}
