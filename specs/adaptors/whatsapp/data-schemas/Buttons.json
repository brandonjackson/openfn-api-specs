        "MPM",
        "OTP",
        "PHONE_NUMBER",
        "QUICK_REPLY",
        "URL"
      ],
      "description": "Button type"
    },
    "text": {
      "type": "string",
      "description": "Button label text"
    },
    "url": {
      "type": "string",
      "description": "URL for URL buttons"
    },
    "phone_number": {
