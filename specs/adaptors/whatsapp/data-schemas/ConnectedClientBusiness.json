{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/ConnectedClientBusiness",
  "title": "ConnectedClientBusiness",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/ConnectedClientBusiness",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "Connected client business information and configuration",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the connected client business",
      "example": "1234567890123456"
    },
    "name": {
      "type": "string",
      "description": "Name of the connected client business",
      "minLength": 1,
      "maxLength": 255,
      "example": "Example Client Business"
    },
    "verification_status": {
      "$ref": "BusinessVerificationStatus.json"
    },
    "business_status": {
      "$ref": "BusinessStatus.json"
    },
    "created_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the business connection was created",
      "example": "2023-01-15T10:30:00Z"
    },
    "updated_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the business connection was last updated",
      "example": "2023-06-20T14:45:00Z"
    }
  }
}
