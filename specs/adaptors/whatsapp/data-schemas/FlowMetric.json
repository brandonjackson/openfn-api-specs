{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/FlowMetric",
  "title": "FlowMetric",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/FlowMetric",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Endpoint performance metrics for a Flow, requested with the `fields=metric.name(...).granularity(...)` expansion. Returns no data until the Flow has generated 250 requests. Meta has announced the Metrics API for deprecation on 2026-04-30.",
  "properties": {
    "name": {
      "type": "string",
      "enum": [
        "ENDPOINT_REQUEST_COUNT",
        "ENDPOINT_REQUEST_ERROR",
        "ENDPOINT_REQUEST_ERROR_RATE",
        "ENDPOINT_REQUEST_LATENCY_SECONDS_CEIL",
        "ENDPOINT_AVAILABILITY"
      ],
      "description": "The metric queried."
    },
    "granularity": {
      "type": "string",
      "enum": [
        "DAY",
        "HOUR",
        "LIFETIME"
      ],
      "description": "Time granularity of the data points."
    },
    "data_points": {
      "type": "array",
      "items": {
        "$ref": "FlowMetricDataPoint.json"
      }
    }
  }
}
