{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/WhatsAppAccountNumber",
  "title": "WhatsAppAccountNumber",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/WhatsAppAccountNumber",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "WhatsApp Account Number details and configuration",
  "required": [
    "id",
    "display_phone_number",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the WhatsApp Account Number",
      "example": "1234567890123456"
    },
    "display_phone_number": {
      "type": "string",
      "description": "Phone number in international format for display purposes",
      "example": "+1 631-555-5555"
    },
    "verified_name": {
      "type": "string",
      "description": "Business name verified for this phone number",
      "example": "Jasper's Market"
    },
    "status": {
      "$ref": "WhatsAppAccountNumberStatus.json"
    },
    "quality_rating": {
      "$ref": "WhatsAppPhoneNumberQualityRating.json"
    },
    "country_code": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code",
      "example": "US"
    },
    "country_dial_code": {
      "type": "string",
      "description": "Country dialing code",
      "example": "1"
    },
    "code_verification_status": {
      "$ref": "WhatsAppCodeVerificationStatus.json"
    },
    "name_status": {
      "$ref": "WhatsAppDisplayNameStatus.json"
    },
    "messaging_limit_tier": {
      "type": "string",
      "description": "Current messaging limit tier for the account number",
      "enum": [
        "TIER_50",
        "TIER_250",
        "TIER_1K",
        "TIER_10K",
        "TIER_100K",
        "TIER_UNLIMITED"
      ],
      "example": "TIER_1K"
    },
    "account_mode": {
      "$ref": "WhatsAppBusinessSandboxEligibility.json"
    },
    "certificate": {
      "type": "string",
      "description": "Business certificate information for the account number",
      "example": "certificate_data_placeholder"
    },
    "is_official_business_account": {
      "type": "boolean",
      "description": "Whether this is an official business account",
      "example": false
    }
  }
}
