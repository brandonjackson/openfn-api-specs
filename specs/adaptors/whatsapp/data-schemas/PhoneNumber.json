{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/PhoneNumber",
  "title": "PhoneNumber",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/PhoneNumber",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "Phone number associated with the WABA",
  "properties": {
    "id": {
      "type": "string",
      "description": "Phone number ID",
      "example": "1234567890123456"
    },
    "display_phone_number": {
      "type": "string",
      "description": "Formatted phone number for display",
      "example": "+1 (555) 123-4567"
    },
    "verified_name": {
      "type": "string",
      "description": "Verified business name for the phone number",
      "example": "Example Business"
    }
  }
}
