{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/FlowAsset",
  "title": "FlowAsset",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/FlowAsset",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "An asset attached to a Flow. Today the only asset type is the Flow JSON itself.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Asset name, for example `flow.json`."
    },
    "asset_type": {
      "type": "string",
