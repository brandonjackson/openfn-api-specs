{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/Permission",
  "title": "Permission",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/Permission",
    "capturedAt": "2026-09-13"
  },
  "description": "Call permission details",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "granted",
        "pending",
        "denied",
        "expired"
      ],
      "description": "Current permission status for calling this user"
    },
    "expiration_time": {
      "description": "Unix timestamp when the permission expires (if applicable)"
    }
  },
  "required": [
    "status"
  ]
}
