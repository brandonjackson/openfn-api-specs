{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/CallingSettingsResponse",
  "title": "CallingSettingsResponse",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/CallingSettingsResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ],
      "description": "Current calling feature status"
    },
    "call_icon_visibility": {
      "type": "string",
      "enum": [
        "visible",
        "hidden"
      ],
      "description": "Current call icon visibility setting"
    },
    "ip_addresses": {
      "$ref": "IpAddresses.json"
    },
    "callback_permission_status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ],
      "description": "Callback permission status"
    },
    "srtp_key_exchange_protocol": {
      "type": "string",
      "enum": [
        "DTLS-SRTP",
        "SDES-SRTP"
      ],
      "description": "SRTP key exchange protocol (optional)"
    },
    "call_hours": {
      "$ref": "CallHoursSettings.json"
    },
    "call_icons": {
      "$ref": "CallIconsSettings.json"
    },
    "sip": {
      "$ref": "SipSettingsResponse.json"
    },
    "video": {
      "$ref": "VideoSettingsResponse.json"
    },
    "audio": {
      "$ref": "AudioSettingsResponse.json"
    },
    "restrictions": {
      "$ref": "CallingRestrictionsResponse.json"
    }
  },
  "required": [
    "status",
    "call_icon_visibility",
    "ip_addresses",
    "callback_permission_status"
  ]
}
