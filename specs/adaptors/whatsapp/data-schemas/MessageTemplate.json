{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/MessageTemplate",
  "title": "MessageTemplate",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/MessageTemplate",
    "capturedAt": "2026-09-13"
  },
  "description": "WhatsApp Business message template (HSM)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the message template"
    },
    "name": {
      "type": "string",
      "description": "Name of the template"
    },
    "status": {
      "$ref": "WhatsAppBusinessHSMStatus.json"
    },
    "ad_account_id": {
      "type": "string",
      "description": "Associated ad account ID for click-to-WhatsApp ad templates"
    },
    "ad_adset_id": {
      "type": "string",
      "description": "Associated ad set ID"
    },
    "ad_campaign_id": {
      "type": "string",
      "description": "Associated ad campaign ID"
    },
    "ad_id": {
      "type": "string",
      "description": "Associated ad group ID"
    },
    "bid_spec": {
      "$ref": "BidSpec.json"
    },
    "category": {
      "$ref": "WhatsAppBusinessHSMTag.json"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "Components.json"
      },
      "description": "Template components (header, body, footer, buttons)"
    },
    "correct_category": {
      "$ref": "WhatsAppBusinessHSMTag.json"
    },
    "cta_url_link_tracking_opted_out": {
      "type": "boolean",
      "description": "Whether CTA URL link tracking is opted out"
    },
    "degrees_of_freedom_spec": {
      "type": "object",
      "description": "Marketing message creative degrees of freedom specification"
    },
    "display_format": {
      "$ref": "WhatsAppBusinessMessageDisplayFormat.json"
    },
    "health_status": {
      "$ref": "HealthStatus.json"
    },
    "is_primary_device_delivery_only": {
      "type": "boolean",
      "description": "Whether this template is restricted to primary device delivery only"
    },
    "is_sms_fallback_enabled": {
      "type": "boolean",
      "description": "Whether SMS fallback is enabled for this template"
    },
    "language": {
      "type": "string",
      "description": "Language code of the template"
    },
    "last_updated_time": {
      "description": "Unix timestamp when the template was last updated"
    },
    "library_template_name": {
      "type": "string",
      "description": "Name of the library template this was created from"
    },
    "message_send_ttl_seconds": {
      "description": "Time-to-live in seconds for messages sent using this template"
    },
    "parameter_format": {
      "$ref": "BusinessMessagingHSMParameterFormat.json"
    },
    "previous_category": {
      "$ref": "WhatsAppBusinessHSMTag.json"
    },
    "quality_score": {
      "$ref": "QualityScore.json"
    },
    "rejected_reason": {
      "$ref": "WhatsAppBusinessHSMRejectionReason.json"
    },
    "source": {
      "$ref": "WhatsAppBusinessHSMSource.json"
    },
    "sub_category": {
      "$ref": "WhatsAppBusinessHSMTagSubCategory.json"
    }
  }
}
