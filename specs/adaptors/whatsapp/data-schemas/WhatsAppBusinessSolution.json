    },
    "status_for_pending_request": {
      "$ref": "WhatsAppBusinessSolutionPendingStatus.json"
    },
    "owner_app": {
      "$ref": "ApplicationNode.json"
    },
    "owner_permissions": {
      "type": "array",
      "description": "List of WhatsApp Business Account permissions granted to the solution owner",
      "items": {
        "$ref": "WhatsAppBusinessAccountPermissionTask.json"
      },
      "example": [
        "MANAGE",
        "DEVELOP",
        "MANAGE_TEMPLATES"
      ]
    }
  }
