{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/WhatsAppBusinessSolution",
  "title": "WhatsAppBusinessSolution",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
