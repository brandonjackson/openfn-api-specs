{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/RecurrencePattern",
  "title": "RecurrencePattern",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/RecurrencePattern",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "Pattern for recurring schedules",
  "properties": {
    "frequency": {
      "type": "string",
      "enum": [
        "DAILY",
        "WEEKLY",
        "MONTHLY",
        "YEARLY"
      ],
      "example": "WEEKLY"
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "description": "Interval between recurrences",
      "example": 1
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date for the recurrence pattern",
      "example": "2024-12-31"
    }
  }
}
