{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/Actions",
  "title": "Actions",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/Actions",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "properties": {
    "action_name": {
      "type": "string",
      "enum": [
        "start_call",
        "send_call_permission_request"
      ],
      "description": "Name of the action"
    },
    "can_perform_action": {
      "type": "boolean",
      "description": "Whether the business can perform this action"
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "Limits.json"
      },
      "description": "Rate limits for this action"
    }
  },
  "required": [
    "action_name",
    "can_perform_action"
  ]
}
