{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/OBOMobilityIntentNode",
  "title": "OBOMobilityIntentNode",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/OBOMobilityIntentNode",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "WhatsApp Business Account OBO Mobility Intent Node",
  "required": [
    "id",
    "waba",
    "solution"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the OBO Mobility Intent Node",
      "example": "1234567890123456"
    },
    "waba": {
      "$ref": "WhatsAppBusinessAccount.json"
    },
    "solution": {
      "$ref": "WhatsAppBusinessSolution.json"
    },
    "status": {
      "type": "string",
      "description": "Current status of the OBO mobility intent",
      "enum": [
        "PENDING",
        "ACTIVE",
        "COMPLETED",
        "CANCELLED",
        "FAILED"
      ],
      "example": "ACTIVE"
    },
    "created_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the OBO mobility intent was created (ISO 8601 format)",
      "example": "2024-01-15T10:30:00Z"
    },
    "updated_time": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the OBO mobility intent was last updated (ISO 8601 format)",
      "example": "2024-01-15T14:45:00Z"
    }
  }
}
