{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "whatsapp/AssignedUser",
  "title": "AssignedUser",
  "x-openfn-adaptor": "whatsapp",
  "x-source": {
    "openapi": "#/components/schemas/AssignedUser",
    "capturedAt": "2026-11-14"
  },
  "type": "object",
  "description": "User assigned to WhatsApp Business Account with permissions",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the assigned user",
      "example": "1234567890123456"
    },
    "name": {
      "type": "string",
      "description": "Display name of the assigned user",
      "example": "John Smith"
    },
    "business": {
      "$ref": "BusinessNode.json"
    },
    "user_type": {
      "$ref": "AssignedUserType.json"
    }
  }
}
