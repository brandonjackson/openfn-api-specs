      "maxLength": 255,
      "minLength": 1
    },
    "id": {
      "title": "Id",
      "type": "integer",
      "readOnly": true
    },
    "parameters": {
      "title": "Parameters",
      "type": "object"
    },
    "canonical_url": {
      "title": "Canonical url",
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 200
    },
    "url": {
      "title": "Url",
      "type": "string",
      "readOnly": true,
      "minLength": 1
    },
    "is_processing": {
      "title": "Is processing",
      "type": "boolean"
    },
    "collection_version": {
      "title": "Collection version",
      "type": "string",
      "readOnly": true,
      "minLength": 1
    },
    "extras": {
      "title": "Extras",
      "type": [
        "object",
        "null"
      ]
    }
  }
