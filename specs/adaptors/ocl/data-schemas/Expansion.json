{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocl/Expansion",
  "title": "Expansion",
  "x-openfn-adaptor": "ocl",
  "x-source": {
    "openapi": "#/components/schemas/Expansion",
