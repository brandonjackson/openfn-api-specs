{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ocl/ExpansionDetail",
  "title": "ExpansionDetail",
  "x-openfn-adaptor": "ocl",
  "x-source": {
    "openapi": "#/components/schemas/ExpansionDetail",
    "capturedAt": "2026-09-03"
  },
  "required": [
    "mnemonic",
    "parameters"
  ],
  "type": "object",
  "properties": {
    "mnemonic": {
      "title": "Mnemonic",
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\-\\.\\_\\@]+$",
      "maxLength": 255,
      "minLength": 1
    },
    "id": {
      "title": "Id",
      "type": "integer",
      "readOnly": true
    },
    "parameters": {
      "title": "Parameters",
      "type": "object"
    },
    "canonical_url": {
      "title": "Canonical url",
      "type": [
        "string",
        "null"
      ],
      "format": "uri",
      "maxLength": 200
    },
    "url": {
      "title": "Url",
      "type": "string",
      "readOnly": true,
      "minLength": 1
    },
    "created_on": {
      "title": "Created on",
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "created_by": {
      "title": "Created by",
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "is_processing": {
      "title": "Is processing",
      "type": "boolean"
    },
    "unresolved_repo_versions": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "title": "Unresolved repo versions",
        "type": "object"
      }
    },
    "collection_version": {
      "title": "Collection version",
      "type": "string",
      "readOnly": true,
      "minLength": 1
    },
    "explicit_collection_versions": {
      "type": "array",
      "items": {
        "$ref": "CollectionVersionList.json"
      },
      "readOnly": true
    },
    "explicit_source_versions": {
      "type": "array",
      "items": {
        "$ref": "SourceVersionList.json"
      },
      "readOnly": true
    },
    "evaluated_collection_versions": {
      "type": "array",
      "items": {
        "$ref": "CollectionVersionList.json"
      },
      "readOnly": true
    },
    "evaluated_source_versions": {
      "type": "array",
      "items": {
        "$ref": "SourceVersionList.json"
      },
      "readOnly": true
    },
    "extras": {
      "title": "Extras",
      "type": [
        "object",
        "null"
      ]
    }
  }
}
