{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-domains-httpapi-AccountLevelWebhookView",
  "title": "github.com-mailgun-domains-httpapi-AccountLevelWebhookView",
