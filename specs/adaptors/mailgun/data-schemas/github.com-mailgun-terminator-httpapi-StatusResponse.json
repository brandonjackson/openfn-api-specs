{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-terminator-httpapi-StatusResponse",
  "title": "github.com-mailgun-terminator-httpapi-StatusResponse",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-terminator-httpapi-StatusResponse",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "status": {
      "type": "object",
      "description": "Status of certificate. Either 'expired' 'processing' 'active' or 'error'"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "description": "An error message if an error occurred. Null if there is no error."
    },
    "certificate": {
      "type": "string",
      "description": "The x509 certificate in PEM format. Present only if the certificate status is 'active' 'error' or 'expired'"
    }
  },
  "required": [
    "status",
    "error"
  ]
}
