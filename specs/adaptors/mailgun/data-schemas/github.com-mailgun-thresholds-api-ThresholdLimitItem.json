{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-thresholds-api-ThresholdLimitItem",
  "title": "github.com-mailgun-thresholds-api-ThresholdLimitItem",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-thresholds-api-ThresholdLimitItem",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when the limit was created."
    },
    "last_checked": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when the limit was last checked."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of when the limit was last updated."
    },
    "current_count": {
      "type": [
        "string",
        "null"
      ],
      "description": "The metric's current value for this account, as of this request. Omitted if it could not be fetched."
    },
    "description": {
      "type": "string",
      "description": "A description of what the limit does."
    },
    "id": {
      "type": "string",
      "description": "The unique identifier for the limit."
    },
    "subaccount_id": {
      "type": "string",
      "description": "The subaccount ID this limit belongs to."
    },
    "parent_account_id": {
      "type": "string",
      "description": "The parent account ID."
    },
    "name": {
      "type": "string",
      "description": "A user-friendly name for the limit."
    },
    "metric": {
      "type": "string",
      "allOf": [
        {
          "$ref": "github.com-mailgun-thresholds-api-LimitMetric.json"
        }
      ],
      "description": "The metric being monitored."
    },
    "comparator": {
      "type": "string",
      "allOf": [
        {
          "$ref": "github.com-mailgun-thresholds-api-MetricComparator.json"
        }
      ],
      "description": "The comparison operator."
    },
    "limit": {
      "type": "string",
      "description": "The value of the limit."
    },
    "dimension": {
      "type": "string",
      "allOf": [
        {
          "$ref": "github.com-mailgun-thresholds-api-Dimension.json"
        }
      ],
      "description": "The dimension to apply to the metric."
    },
    "period": {
      "type": "string",
      "description": "The time period for the metric aggregation in the format of '1h' '1d'."
    },
    "account_group": {
      "type": "string",
      "description": "The group this account belongs to."
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "github.com-mailgun-thresholds-api-Filter.json"
      },
      "description": "A list of filters to apply to the limit."
    }
  },
  "required": [
    "created_at",
    "name",
    "metric",
    "comparator",
    "limit",
    "dimension"
  ]
}
