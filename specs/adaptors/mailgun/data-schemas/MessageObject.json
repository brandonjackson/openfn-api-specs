{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/MessageObject",
  "title": "MessageObject",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/MessageObject",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string",
            "description": "The name of the file attached to the message"
          },
          "content-type": {
            "type": "string",
            "description": "The type of the content attached to the message"
          },
          "size": {
            "type": "integer",
            "description": "The attachment size in bytes"
          }
        },
        "required": [
          "filename",
          "content-type",
          "size"
        ]
      }
    },
    "headers": {
      "type": "object",
      "properties": {
        "message-id": {
          "type": "string"
        },
        "from": {
          "type": "string",
          "description": "Message FROM header"
        },
        "to": {
          "type": "string",
          "description": "Message TO header"
        },
        "subject": {
          "type": "string",
          "description": "Message Subject"
        }
      },
      "required": [
        "message-id",
        "from"
      ]
    },
    "size": {
      "type": "integer",
      "description": "Total message size, in bytes"
    },
    "scheduled-for": {
      "type": "string",
      "description": "Date/Time the message was scheduled for delivery on ingest"
    }
  },
  "required": [
    "headers",
    "attachments",
    "size"
  ]
}
