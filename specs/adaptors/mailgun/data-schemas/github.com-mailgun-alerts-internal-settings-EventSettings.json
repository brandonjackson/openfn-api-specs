{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-alerts-internal-settings-EventSettings",
  "title": "github.com-mailgun-alerts-internal-settings-EventSettings",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-alerts-internal-settings-EventSettings",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "The unique identifier for the alert settings record."
    },
    "event_type": {
      "type": "string",
      "description": "The event type that is alerted on. Check GET /v1/alerts/events for possible values."
    },
    "channel": {
      "type": "string",
      "allOf": [
        {
          "$ref": "github.com-mailgun-alerts-channels-Channel.json"
        }
      ],
      "description": "The delivery channel for the alert."
    },
    "settings": {
      "type": "object",
      "allOf": [
        {
          "$ref": "github.com-mailgun-alerts-internal-settings-ChannelSettings.json"
        }
      ],
      "description": "This object contains channel-specific settings."
    },
    "disabled_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "When present, the timestamp indicating when a webhook endpoint was disabled."
    }
  },
  "required": [
    "event_type",
    "channel",
    "settings"
  ]
}
