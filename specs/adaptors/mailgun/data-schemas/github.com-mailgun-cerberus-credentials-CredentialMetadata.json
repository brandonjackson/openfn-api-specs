{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-cerberus-credentials-CredentialMetadata",
  "title": "github.com-mailgun-cerberus-credentials-CredentialMetadata",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-cerberus-credentials-CredentialMetadata",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "mailbox": {
      "type": "string",
      "description": "The email address-style username associated with this credential"
    },
    "login": {
      "type": "string",
      "description": "The email address-style username associated with this credential"
    },
    "created_at": {
      "type": "string",
      "description": "When the credential was created in RFC 2822 format with numeric timezone offset (UTC time)",
      "example": "Fri, 23 Jan 2026 10:16:00 +0000",
      "pattern": "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} [+-][0-9]{4}$"
    },
    "size_bytes": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "mailbox",
    "login",
    "created_at",
    "size_bytes"
  ]
}
