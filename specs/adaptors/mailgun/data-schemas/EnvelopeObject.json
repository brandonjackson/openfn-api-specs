{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/EnvelopeObject",
  "title": "EnvelopeObject",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/EnvelopeObject",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "sender": {
      "type": "string",
      "description": "The sender address"
    },
    "targets": {
      "type": "string",
      "description": "The recipient address"
    },
    "transport": {
      "type": "string",
      "description": "The protocol used to make the send. Either http or smtp"
    },
    "sending-ip": {
      "type": "string",
      "description": "The Mailgun IP the email has been sent from"
    }
  }
}
