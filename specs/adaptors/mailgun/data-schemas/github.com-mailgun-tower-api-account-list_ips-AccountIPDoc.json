{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-tower-api-account-list_ips-AccountIPDoc",
  "title": "github.com-mailgun-tower-api-account-list_ips-AccountIPDoc",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-tower-api-account-list_ips-AccountIPDoc",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "address": {
      "type": "string",
      "description": "the IP address"
    },
    "parent_account_id": {
      "type": "string",
      "description": "the id of the parent account"
    },
    "account_id": {
      "type": "string",
      "description": "the id of the account"
    },
    "pool_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "list of pool ids"
    },
    "dedicated": {
      "type": "boolean",
      "description": "whether the IP is dedicated"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "the time the IP was created"
    },
    "pool_last_modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "the last time the pool was modified"
    },
    "domains_last_modified_at": {
      "type": "string",
      "format": "date-time",
      "description": "the last time the domains were modified"
    }
  },
  "required": [
    "address",
    "parent_account_id",
    "account_id",
    "pool_ids",
    "dedicated",
    "pool_last_modified_at",
    "domains_last_modified_at"
  ]
