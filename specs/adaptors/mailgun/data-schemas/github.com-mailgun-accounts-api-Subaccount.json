{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mailgun/github.com-mailgun-accounts-api-Subaccount",
  "title": "github.com-mailgun-accounts-api-Subaccount",
  "x-openfn-adaptor": "mailgun",
  "x-source": {
    "openapi": "#/components/schemas/github.com-mailgun-accounts-api-Subaccount",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "The ID of the subaccount"
    },
    "name": {
      "type": "string",
      "description": "The name of the subaccount"
    },
    "created_at": {
      "type": "string",
      "description": "The date when the account was created serialized as RFC 1123 (HTTP-date) string in GMT (UTC)",
      "example": "Wed, 28 May 2025 20:03:05 GMT",
      "pattern": "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$"
    },
    "updated_at": {
      "type": "string",
      "description": "The date when the account was last updated serialized as RFC 1123 (HTTP-date) string in GMT (UTC)",
      "example": "Wed, 28 May 2025 20:03:05 GMT",
      "pattern": "^[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT$"
    },
    "status": {
      "$ref": "github.com-mailgun-accounts-api-SubaccountStatus.json"
    },
    "features": {
      "$ref": "github.com-mailgun-accounts-api-FeaturesResponse.json"
    }
  }
}
