{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ibipimo/ViralLoadResults",
  "title": "ViralLoadResults",
  "x-openfn-adaptor": "ibipimo",
  "x-source": {
    "openapi": "#/components/schemas/ViralLoadResults",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "siteid": {
      "type": "string"
    },
    "results": {
      "type": "array",
      "description": "Published results (element shape not documented; the README example is empty).",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "sample_statuses": {
      "type": "object",
      "description": "Map of sample UID to status.",
      "additionalProperties": {
        "$ref": "SampleStatus.json"
      }
    },
    "no_published_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "no_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "no_results_summary": {
      "type": "object",
      "description": "Map of reason code to {count, sample_uids}.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "count": {
            "type": "integer"
          },
          "sample_uids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "not_found_sample_uids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_requested": {
      "type": "integer"
    },
    "total_found": {
      "type": "integer"
    },
    "total_without_published_result": {
      "type": "integer"
    }
  }
}
