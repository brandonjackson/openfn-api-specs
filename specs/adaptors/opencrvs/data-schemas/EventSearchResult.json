{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencrvs/EventSearchResult",
  "title": "EventSearchResult",
  "x-openfn-adaptor": "opencrvs",
  "x-source": {
    "openapi": "#/components/schemas/EventSearchResult",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One row of `searchEvents.results` — a BirthEventSearchSet or DeathEventSearchSet.",
  "properties": {
    "__typename": {
      "type": "string",
      "example": "BirthEventSearchSet"
    },
    "id": {
      "type": "string",
      "description": "GraphQL ID scalar."
    },
    "type": {
      "type": "string",
      "example": "Birth"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date",
      "description": "BirthEventSearchSet only."
    },
    "childName": {
      "type": "array",
      "items": {
        "$ref": "HumanName.json"
      },
      "description": "BirthEventSearchSet only."
    },
    "dateOfDeath": {
      "type": "string",
      "format": "date",
      "description": "DeathEventSearchSet only."
    },
    "deceasedName": {
      "type": "array",
      "items": {
        "$ref": "HumanName.json"
      },
      "description": "DeathEventSearchSet only."
    },
    "registration": {
      "$ref": "RegistrationSearchSet.json"
    },
    "operationHistories": {
      "type": "array",
      "items": {
        "$ref": "OperationHistorySearchSet.json"
      }
    }
  }
}
