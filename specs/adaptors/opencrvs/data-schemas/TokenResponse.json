{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opencrvs/TokenResponse",
  "title": "TokenResponse",
  "x-openfn-adaptor": "opencrvs",
  "x-source": {
    "openapi": "#/components/schemas/TokenResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Bearer token minted by the auth service for a system client.",
  "properties": {
    "access_token": {
      "type": "string",
      "description": "Signed JWT. Sent as `Authorization: Bearer <token>` on every other call."
    },
    "token_type": {
      "type": "string",
      "example": "bearer"
    },
    "expires_in": {
      "type": "integer",
      "description": "Token lifetime in seconds.",
      "example": 3600
    }
  }
}
