{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memento/Library",
  "title": "Library",
  "x-openfn-adaptor": "memento",
  "x-source": {
    "openapi": "#/components/schemas/Library",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A library. GET /libraries returns id, name, owner, createdTime and modifiedTime; GET /libraries/{libraryId} adds revision, size and fields.",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "createdTime": {
      "type": "string",
      "format": "date-time"
    },
    "modifiedTime": {
      "type": "string",
      "format": "date-time"
    },
    "revision": {
      "type": "integer",
      "description": "Current library revision."
    },
    "size": {
      "type": "integer"
    },
    "fields": {
      "type": "array",
      "items": {
        "$ref": "LibraryField.json"
      }
    }
  },
  "example": {
    "id": "ht5dj7hqtey87",
    "name": "Library1",
    "owner": "author",
    "createdTime": "2015-08-05T08:40:51.620Z",
    "modifiedTime": "2016-08-05T08:40:51.620Z",
    "revision": 10,
    "size": 1200,
    "fields": [
      {
        "id": 1,
        "type": "text",
        "name": "Title",
        "role": "name",
        "order": 0
      },
      {
        "id": 2,
        "type": "int",
        "name": "Count",
        "role": "desc",
        "order": 1
      }
    ]
  }
}
