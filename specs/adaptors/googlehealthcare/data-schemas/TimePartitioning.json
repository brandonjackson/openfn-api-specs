{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlehealthcare/TimePartitioning",
  "title": "TimePartitioning",
  "x-openfn-adaptor": "googlehealthcare",
  "x-source": {
    "openapi": "#/components/schemas/TimePartitioning",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Configuration for FHIR BigQuery time-partitioned tables.",
  "properties": {
    "expirationMs": {
      "type": "string",
      "format": "int64",
      "description": "Number of milliseconds for which to keep the storage for a partition."
    },
    "type": {
      "type": "string",
      "description": "Type of partitioning.",
      "enum": [
        "PARTITION_TYPE_UNSPECIFIED",
        "HOUR",
        "DAY",
        "MONTH",
        "YEAR"
      ]
    }
  }
}
