{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenFn testing adaptor (local operations)",
    "version": "1.0.10",
    "description": "@openfn/language-testing is an internal adaptor used to test deployment in the adaptors monorepo (\"not intended for public use\"). It reaches no external system. Its own operation, version(), is modelled as a synthesized facade path (repo convention for adaptors with no external API); fn, combine and log are re-exported from common and listed in info.x-openfn-local-operations.",
    "x-openfn-adaptor": "testing",
    "x-openfn-local-operations": [
      {
        "name": "combine",
        "kind": "common re-export",
        "description": "From @openfn/language-common; no request."
      },
      {
        "name": "fn",
        "kind": "common re-export",
        "description": "From @openfn/language-common; no request."
      },
      {
        "name": "log",
        "kind": "common re-export",
        "description": "From @openfn/language-common; no request."
      }
    ]
  },
  "servers": [
    {
      "url": "http://localhost:4010",
      "description": "Mock placeholder: the operation runs in-process."
    }
  ],
  "tags": [
    {
      "name": "Adaptor",
      "description": "In-process operations."
    }
  ],
  "paths": {
    "/version": {
      "post": {
        "operationId": "version",
        "summary": "Write the adaptor package version to state.version",
        "tags": [
          "Adaptor"
        ],
        "description": "version() reads ../package.json and returns {...state, version}. Facade: request is the incoming state, response the next state.",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/State"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next state.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionedState"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "State": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "data": {
            "description": "Any value."
          },
          "references": {
            "type": "array",
            "items": {}
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "VersionedState": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string",
            "description": "Adaptor package version.",
            "example": "1.0.10"
          },
          "data": {
            "description": "Unchanged."
          },
          "references": {
            "type": "array",
            "items": {}
          }
        }
      }
    }
  }
}
