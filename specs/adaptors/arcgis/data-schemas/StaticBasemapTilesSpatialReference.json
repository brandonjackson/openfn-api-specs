{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arcgis/StaticBasemapTilesSpatialReference",
  "title": "StaticBasemapTilesSpatialReference",
  "x-openfn-adaptor": "arcgis",
  "x-source": {
    "openapi": "#/components/schemas/StaticBasemapTilesSpatialReference",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A spatial reference.",
  "required": [
    "wkid"
  ],
  "properties": {
    "wkid": {
      "description": "The well-known ID (WKID) of the coordinate system.",
      "type": "integer",
      "example": 102100
    },
    "latestWkid": {
      "description": "Identifies the current wkid value associated with the same spatial reference. For example a WKID of '102100' (Web Mercator) has a latestWKid of '3857'.",
      "type": "integer",
      "example": 3857
    }
  }
}
