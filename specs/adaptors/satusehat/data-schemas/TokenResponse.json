{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "satusehat/TokenResponse",
  "title": "TokenResponse",
  "x-openfn-adaptor": "satusehat",
  "x-source": {
    "openapi": "#/components/schemas/TokenResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "OAuth 2.0 client-credentials token response. Numeric-looking fields are returned as strings.",
  "properties": {
    "access_token": {
      "type": "string",
      "description": "Bearer token for the Authorization header."
    },
    "token_type": {
      "type": "string",
      "example": "BearerToken"
    },
    "expires_in": {
      "type": "string",
      "description": "Token lifetime in seconds.",
      "example": "3599"
    },
    "issued_at": {
      "type": "string",
      "description": "Issue time in epoch milliseconds.",
      "example": "1671109805593"
    },
    "client_id": {
      "type": "string"
    },
    "application_name": {
      "type": "string",
      "format": "uuid"
    },
    "organization_name": {
      "type": "string"
    },
    "api_product_list": {
      "type": "string",
      "example": "[api-sandbox]"
    },
    "api_product_list_json": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scope": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "example": "approved"
    },
    "refresh_count": {
      "type": "string"
    },
    "refresh_token_expires_in": {
      "type": "string"
    }
  }
}
