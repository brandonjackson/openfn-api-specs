{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "satusehat/Identifier",
  "title": "Identifier",
  "x-openfn-adaptor": "satusehat",
  "x-source": {
    "openapi": "#/components/schemas/Identifier",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A business identifier, namespaced by `system`.",
  "properties": {
    "use": {
      "type": "string",
      "enum": [
        "usual",
        "official",
        "temp",
        "secondary",
        "old"
      ]
    },
    "type": {
      "$ref": "CodeableConcept.json"
    },
    "system": {
      "type": "string",
      "format": "uri",
      "example": "https://fhir.kemkes.go.id/id/nik"
    },
    "value": {
      "type": "string"
    },
    "period": {
      "$ref": "Period.json"
    },
    "assigner": {
      "$ref": "Reference.json"
    }
  }
}
