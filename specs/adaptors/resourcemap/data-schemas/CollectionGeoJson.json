{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resourcemap/CollectionGeoJson",
  "title": "CollectionGeoJson",
  "x-openfn-adaptor": "resourcemap",
  "x-source": {
    "openapi": "#/components/schemas/CollectionGeoJson",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A page of a collection's geolocated sites, wrapped as a GeoJSON Feature whose properties carry the FeatureCollection plus paging info.",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "Feature"
      ]
    },
    "geometry": {
      "type": [
        "object",
        "null"
      ]
    },
    "properties": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "count": {
          "type": "integer"
        },
        "totalPages": {
          "type": "integer"
        },
        "previousPage": {
          "type": "string",
          "format": "uri"
        },
        "nextPage": {
          "type": "string",
          "format": "uri"
        },
        "features": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "FeatureCollection"
              ]
            },
            "features": {
              "type": "array",
              "items": {
                "$ref": "SiteFeature.json"
              }
            }
          }
        }
      }
    }
  }
}
