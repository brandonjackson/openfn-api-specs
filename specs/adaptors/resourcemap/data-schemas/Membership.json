{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resourcemap/Membership",
  "title": "Membership",
  "x-openfn-adaptor": "resourcemap",
  "x-source": {
    "openapi": "#/components/schemas/Membership",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A user's membership of a collection and the layer/site permissions it carries.",
  "properties": {
    "user_id": {
      "type": "integer"
    },
    "user_display_name": {
      "type": "string",
      "description": "Display name (the user's email in most deployments)."
    },
    "admin": {
      "type": "boolean"
    },
    "layers": {
      "type": "array",
      "items": {
        "$ref": "LayerPermission.json"
      }
    },
    "sites": {
      "type": "object",
      "properties": {
        "read": {
          "allOf": [
            {
              "$ref": "SitePermission.json"
            }
          ]
        },
        "write": {
          "allOf": [
            {
              "$ref": "SitePermission.json"
            }
          ]
        }
      }
    }
  }
}
