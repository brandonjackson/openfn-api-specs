{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resourcemap/Site",
  "title": "Site",
  "x-openfn-adaptor": "resourcemap",
  "x-source": {
    "openapi": "#/components/schemas/Site",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A site (a mapped resource/facility) as returned by the query API.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Present only for sites returned by a deleted_since query."
    },
    "lat": {
      "type": [
        "number",
        "null"
      ]
    },
    "long": {
      "type": [
        "number",
        "null"
      ],
      "description": "Longitude (spelled `long`, not `lng`, in query responses)."
    },
    "properties": {
      "type": "object",
      "additionalProperties": true,
      "description": "Field values keyed by field code (or numeric field id when codes are not used)."
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Group memberships, when the collection uses them."
    }
  },
  "example": {
    "id": 17442,
    "name": "Sunshine Hospital",
    "createdAt": "2012-03-28T07:55:56+00:00",
    "updatedAt": "2012-03-28T07:55:56+00:00",
    "lat": -1.901301,
    "long": 30.418267,
    "properties": {
      "Color": "1",
      "Services": [
        "XR",
        "OBG"
      ],
      "NUMBEDS": "20",
      "MGR": "Site manager"
    },
    "groups": []
  }
}
