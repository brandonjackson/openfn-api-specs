{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resourcemap/Field",
  "title": "Field",
  "x-openfn-adaptor": "resourcemap",
  "x-source": {
    "openapi": "#/components/schemas/Field",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A field definition inside a layer. `kind` drives which extra config keys are present.",
  "properties": {
    "id": {
      "type": "integer"
    },
    "collection_id": {
      "type": "integer"
    },
    "layer_id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string",
      "description": "Stable code used as the key in a site's `properties`."
    },
    "kind": {
      "type": "string",
      "enum": [
        "text",
        "numeric",
        "yes_no",
        "select_one",
        "select_many",
        "date",
        "hierarchy",
        "site",
        "user",
        "email",
        "phone",
        "photo",
        "identifier",
        "custom_aggregator"
      ]
    },
    "ord": {
      "type": [
        "integer",
        "null"
      ]
    },
    "config": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Kind-specific configuration (option lists, hierarchy trees, ranges)."
    },
    "metadata": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
