{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msgraph/microsoft.graph.photo",
  "title": "photo",
  "x-openfn-adaptor": "msgraph",
  "x-source": {
    "openapi": "#/components/schemas/microsoft.graph.photo",
    "capturedAt": "2026-09-14"
  },
  "required": [
    "@odata.type"
  ],
  "type": "object",
  "properties": {
    "cameraMake": {
      "type": [
        "string",
        "null"
      ],
      "description": "Camera manufacturer. Read-only."
    },
    "cameraModel": {
      "type": [
        "string",
        "null"
      ],
      "description": "Camera model. Read-only."
    },
    "exposureDenominator": {
      "oneOf": [
        {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "$ref": "ReferenceNumeric.json"
        }
      ],
      "description": "The denominator for the exposure time fraction from the camera. Read-only."
    },
    "exposureNumerator": {
      "oneOf": [
        {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "$ref": "ReferenceNumeric.json"
        }
      ],
      "description": "The numerator for the exposure time fraction from the camera. Read-only."
    },
    "fNumber": {
      "oneOf": [
        {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "$ref": "ReferenceNumeric.json"
        }
      ],
      "description": "The F-stop value from the camera. Read-only."
    },
    "focalLength": {
      "oneOf": [
        {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "$ref": "ReferenceNumeric.json"
        }
      ],
      "description": "The focal length from the camera. Read-only."
    },
    "iso": {
      "maximum": 2147483647,
      "minimum": -2147483648,
      "type": [
        "number",
        "null"
      ],
      "description": "The ISO value from the camera. Read-only.",
      "format": "int32"
    },
    "orientation": {
      "maximum": 32767,
      "minimum": -32768,
      "type": [
        "number",
        "null"
      ],
      "description": "The orientation value from the camera. Writable on OneDrive Personal.",
      "format": "int16"
    },
    "takenDateTime": {
      "pattern": "^[0-9]{4,}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,12})?(Z|[+-][0-9][0-9]:[0-9][0-9])$",
      "type": [
        "string",
        "null"
      ],
      "description": "Represents the date and time the photo was taken. Read-only.",
      "format": "date-time"
    },
    "@odata.type": {
      "type": "string"
    }
  }
}
