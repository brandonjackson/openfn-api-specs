{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "msgraph/microsoft.graph.chatMessageHistoryItem",
  "title": "chatMessageHistoryItem",
  "x-openfn-adaptor": "msgraph",
  "x-source": {
    "openapi": "#/components/schemas/microsoft.graph.chatMessageHistoryItem",
    "capturedAt": "2026-09-14"
  },
  "required": [
    "@odata.type"
  ],
  "type": "object",
  "properties": {
    "actions": {
      "$ref": "microsoft.graph.chatMessageActions.json"
    },
    "modifiedDateTime": {
      "pattern": "^[0-9]{4,}-(0[1-9]|1[012])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]([.][0-9]{1,12})?(Z|[+-][0-9][0-9]:[0-9][0-9])$",
      "type": "string",
      "description": "The date and time when the message was modified.",
      "format": "date-time"
    },
    "reaction": {
      "anyOf": [
        {
          "$ref": "microsoft.graph.chatMessageReaction.json"
        },
        {
          "type": [
            "object",
            "null"
          ]
        }
      ],
      "description": "The reaction in the modified message."
    },
    "@odata.type": {
      "type": "string"
    }
  }
}
