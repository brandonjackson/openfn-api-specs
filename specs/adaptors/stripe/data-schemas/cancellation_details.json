{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stripe/cancellation_details",
  "title": "CancellationDetails",
  "x-openfn-adaptor": "stripe",
  "x-source": {
    "openapi": "#/components/schemas/cancellation_details",
    "capturedAt": "2026-11-13"
  },
  "description": "",
  "properties": {
    "comment": {
      "description": "Additional comments about why the user canceled the subscription, if the subscription was canceled explicitly by the user.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "feedback": {
      "description": "The customer submitted reason for why they canceled, if the subscription was canceled explicitly by the user.",
      "enum": [
        "customer_service",
        "low_quality",
        "missing_features",
        "other",
        "switched_service",
        "too_complex",
        "too_expensive",
        "unused"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "feedback_option": {
      "anyOf": [
        {
          "maxLength": 5000,
          "type": "string"
        },
        {
          "$ref": "billing.feedback_option.json"
        }
      ],
      "description": "Customized feedback options that provide deeper insight into why the subscription was canceled, if the subscription was canceled explicitly by the user.",
      "x-expansionResources": {
        "oneOf": [
          {
            "$ref": "billing.feedback_option.json"
          }
        ]
      }
    },
    "reason": {
      "description": "Why this subscription was canceled.",
      "enum": [
        "canceled_by_retention_policy",
        "cancellation_requested",
        "payment_disputed",
        "payment_failed"
      ],
      "type": [
        "string",
        "null"
      ]
    }
  },
  "type": "object",
  "x-expandableFields": [
    "feedback_option"
  ]
}
