{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stripe/gelato_document_report",
  "title": "GelatoDocumentReport",
  "x-openfn-adaptor": "stripe",
  "x-source": {
    "openapi": "#/components/schemas/gelato_document_report",
    "capturedAt": "2026-07-06"
  },
  "description": "Result from a document check",
  "properties": {
    "address": {
      "anyOf": [
        {
          "$ref": "address.json"
        }
      ],
      "description": "Address as it appears in the document."
    },
    "dob": {
      "anyOf": [
        {
          "$ref": "gelato_data_document_report_date_of_birth.json"
        }
      ],
      "description": "Date of birth as it appears in the document."
    },
    "error": {
      "anyOf": [
        {
          "$ref": "gelato_document_report_error.json"
        }
      ],
      "description": "Details on the verification error. Present when status is `unverified`."
    },
    "expiration_date": {
      "anyOf": [
        {
          "$ref": "gelato_data_document_report_expiration_date.json"
        }
      ],
      "description": "Expiration date of the document."
    },
    "files": {
      "description": "Array of [File](https://docs.stripe.com/api/files) ids containing images for this document.",
      "items": {
        "maxLength": 5000,
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "first_name": {
      "description": "First name as it appears in the document.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "issued_date": {
      "anyOf": [
        {
          "$ref": "gelato_data_document_report_issued_date.json"
        }
      ],
      "description": "Issued date of the document."
    },
    "issuing_country": {
      "description": "Issuing country of the document.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "last_name": {
      "description": "Last name as it appears in the document.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "number": {
      "description": "Document ID number.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "sex": {
      "description": "Sex of the person in the document.",
      "enum": [
        "[redacted]",
        "female",
        "male",
        "unknown"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "description": "Status of this `document` check.",
      "enum": [
        "unverified",
        "verified"
      ],
      "type": "string",
      "x-stripeBypassValidation": true
    },
    "type": {
      "description": "Type of the document.",
      "enum": [
        "driving_license",
        "id_card",
        "passport"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "unparsed_place_of_birth": {
      "description": "Place of birth as it appears in the document.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    },
    "unparsed_sex": {
      "description": "Sex as it appears in the document.",
      "maxLength": 5000,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "status"
  ],
  "type": "object",
  "x-expandableFields": [
    "address",
    "dob",
    "error",
    "expiration_date",
    "issued_date"
  ]
}
