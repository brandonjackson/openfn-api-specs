{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stripe/terminal_reader_reader_resource_input",
  "title": "TerminalReaderReaderResourceInput",
  "x-openfn-adaptor": "stripe",
  "x-source": {
    "openapi": "#/components/schemas/terminal_reader_reader_resource_input",
    "capturedAt": "2026-07-06"
  },
  "description": "Represents an input to be collected using the reader",
  "properties": {
    "custom_text": {
      "anyOf": [
        {
          "$ref": "terminal_reader_reader_resource_custom_text.json"
        }
      ],
      "description": "Default text of input being collected."
    },
    "email": {
      "$ref": "terminal_reader_reader_resource_email.json"
    },
    "numeric": {
      "$ref": "terminal_reader_reader_resource_numeric.json"
    },
    "phone": {
      "$ref": "terminal_reader_reader_resource_phone.json"
    },
    "required": {
      "description": "Indicate that this input is required, disabling the skip button.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "selection": {
      "$ref": "terminal_reader_reader_resource_selection.json"
    },
    "signature": {
      "$ref": "terminal_reader_reader_resource_signature.json"
    },
    "skipped": {
      "description": "Indicate that this input was skipped by the user.",
      "type": "boolean"
    },
    "text": {
      "$ref": "terminal_reader_reader_resource_text.json"
    },
    "toggles": {
      "description": "List of toggles being collected. Values are present if collection is complete.",
      "items": {
        "$ref": "terminal_reader_reader_resource_toggle.json"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "type": {
      "description": "Type of input being collected.",
      "enum": [
        "email",
        "numeric",
        "phone",
        "selection",
        "signature",
        "text"
      ],
      "type": "string"
    }
  },
  "required": [
    "type"
  ],
  "type": "object",
  "x-expandableFields": [
    "custom_text",
    "email",
    "numeric",
    "phone",
    "selection",
    "signature",
    "text",
    "toggles"
  ]
}
