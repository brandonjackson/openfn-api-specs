{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lamisplus/LoginResponse",
  "title": "LoginResponse",
  "x-openfn-adaptor": "lamisplus",
  "x-source": {
    "openapi": "#/components/schemas/LoginResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A successful login. `accessToken` is sent on every later request as `Authorization: Bearer <accessToken>`.",
  "properties": {
    "accessToken": {
      "type": "string",
      "description": "JWT bearer token."
    },
    "tokenType": {
      "type": "string",
      "description": "Token scheme, e.g. Bearer."
    },
    "expiresIn": {
      "type": "integer",
      "description": "Token lifetime in seconds."
    },
    "email": {
      "type": "string",
      "description": "Email of the account that signed in."
    }
  },
  "example": {
    "accessToken": "eyJhbGciOiJIUzI1NiJ9.<redacted>",
    "tokenType": "Bearer",
    "expiresIn": 86400
  }
}
