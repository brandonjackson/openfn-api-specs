{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lamisplus/Patient",
  "title": "Patient",
  "x-openfn-adaptor": "lamisplus",
  "x-source": {
    "openapi": "#/components/schemas/Patient",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A patient (LAMISPlus calls the underlying record a Person). Property names and types follow the vendor's PersonResponseDto / Person entity in github.com/lamisplus/Patient-Module. The jsonb-backed properties (address, contact, contactPoint, identifier, gender, maritalStatus, education, employmentStatus, organization) are free-form JSON in the database and are not constrained here.",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "description": "Numeric primary key."
    },
    "uuid": {
      "type": "string",
      "description": "Record UUID. A plain string column — deployments do not all store a formatted UUID."
    },
    "hospitalNumber": {
      "type": [
        "string",
        "null"
      ],
      "description": "Facility hospital number."
    },
    "emrId": {
      "type": [
        "string",
        "null"
      ],
      "description": "EMR identifier."
    },
    "ninNumber": {
      "type": [
        "string",
        "null"
      ],
      "description": "National Identification Number."
    },
    "firstName": {
      "type": [
        "string",
        "null"
      ]
    },
    "surname": {
      "type": [
        "string",
        "null"
      ]
    },
    "otherName": {
      "type": [
        "string",
        "null"
      ]
    },
    "sex": {
      "type": [
        "string",
        "null"
      ],
      "description": "Sex as a free-text codeset value; the column is an unconstrained string, so casing varies between deployments (e.g. Male / MALE)."
    },
    "gender": {
      "description": "Gender codeset entry (free-form JSON)."
    },
    "dateOfBirth": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "IsDateOfBirthEstimated": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Whether dateOfBirth is an estimate. Spelt with a leading capital in PersonResponseDto."
    },
    "dateOfRegistration": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "active": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deceased": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "deceasedDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "archived": {
      "description": "Soft-delete flag. Modelled as an integer (0/1) on the Person entity; some responses carry a boolean."
    },
    "biometricStatus": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "facilityId": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "visitId": {
      "type": [
        "integer",
        "null"
      ],
      "format": "int64"
    },
    "address": {
      "description": "Address(es) as free-form JSON (jsonb column; an object or an array of AddressDto)."
    },
    "contact": {
      "description": "Contact details as free-form JSON."
    },
    "contactPoint": {
      "description": "Contact points as free-form JSON."
    },
    "identifier": {
      "description": "Identifiers as free-form JSON."
    },
    "maritalStatus": {
      "description": "Marital-status codeset entry (free-form JSON)."
    },
    "employmentStatus": {
      "description": "Employment-status codeset entry (free-form JSON)."
    },
    "education": {
      "description": "Education codeset entry (free-form JSON)."
    },
    "organization": {
      "description": "Organisation the record belongs to (free-form JSON)."
    },
    "dynamicHivStatus": {
      "type": [
        "string",
        "null"
      ]
    },
    "latitude": {
      "type": [
        "string",
        "null"
      ]
    },
    "longitude": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": [
        "string",
        "null"
      ],
      "description": "Where the record came from (e.g. the registering module)."
    }
  }
}
