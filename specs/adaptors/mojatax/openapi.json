{
  "openapi": "3.0.3",
  "info": {
    "title": "Mojatax VFD API",
    "version": "v1",
    "description": "Mojatax is a Tanzanian Virtual Fiscal Device (VFD) service: it registers sales receipts/invoices with the Tanzania Revenue Authority (TRA) on behalf of client systems. The API is private (documented only in a non-public Postman workspace). The OpenFn adaptor logs in with POST /api/v1/auth/clientLogin and then calls client routes under /api/v1/client/ with a bearer token; this document models every route the adaptor and its docs evidence.",
    "x-openfn-adaptor": "mojatax"
  },
  "servers": [
    {
      "url": "https://vfd-staging.mojatax.com",
      "description": "Staging host named in the adaptor configuration schema and the adaptor request issue (OpenFn/adaptors#773)."
    },
    {
      "url": "https://vfd.mojatax.com",
      "description": "Production VFD host (from certificate transparency logs; not documented, unverified)."
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Invoices"
    }
  ],
  "paths": {
    "/api/v1/auth/clientLogin": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "operationId": "clientLogin",
        "summary": "Exchange client credentials for an access token",
        "description": "Run by the adaptor's execute() unless configuration.access_token is already set. The adaptor reads response.body.access_token and sends it as `Authorization: Bearer <access_token>`.",
        "x-openfn-source": "adaptor source: packages/mojatax/src/Utils.js authorize(); test/Adaptor.test.js mock",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token issued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/client/CreateInvoice": {
      "post": {
        "tags": [
          "Invoices"
        ],
        "operationId": "createInvoice",
        "summary": "Create (fiscalise) an invoice",
        "description": "Submits a sale invoice for VFD registration. Reached with the adaptor's post('CreateInvoice', body), which prefixes /api/v1/client/. The request issue spells the route createInvoice; the adaptor and its tests use CreateInvoice. Only customerId, invoice_id and items appear in OpenFn's examples; the item shape and any receipt/verification fields in the response are not publicly documented.",
        "x-openfn-source": "adaptor source: packages/mojatax/src/Adaptor.js post()/request() JSDoc; README example; test/Adaptor.test.js mocks; issue OpenFn/adaptors#773",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateInvoiceRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Invoice accepted (the adaptor tests mock both 200 and 201).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "201": {
            "description": "Invoice created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Invoice"
                }
              }
            }
          },
          "401": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "access_token from POST /api/v1/auth/clientLogin."
      }
    },
    "schemas": {
      "ClientLoginRequest": {
        "type": "object",
        "required": [
          "client_id",
          "password"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "description": "Client id issued by Mojatax (configuration.clientId)."
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "required": [
          "access_token"
        ],
        "properties": {
          "access_token": {
            "type": "string",
            "description": "Bearer token."
          }
        }
      },
      "CreateInvoiceRequest": {
        "type": "object",
        "description": "Invoice payload. Only these fields appear in OpenFn's examples; others accepted by the API are not publicly documented.",
        "additionalProperties": true,
        "properties": {
          "invoice_id": {
            "type": "string",
            "description": "Client-side invoice reference."
          },
          "customerId": {
            "type": "string",
            "description": "Customer identifier."
          },
          "items": {
            "type": "array",
            "description": "Invoice line items (item shape not documented).",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "example": {
          "invoice_id": "PID092",
          "customerId": "102",
          "items": []
        }
      },
      "Invoice": {
        "type": "object",
        "description": "Invoice as echoed by the API. Fields beyond these (receipt number, verification code/URL) are not documented.",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "integer",
            "description": "Mojatax invoice id."
          },
          "invoice_id": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          }
        },
        "example": {
          "id": 7,
          "customerId": "102",
          "invoice_id": "PID092"
        }
      },
      "Error": {
        "type": "object",
        "description": "Error body; shape not documented.",
        "additionalProperties": true
      }
    }
  }
}
