{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws-s3/GetBucketVersioningOutput",
  "title": "GetBucketVersioningOutput",
  "x-openfn-adaptor": "aws-s3",
  "x-source": {
    "openapi": "#/components/schemas/GetBucketVersioningOutput",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "example": {
    "MFADelete": "Disabled",
    "Status": "Enabled"
  },
  "properties": {
    "Status": {
      "allOf": [
        {
          "$ref": "BucketVersioningStatus.json"
        },
        {
          "description": "The versioning state of the bucket."
        }
      ]
    },
    "MFADelete": {
      "allOf": [
        {
          "$ref": "MFADeleteStatus.json"
        },
        {
          "xml": {
            "name": "MfaDelete"
          },
          "description": "Specifies whether MFA delete is enabled in the bucket versioning configuration. This element is only returned if the bucket has been configured with MFA delete. If the bucket has never been so configured, this element is not returned."
        }
      ]
    }
  }
}
