{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aws-s3/AnnotationEntry",
  "title": "AnnotationEntry",
  "x-openfn-adaptor": "aws-s3",
  "x-source": {
    "openapi": "#/components/schemas/AnnotationEntry",
    "capturedAt": "2026-11-16"
  },
  "type": "object",
  "required": [
    "AnnotationName",
    "LastModified",
    "Size"
  ],
  "properties": {
    "AnnotationName": {
      "allOf": [
        {
          "$ref": "AnnotationName.json"
        }
      ],
      "description": "<p>The name of the annotation.</p>"
    },
    "LastModified": {
      "allOf": [
        {
          "$ref": "LastModified.json"
        }
      ],
      "description": "<p>The date and time the annotation was last modified.</p>"
    },
    "ETag": {
      "allOf": [
        {
          "$ref": "ETag.json"
        }
      ],
      "description": "<p>The entity tag of the annotation.</p>"
    },
    "ChecksumAlgorithm": {
      "allOf": [
        {
          "$ref": "ChecksumAlgorithmList.json"
        }
      ],
      "description": "<p>The checksum algorithm used for the annotation.</p>"
    },
    "Size": {
      "allOf": [
        {
          "$ref": "Size.json"
        }
      ],
      "description": "<p>The size of the annotation payload, in bytes.</p>"
    },
    "ReplicationStatus": {
      "allOf": [
        {
          "$ref": "ReplicationStatus.json"
        }
      ],
      "description": "<p>The replication status of the annotation.</p>"
    }
  },
  "description": "<p>Describes a single annotation attached to an object, including its name, last modified time,\n      size, ETag, checksum algorithm, and replication status. Returned in the response from\n      <code>ListObjectAnnotations</code>.</p>"
