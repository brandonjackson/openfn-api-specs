{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openfn/AccessToken",
  "title": "AccessToken",
  "x-openfn-adaptor": "openfn",
  "x-source": {
    "openapi": "#/components/schemas/AccessToken",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "required": [
    "access_token",
    "token_type",
    "expires_in"
  ],
  "properties": {
    "access_token": {
      "type": "string",
      "description": "Service-account JWT (typ at+jwt)."
    },
    "token_type": {
      "type": "string",
      "enum": [
        "Bearer"
      ]
    },
    "expires_in": {
      "type": "integer",
      "description": "Lifetime in seconds (300)."
    },
    "scope": {
      "type": "string",
      "description": "Space-separated grants issued."
    }
  }
}
