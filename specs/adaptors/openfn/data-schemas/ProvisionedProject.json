{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openfn/ProvisionedProject",
  "title": "ProvisionedProject",
  "x-openfn-adaptor": "openfn",
  "x-source": {
    "openapi": "#/components/schemas/ProvisionedProject",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A project as a provisioning document (LightningWeb.API.ProvisioningJSON): the project fields plus workflows, project credentials, collections and channels, with UUIDs for idempotent redeploys.",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "allow_support_access": {
      "type": "boolean"
    },
    "concurrency": {
      "type": [
        "integer",
        "null"
      ]
    },
    "scheduled_deletion": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "requires_mfa": {
      "type": "boolean"
    },
    "retention_policy": {
      "type": "string",
      "enum": [
        "retain_all",
        "retain_with_errors",
        "erase_all"
      ]
    },
    "history_retention_period": {
      "type": [
        "integer",
        "null"
      ]
    },
    "dataclip_retention_period": {
      "type": [
        "integer",
        "null"
      ]
    },
    "color": {
      "type": [
        "string",
        "null"
      ]
    },
    "env": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "inserted_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "ProvisionedWorkflow.json"
      }
    },
    "project_credentials": {
      "type": "array",
      "items": {
        "$ref": "ProvisionedProjectCredential.json"
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "ProvisionedCollection.json"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "Channel.json"
      }
    }
  }
}
