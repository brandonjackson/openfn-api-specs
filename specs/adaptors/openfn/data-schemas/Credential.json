{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openfn/Credential",
  "title": "Credential",
  "x-openfn-adaptor": "openfn",
  "x-source": {
    "openapi": "#/components/schemas/Credential",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A credential without its secret body (LightningWeb.API.CredentialJSON). Links to projects the caller may not list are pruned.",
  "required": [
    "id",
    "name"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string"
    },
    "schema": {
      "type": [
        "string",
        "null"
      ],
      "description": "Credential schema, e.g. raw, http, dhis2."
    },
    "external_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": "string",
      "description": "Owner.",
      "format": "uuid"
    },
    "project_credentials": {
      "type": "array",
      "items": {
        "$ref": "ProjectCredential.json"
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "$ref": "CredentialProject.json"
      }
    },
    "inserted_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
