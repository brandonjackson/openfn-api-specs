          ]
        },
        "at": {
          "$ref": "Timestamp.json"
        },
        "phone": {
          "$ref": "Phone.json"
        }
      },
      "required": [
        "at",
        "method",
        "phone"
      ]
    },
    {
      "type": "object",
      "title": "Reauthenticated by password\n",
      "properties": {
