        },
        "email": {
          "$ref": "Email.json"
        }
      },
      "required": [
        "at",
        "email",
        "method"
      ]
    },
    {
      "type": "object",
      "title": "Authenticated by confirming a code sent by email.\n",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "code"
          ]
        },
        "at": {
          "$ref": "Timestamp.json"
        },
        "email": {
          "$ref": "Email.json"
        }
      },
      "required": [
        "at",
        "email",
        "method"
      ]
    },
    {
      "type": "object",
      "title": "Authenticated by confirming a code sent by phone.\n",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
