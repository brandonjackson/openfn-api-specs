{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kobotoolbox/AuthenticationMethod",
  "title": "AuthenticationMethod",
  "x-openfn-adaptor": "kobotoolbox",
  "x-source": {
