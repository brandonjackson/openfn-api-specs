{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kobotoolbox/Hook",
  "title": "Hook",
  "x-openfn-adaptor": "kobotoolbox",
  "x-source": {
    "openapi": "#/components/schemas/Hook",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean"
    },
    "asset": {
      "type": "integer",
      "readOnly": true
    },
    "auth_level": {
      "$ref": "AuthLevelEnum.json"
    },
    "date_modified": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    },
    "email_notification": {
      "type": "boolean"
    },
    "endpoint": {
      "type": "string",
      "maxLength": 500
    },
    "export_type": {
      "$ref": "ExportTypeEnum.json"
    },
    "failed_count": {
      "type": "integer",
      "readOnly": true
    },
    "logs_url": {
      "type": "string",
      "format": "uri",
      "example": "https://kf.kobotoolbox.org/api/v2/assets/a3C9wWefqZVkChNLKqqXVZ/hooks/hZzzeedWxQoFHgibsTCysv/logs/",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "maxLength": 255
    },
    "payload_template": {
      "type": [
        "string",
        "null"
      ]
    },
    "pending_count": {
      "type": "integer",
      "readOnly": true
    },
    "settings": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "custom_headers": {
          "type": "object",
          "properties": {
            "value_field": {
              "type": "string"
            },
            "value_field_2": {
              "type": "string"
            }
          }
        }
      }
    },
    "subset_fields": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_count": {
      "type": "integer",
      "readOnly": true
    },
    "uid": {
      "type": "string",
      "readOnly": true
    },
    "url": {
      "type": "string",
      "format": "uri",
      "example": "https://kf.kobotoolbox.org/api/v2/assets/a3C9wWefqZVkChNLKqqXVZ/",
      "readOnly": true
    }
  },
  "required": [
    "asset",
    "date_modified",
    "endpoint",
    "failed_count",
    "logs_url",
    "name",
    "pending_count",
    "success_count",
    "uid",
    "url"
  ]
}
