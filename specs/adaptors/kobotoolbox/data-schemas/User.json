{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kobotoolbox/User",
  "title": "User",
  "x-openfn-adaptor": "kobotoolbox",
  "x-source": {
    "openapi": "#/components/schemas/User",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "properties": {
    "id": {
      "description": "The user ID.",
      "example": 123,
      "type": "integer"
    },
    "display": {
      "description": "The display name for the user.",
      "example": "Magic Wizard",
      "type": "string"
    },
    "email": {
      "description": "The email address.",
      "example": "email@domain.org",
      "type": "string"
    },
    "has_usable_password": {
      "description": "Whether or not the account has a password set.",
      "example": true,
      "type": "boolean"
    },
    "username": {
      "description": "The username.",
      "example": "wizard",
      "type": "string"
    }
  },
  "required": [
    "display",
    "has_usable_password",
    "username"
  ]
}
