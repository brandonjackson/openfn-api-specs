{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facebook/Actions",
  "title": "Actions",
  "x-openfn-adaptor": "facebook",
  "x-source": {
    "openapi": "#/components/schemas/Actions",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "action_name": {
      "type": "string",
      "enum": [
        "send_call_permission_request",
        "start_call"
      ],
      "description": "Name of the action (send_call_permission_request or start_call)"
    },
    "can_perform": {
      "type": "boolean",
      "description": "Whether the action can be performed"
    },
    "limits": {
      "type": "array",
      "items": {
        "$ref": "Limits.json"
      },
      "description": "Rate limit information for the action"
    }
  },
  "required": [
    "action_name",
    "can_perform"
  ]
}
