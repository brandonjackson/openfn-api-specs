{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facebook/Message",
  "title": "Message",
  "x-openfn-adaptor": "facebook",
  "x-source": {
    "openapi": "#/components/schemas/Message",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "created_time": {
      "type": "string",
      "format": "date-time"
    },
    "message": {
      "type": "string",
      "description": "Text."
    },
    "from": {
      "$ref": "Participant.json"
    },
    "to": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "Participant.json"
          }
        }
      }
    },
    "attachments": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "MessageAttachment.json"
          }
        },
        "paging": {
          "$ref": "Paging.json"
        }
      }
    },
    "reactions": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "MessageReaction.json"
          }
        }
      }
    },
    "shares": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "MessageShare.json"
          }
        }
      }
    },
    "sticker": {
      "type": "string"
    },
    "tags": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "id"
  ],
  "description": "A message in a conversation (fields requested with ?fields=)."
}
