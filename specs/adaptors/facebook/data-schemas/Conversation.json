{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facebook/Conversation",
  "title": "Conversation",
  "x-openfn-adaptor": "facebook",
  "x-source": {
    "openapi": "#/components/schemas/Conversation",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "updated_time": {
      "type": "string",
      "format": "date-time"
    },
    "link": {
      "type": "string"
    },
    "message_count": {
      "type": "integer"
    },
    "unread_count": {
      "type": "integer"
    },
    "participants": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "Participant.json"
          }
        }
      }
    },
    "messages": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "Message.json"
          }
        },
        "paging": {
          "$ref": "Paging.json"
        }
      }
    }
  },
  "required": [
    "id"
  ],
  "description": "A Messenger conversation (thread) between a Page and a person."
}
