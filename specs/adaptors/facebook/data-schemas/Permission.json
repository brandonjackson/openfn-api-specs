{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "facebook/Permission",
  "title": "Permission",
  "x-openfn-adaptor": "facebook",
  "x-source": {
    "openapi": "#/components/schemas/Permission",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "HAS_PERMISSION",
        "NO_PERMISSION"
      ],
      "description": "Permission status (HAS_PERMISSION or NO_PERMISSION)"
    },
    "expiration_time": {
      "type": "integer",
      "description": "Unix timestamp when permission expires (only present if HAS_PERMISSION)"
    }
  },
  "required": [
    "status"
  ],
  "description": "Permission status for business-initiated calls"
}
