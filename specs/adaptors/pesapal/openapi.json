        ],
        "description": "Present in the live swagger.json but not described in the docs.",
        "parameters": [
          {
            "name": "confirmationCode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
