{
  "openapi": "3.0.3",
  "info": {
    "title": "Pesapal API 3.0",
    "version": "3.0",
    "description": "Pesapal API 3.0 (JSON) for e-commerce payments: authentication, IPN URL registration, order submission (including recurring/subscription and mobile-money STK orders), transaction status, refunds and order cancellation. Requests use a Bearer token from Auth/RequestToken. The OpenFn pesapal adaptor sends generic get/post/request calls to `<baseUrl>/<apiVersion>/api/<path>` after fetching a token.",
    "x-openfn-adaptor": "pesapal"
  },
  "externalDocs": {
    "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/api-reference"
  },
  "servers": [
    {
      "url": "https://pay.pesapal.com/v3",
      "description": "Live"
    },
    {
      "url": "https://cybqa.pesapal.com/pesapalv3",
      "description": "Sandbox / demo"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "IPN"
    },
    {
      "name": "Transactions"
    },
    {
      "name": "Internal",
      "description": "Undocumented endpoints listed in the live swagger.json."
    }
  ],
  "paths": {
    "/api/Auth/RequestToken": {
      "post": {
        "operationId": "requestToken",
        "summary": "Request an access token",
        "tags": [
          "Authentication"
        ],
        "security": [],
        "description": "Exchange the merchant consumer_key and consumer_secret for a Bearer token valid for about 5 minutes.",
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/authentication"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TokenRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/URLSetup/RegisterIPN": {
      "post": {
        "operationId": "registerIpnUrl",
        "summary": "Register an IPN URL",
        "tags": [
          "IPN"
        ],
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/registeripnurl"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IPNCreateRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IpnUrl"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/URLSetup/GetIpnList": {
      "get": {
        "operationId": "listIpnUrls",
        "summary": "List registered IPN URLs",
        "tags": [
          "IPN"
        ],
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/getregisteredipn"
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IpnUrl"
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/URLSetup/RegisterCallBackUrl": {
      "post": {
        "operationId": "registerCallbackUrl",
        "summary": "Register a callback URL",
        "tags": [
          "IPN"
        ],
        "description": "Present in the live swagger.json (URLSetup_RegisterCallBackUrl, same IPNCreateRequestDTO body as RegisterIPN) but not described in the docs.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IPNCreateRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/SubmitOrderRequest": {
      "post": {
        "operationId": "submitOrderRequest",
        "summary": "Submit an order request",
        "tags": [
          "Transactions"
        ],
        "description": "Create a payment request and get a redirect_url for the hosted payment page. Also used for recurring payments (account_number, subscription_details).",
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/submitorderrequest"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionOrderRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderSubmission"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/stk": {
      "post": {
        "operationId": "submitMobileMoneyStk",
        "summary": "Direct mobile money (STK push) order",
        "tags": [
          "Transactions"
        ],
        "description": "Listed only in the vendor Postman collection (DirectMobileMoneySTK); not in the docs or swagger.json.",
        "externalDocs": {
          "url": "https://documenter.getpostman.com/view/6715320/UyxepTv1"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DirectMobileMoneyRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/GetTransactionStatus": {
      "get": {
        "operationId": "getTransactionStatus",
        "summary": "Get transaction status",
        "tags": [
          "Transactions"
        ],
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/gettransactionstatus"
        },
        "parameters": [
          {
            "name": "orderTrackingId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "OrderTrackingId from SubmitOrderRequest, the callback or the IPN."
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionStatus"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/GetTransactionByMerchantReference": {
      "get": {
        "operationId": "getTransactionByMerchantReference",
        "summary": "Get a transaction by merchant reference",
        "tags": [
          "Transactions"
        ],
        "description": "Present in the live swagger.json but not described in the docs.",
        "parameters": [
          {
            "name": "merchantReference",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK (body not documented)",
