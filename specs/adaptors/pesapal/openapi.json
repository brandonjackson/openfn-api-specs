    "/api/webhooks/fingerprintjs/blockFingerprintBasicAuth": {
      "post": {
        "operationId": "blockFingerprintBasicAuth",
        "summary": "FingerprintJS webhook receiver (basic auth)",
        "tags": [
          "Internal"
        ],
        "deprecated": true,
        "description": "Pesapal's inbound webhook for its fraud vendor, present in swagger.json; not a merchant API. Marked deprecated.",
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token from POST /api/Auth/RequestToken (valid ~5 minutes)."
      }
    },
    "responses": {
      "Error": {
        "description": "Error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "AccessToken": {
        "type": "object",
        "description": "Bearer token for all other API 3.0 calls; valid for about 5 minutes.",
        "properties": {
          "token": {
            "type": "string",
            "description": "The access token."
          },
          "expiryDate": {
            "type": "string",
            "format": "date-time",
            "description": "UTC expiry time of the token."
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          },
          "status": {
            "type": "string",
            "description": "Response code, e.g. \"200\"."
          },
          "message": {
            "type": "string"
          }
        },
        "example": {
          "token": "<access-token>",
          "expiryDate": "2021-08-26T12:29:30.5177702Z",
          "error": null,
          "status": "200",
          "message": "Request processed successfully"
        }
      },
      "ApiError": {
        "type": "object",
        "nullable": true,
        "description": "Error object; null when there is no error.",
        "properties": {
          "error_type": {
            "type": "string",
            "nullable": true
          },
          "type": {
            "type": "string",
            "nullable": true
          },
          "code": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "call_back_url": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "DirectMobileMoneyRequest": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "amount",
          "description",
          "callback_url",
          "notification_id"
        ],
        "properties": {
          "msisdn": {
            "type": "string",
            "description": "Mobile number to push the STK prompt to."
          },
          "payment_method": {
            "type": "string",
            "description": "Mobile money method, e.g. MpesaKE."
          },
          "id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0,
            "description": "Unique merchant reference for the order (alphanumerics, -, _, ., :). The docs cap it at 50 characters."
          },
          "account_number": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "description": "Customer account or invoice number; enables recurring (subscription) payments."
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0,
            "description": "ISO currency code to charge in."
          },
          "allowed_currencies": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "amount": {
            "type": "number",
            "description": "Amount to be processed."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Order description (docs: maximum 100 characters)."
          },
          "callback_url": {
            "type": "string",
            "minLength": 1,
            "description": "URL Pesapal redirects the customer to after payment; OrderTrackingId, OrderMerchantReference and OrderNotificationType=CALLBACKURL are appended."
          },
          "cancellation_url": {
            "type": "string",
            "description": "URL Pesapal redirects the customer to if they cancel on the payment page."
          },
          "notification_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 1,
            "description": "ipn_id of a registered IPN URL (see RegisterIPN)."
          },
          "language": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0,
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "terms_and_conditions_id": {
            "type": "string",
            "format": "uuid",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "billing_address": {
            "$ref": "#/components/schemas/MerchantOrderBillingDetailsRequestDTO",
            "description": "Customer address object. Required by the docs; phone_number or email_address must be set."
          },
          "other_data": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "settlement_instructions": {
            "$ref": "#/components/schemas/SettlementInstructionsInfoDTO",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "flight_data": {
            "$ref": "#/components/schemas/FlightDetailsDTO",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "app_id": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "order_type": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "payment_type": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "redirect_mode": {
            "type": "string",
            "description": "Where the callback URL is loaded. Defaults to TOP_WINDOW.",
            "enum": [
              "TOP_WINDOW",
              "PARENT_WINDOW",
              ""
            ]
          },
          "branch": {
            "type": "string",
            "maxLength": 30,
            "minLength": 0,
            "description": "Store / branch the payment is credited to."
          },
          "subscription_details": {
            "$ref": "#/components/schemas/SubscriptionInfoItem",
            "description": "Subscription to pre-fill on the payment page (recurring payments)."
          },
          "device_id": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "ip": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "device_fingerprint": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          }
        },
        "description": "SubmitOrderRequest body plus the mobile-money fields shown in the vendor Postman collection (DirectMobileMoneySTK). Only msisdn and payment_method are evidenced beyond the order fields."
      },
      "Error": {
        "type": "object",
        "description": "Error envelope returned when an API call fails.",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "FlightDetailsDTO": {
        "type": "object",
        "properties": {
          "complete_route": {
            "type": "string"
          },
          "journey_type": {
            "type": "string"
          },
          "departure_date": {
            "type": "string"
          },
          "passenger_details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PassengerDetailsDTO"
            }
          }
        }
      },
      "IPNCreateRequestDTO": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "The notification URL Pesapal will send a status alert to."
          },
          "ipn_notification_type": {
            "type": "string",
            "maxLength": 4,
            "description": "HTTP method Pesapal uses when triggering the IPN alert.",
            "enum": [
              "GET",
              "POST"
            ]
          }
        }
      },
      "IpnNotification": {
        "type": "object",
        "description": "Body Pesapal POSTs to a POST-registered IPN URL (GET-registered URLs receive the same fields as query parameters). OrderNotificationType is IPNCHANGE or RECURRING.",
        "properties": {
          "OrderNotificationType": {
            "type": "string",
            "enum": [
              "IPNCHANGE",
              "RECURRING"
            ]
          },
          "OrderTrackingId": {
            "type": "string"
          },
          "OrderMerchantReference": {
            "type": "string"
          }
        }
      },
      "IpnUrl": {
        "type": "object",
        "description": "A registered IPN (Instant Payment Notification) URL.",
        "properties": {
          "url": {
            "type": "string",
            "description": "Notification URL Pesapal sends status alerts to."
          },
          "created_date": {
            "type": "string",
            "format": "date-time",
            "description": "When the IPN URL was registered (UTC)."
          },
          "ipn_id": {
            "type": "string",
            "format": "uuid",
            "description": "Identifier of the IPN endpoint; pass it as notification_id when submitting orders."
          },
          "notification_type": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "Notification type (0 = GET, 1 = POST in the docs sample)."
          },
          "ipn_notification_type_description": {
            "type": "string",
            "description": "HTTP method the IPN URL was registered with."
          },
          "ipn_status": {
            "type": "integer",
            "enum": [
              0,
              1
            ],
            "description": "1 = Active, 0 = Inactive."
          },
          "ipn_status_description": {
            "type": "string",
            "description": "Active or Inactive."
          },
          "error": {
            "$ref": "#/components/schemas/ApiError"
          },
          "status": {
            "type": "string"
          }
        },
        "example": {
          "url": "https://example.com/ipn",
          "created_date": "2024-06-14T07:50:22.2825997Z",
          "ipn_id": "84740ab4-3cd9-47da-8a4f-dd1db53494b5",
          "notification_type": 0,
          "ipn_notification_type_description": "GET",
          "ipn_status": 1,
          "ipn_status_description": "Active",
          "error": null,
          "status": "200"
        }
      },
