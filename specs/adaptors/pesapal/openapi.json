            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "amount",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check (sandbox only)",
        "tags": [
          "Internal"
        ],
        "deprecated": true,
        "security": [],
        "description": "Listed only in the sandbox swagger.json (Transactions_HealthCheck); not documented. Marked deprecated as an internal endpoint.",
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/webhooks/fingerprintjs/blockFingerprint": {
      "post": {
        "operationId": "blockFingerprint",
        "summary": "FingerprintJS webhook receiver",
        "tags": [
          "Internal"
        ],
        "deprecated": true,
        "description": "Pesapal's inbound webhook for its fraud vendor, present in swagger.json; not a merchant API. Marked deprecated.",
        "responses": {
          "200": {
            "description": "OK (body not documented)",
            "content": {
              "application/json": {
                "schema": {
                  "description": "Response body not documented: the live swagger.json types every response as a file/stream and the docs do not describe this endpoint."
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
