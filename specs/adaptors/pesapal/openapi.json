          "device_id": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "ip": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "device_fingerprint": {
            "type": "string",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
