      "TransactionOrderRequestDTO": {
        "type": "object",
        "required": [
          "id",
          "currency",
          "amount",
          "description",
          "callback_url",
          "notification_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 150,
            "minLength": 0,
            "description": "Unique merchant reference for the order (alphanumerics, -, _, ., :). The docs cap it at 50 characters."
          },
          "account_number": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "description": "Customer account or invoice number; enables recurring (subscription) payments."
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0,
            "description": "ISO currency code to charge in."
          },
          "allowed_currencies": {
            "type": "string",
            "maxLength": 50,
            "minLength": 0,
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "amount": {
            "type": "number",
            "description": "Amount to be processed."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Order description (docs: maximum 100 characters)."
          },
          "callback_url": {
            "type": "string",
            "minLength": 1,
            "description": "URL Pesapal redirects the customer to after payment; OrderTrackingId, OrderMerchantReference and OrderNotificationType=CALLBACKURL are appended."
          },
          "cancellation_url": {
            "type": "string",
            "description": "URL Pesapal redirects the customer to if they cancel on the payment page."
          },
          "notification_id": {
            "type": "string",
            "format": "uuid",
            "minLength": 1,
            "description": "ipn_id of a registered IPN URL (see RegisterIPN)."
          },
          "language": {
            "type": "string",
            "maxLength": 3,
            "minLength": 0,
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "terms_and_conditions_id": {
            "type": "string",
            "format": "uuid",
            "description": "Accepted by the live API (swagger.json) but not described in the docs."
          },
          "billing_address": {
            "$ref": "#/components/schemas/MerchantOrderBillingDetailsRequestDTO",
            "description": "Customer address object. Required by the docs; phone_number or email_address must be set."
