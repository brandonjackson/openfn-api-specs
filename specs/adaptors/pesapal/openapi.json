          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/RefundRequest": {
      "post": {
        "operationId": "requestRefund",
        "summary": "Request a refund",
        "tags": [
          "Transactions"
        ],
        "description": "Request a full or partial refund of a COMPLETED payment, identified by its confirmation code. Status 200 means the request was received, not that the refund is done.",
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/refund-request"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefundRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Refund request acknowledgement.",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "\"200\" on success, \"500\" on rejection."
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/Transactions/CancelOrder": {
      "post": {
        "operationId": "cancelOrder",
        "summary": "Cancel an order",
        "tags": [
          "Transactions"
        ],
        "description": "Cancel a failed or pending order by its order tracking ID (the swagger.json lists the route as /api/transactions/cancelorder; ASP.NET routing is case-insensitive).",
        "externalDocs": {
          "url": "https://developer.pesapal.com/how-to-integrate/e-commerce/api-30-json/order-cancellation-api"
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderCancellationRequestDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Order cancellation result.",
                  "properties": {
                    "status": {
                      "type": "string",
                      "description": "\"200\" on success, \"500\" on rejection."
                    },
                    "message": {
                      "type": "string"
                    },
                    "error": {
                      "$ref": "#/components/schemas/ApiError"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
