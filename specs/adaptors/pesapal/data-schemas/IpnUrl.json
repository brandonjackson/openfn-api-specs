{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pesapal/IpnUrl",
  "title": "IpnUrl",
  "x-openfn-adaptor": "pesapal",
  "x-source": {
    "openapi": "#/components/schemas/IpnUrl",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A registered IPN (Instant Payment Notification) URL.",
  "properties": {
    "url": {
      "type": "string",
      "description": "Notification URL Pesapal sends status alerts to."
    },
    "created_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the IPN URL was registered (UTC)."
    },
    "ipn_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier of the IPN endpoint; pass it as notification_id when submitting orders."
    },
    "notification_type": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "Notification type (0 = GET, 1 = POST in the docs sample)."
    },
    "ipn_notification_type_description": {
      "type": "string",
      "description": "HTTP method the IPN URL was registered with."
    },
    "ipn_status": {
      "type": "integer",
      "enum": [
        0,
        1
      ],
      "description": "1 = Active, 0 = Inactive."
    },
    "ipn_status_description": {
      "type": "string",
      "description": "Active or Inactive."
    },
    "error": {
      "$ref": "ApiError.json"
    },
    "status": {
      "type": "string"
    }
  },
  "example": {
    "url": "https://example.com/ipn",
    "created_date": "2024-06-14T07:50:22.2825997Z",
    "ipn_id": "84740ab4-3cd9-47da-8a4f-dd1db53494b5",
    "notification_type": 0,
    "ipn_notification_type_description": "GET",
    "ipn_status": 1,
    "ipn_status_description": "Active",
    "error": null,
    "status": "200"
  }
}
