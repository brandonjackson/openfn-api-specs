{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pesapal/AccessToken",
  "title": "AccessToken",
  "x-openfn-adaptor": "pesapal",
  "x-source": {
    "openapi": "#/components/schemas/AccessToken",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Bearer token for all other API 3.0 calls; valid for about 5 minutes.",
  "properties": {
    "token": {
      "type": "string",
      "description": "The access token."
    },
    "expiryDate": {
      "type": "string",
      "format": "date-time",
      "description": "UTC expiry time of the token."
    },
    "error": {
      "$ref": "ApiError.json"
    },
    "status": {
      "type": "string",
      "description": "Response code, e.g. \"200\"."
    },
    "message": {
      "type": "string"
    }
  },
  "example": {
    "token": "<access-token>",
    "expiryDate": "2021-08-26T12:29:30.5177702Z",
    "error": null,
    "status": "200",
    "message": "Request processed successfully"
  }
}
