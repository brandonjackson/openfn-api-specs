{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/BasicChartAxis",
  "title": "BasicChartAxis",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/BasicChartAxis",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "An axis of the chart. A chart may not have more than one axis per axis position.",
  "properties": {
    "position": {
      "type": "string",
      "description": "The position of this axis.",
      "enum": [
        "BASIC_CHART_AXIS_POSITION_UNSPECIFIED",
        "BOTTOM_AXIS",
        "LEFT_AXIS",
        "RIGHT_AXIS"
      ]
    },
    "title": {
      "type": "string",
      "description": "The title of this axis. If set, this overrides any title inferred from headers of the data."
    },
    "titleTextPosition": {
      "$ref": "TextPosition.json"
    },
    "format": {
      "$ref": "TextFormat.json"
    },
    "viewWindowOptions": {
      "$ref": "ChartAxisViewWindowOptions.json"
    }
  }
}
