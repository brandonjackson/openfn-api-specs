{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/LineStyle",
  "title": "LineStyle",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/LineStyle",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "Properties that describe the style of a line.",
  "properties": {
    "width": {
      "type": "integer",
      "format": "int32",
      "description": "The thickness of the line, in px."
    },
    "type": {
      "type": "string",
      "description": "The dash type of the line.",
      "enum": [
        "LINE_DASH_TYPE_UNSPECIFIED",
        "INVISIBLE",
        "CUSTOM",
        "SOLID",
        "DOTTED",
        "MEDIUM_DASHED",
        "MEDIUM_DASHED_DOTTED",
        "LONG_DASHED",
        "LONG_DASHED_DOTTED"
      ]
    }
  }
}
