{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/TextFormat",
  "title": "TextFormat",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/TextFormat",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "The format of a run of text in a cell. Absent values indicate that the field isn't specified.",
  "properties": {
    "underline": {
      "type": "boolean",
      "description": "True if the text is underlined."
    },
    "foregroundColor": {
      "$ref": "Color.json"
    },
    "strikethrough": {
      "type": "boolean",
      "description": "True if the text has a strikethrough."
    },
    "bold": {
      "type": "boolean",
      "description": "True if the text is bold."
    },
    "italic": {
      "type": "boolean",
      "description": "True if the text is italicized."
    },
    "fontFamily": {
      "type": "string",
      "description": "The font family."
    },
    "foregroundColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "link": {
      "$ref": "Link.json"
    },
    "fontSize": {
      "type": "integer",
      "format": "int32",
      "description": "The size of the font."
    }
  }
}
