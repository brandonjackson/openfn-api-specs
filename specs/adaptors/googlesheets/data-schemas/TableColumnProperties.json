{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/TableColumnProperties",
  "title": "TableColumnProperties",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/TableColumnProperties",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "The table column.",
  "properties": {
    "dataValidationRule": {
      "$ref": "TableColumnDataValidationRule.json"
    },
    "columnName": {
      "type": "string",
      "description": "The column name."
    },
    "columnIndex": {
      "type": "integer",
      "format": "int32",
      "description": "The 0-based column index. This index is relative to its position in the table and is not necessarily the same as the column index in the sheet."
    },
    "columnType": {
      "type": "string",
      "description": "The column type.",
      "enum": [
        "COLUMN_TYPE_UNSPECIFIED",
        "DOUBLE",
        "CURRENCY",
        "PERCENT",
        "DATE",
        "TIME",
        "DATE_TIME",
        "TEXT",
        "BOOLEAN",
        "DROPDOWN",
        "FILES_CHIP",
        "PEOPLE_CHIP",
        "FINANCE_CHIP",
        "PLACE_CHIP",
        "RATINGS_CHIP"
      ]
    }
  }
}
