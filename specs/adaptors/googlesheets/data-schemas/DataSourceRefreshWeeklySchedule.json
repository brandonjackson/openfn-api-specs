{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/DataSourceRefreshWeeklySchedule",
  "title": "DataSourceRefreshWeeklySchedule",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/DataSourceRefreshWeeklySchedule",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A weekly schedule for data to refresh on specific days in a given time interval.",
  "properties": {
    "daysOfWeek": {
      "type": "array",
      "description": "Days of the week to refresh. At least one day must be specified.",
      "items": {
        "type": "string",
        "enum": [
          "DAY_OF_WEEK_UNSPECIFIED",
          "MONDAY",
          "TUESDAY",
          "WEDNESDAY",
          "THURSDAY",
          "FRIDAY",
          "SATURDAY",
          "SUNDAY"
        ]
      }
    },
    "startTime": {
      "$ref": "TimeOfDay.json"
    }
  }
}
