{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/ChartSpec",
  "title": "ChartSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/ChartSpec",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "The specifications of a chart.",
  "properties": {
    "scorecardChart": {
      "$ref": "ScorecardChartSpec.json"
    },
    "bubbleChart": {
      "$ref": "BubbleChartSpec.json"
    },
    "orgChart": {
      "$ref": "OrgChartSpec.json"
    },
    "fontName": {
      "type": "string",
      "description": "The name of the font to use by default for all chart text (e.g. title, axis labels, legend). If a font is specified for a specific part of the chart it will override this font name."
    },
    "dataSourceChartProperties": {
      "$ref": "DataSourceChartProperties.json"
    },
    "altText": {
      "type": "string",
      "description": "The alternative text that describes the chart. This is often used for accessibility."
    },
    "backgroundColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "title": {
      "type": "string",
      "description": "The title of the chart."
    },
    "waterfallChart": {
      "$ref": "WaterfallChartSpec.json"
    },
    "maximized": {
      "type": "boolean",
      "description": "True to make a chart fill the entire space in which it's rendered with minimum padding. False to use the default padding. (Not applicable to Geo and Org charts.)"
    },
    "filterSpecs": {
      "type": "array",
      "description": "The filters applied to the source data of the chart. Only supported for data source charts.",
      "items": {
        "$ref": "FilterSpec.json"
      }
    },
    "treemapChart": {
      "$ref": "TreemapChartSpec.json"
    },
    "titleTextFormat": {
      "$ref": "TextFormat.json"
    },
    "backgroundColor": {
      "$ref": "Color.json"
    },
    "candlestickChart": {
      "$ref": "CandlestickChartSpec.json"
    },
    "titleTextPosition": {
      "$ref": "TextPosition.json"
    },
    "subtitle": {
      "type": "string",
      "description": "The subtitle of the chart."
    },
    "sortSpecs": {
      "type": "array",
      "description": "The order to sort the chart data by. Only a single sort spec is supported. Only supported for data source charts.",
      "items": {
        "$ref": "SortSpec.json"
      }
    },
    "hiddenDimensionStrategy": {
      "type": "string",
      "description": "Determines how the charts will use hidden rows or columns.",
      "enum": [
        "CHART_HIDDEN_DIMENSION_STRATEGY_UNSPECIFIED",
        "SKIP_HIDDEN_ROWS_AND_COLUMNS",
        "SKIP_HIDDEN_ROWS",
        "SKIP_HIDDEN_COLUMNS",
        "SHOW_ALL"
      ]
    },
    "histogramChart": {
      "$ref": "HistogramChartSpec.json"
    },
    "basicChart": {
      "$ref": "BasicChartSpec.json"
    },
    "subtitleTextFormat": {
      "$ref": "TextFormat.json"
    },
    "pieChart": {
      "$ref": "PieChartSpec.json"
    },
    "subtitleTextPosition": {
      "$ref": "TextPosition.json"
    }
  }
}
