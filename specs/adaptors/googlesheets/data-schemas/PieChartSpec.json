{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/PieChartSpec",
  "title": "PieChartSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/PieChartSpec",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "A pie chart.",
  "properties": {
    "legendPosition": {
      "type": "string",
      "description": "Where the legend of the pie chart should be drawn.",
      "enum": [
        "PIE_CHART_LEGEND_POSITION_UNSPECIFIED",
        "BOTTOM_LEGEND",
        "LEFT_LEGEND",
        "RIGHT_LEGEND",
        "TOP_LEGEND",
        "NO_LEGEND",
        "LABELED_LEGEND"
      ]
    },
    "series": {
      "$ref": "ChartData.json"
    },
    "threeDimensional": {
      "type": "boolean",
      "description": "True if the pie is three dimensional."
    },
    "domain": {
      "$ref": "ChartData.json"
    },
    "pieHole": {
      "type": "number",
      "format": "double",
      "description": "The size of the hole in the pie chart."
    }
  }
}
