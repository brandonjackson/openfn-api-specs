{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/WaterfallChartSpec",
  "title": "WaterfallChartSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/WaterfallChartSpec",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "A waterfall chart.",
  "properties": {
    "stackedType": {
      "type": "string",
      "description": "The stacked type.",
      "enum": [
        "WATERFALL_STACKED_TYPE_UNSPECIFIED",
        "STACKED",
        "SEQUENTIAL"
      ]
    },
    "series": {
      "type": "array",
      "description": "The data this waterfall chart is visualizing.",
      "items": {
        "$ref": "WaterfallChartSeries.json"
      }
    },
    "totalDataLabel": {
      "$ref": "DataLabel.json"
    },
    "domain": {
      "$ref": "WaterfallChartDomain.json"
    },
    "hideConnectorLines": {
      "type": "boolean",
      "description": "True to hide connector lines between columns."
    },
    "connectorLineStyle": {
      "$ref": "LineStyle.json"
    },
    "firstValueIsTotal": {
      "type": "boolean",
      "description": "True to interpret the first value as a total."
    }
  }
}
