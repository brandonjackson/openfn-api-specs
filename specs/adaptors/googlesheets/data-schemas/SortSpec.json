{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/SortSpec",
  "title": "SortSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/SortSpec",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "A sort order associated with a specific column or row.",
  "properties": {
    "dataSourceColumnReference": {
      "$ref": "DataSourceColumnReference.json"
    },
    "foregroundColor": {
      "$ref": "Color.json"
    },
    "foregroundColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "backgroundColor": {
      "$ref": "Color.json"
    },
    "dimensionIndex": {
      "type": "integer",
      "format": "int32",
      "description": "The dimension the sort should be applied to."
    },
    "sortOrder": {
      "type": "string",
      "description": "The order data should be sorted.",
      "enum": [
        "SORT_ORDER_UNSPECIFIED",
        "ASCENDING",
        "DESCENDING"
      ]
    },
    "backgroundColorStyle": {
      "$ref": "ColorStyle.json"
    }
  }
}
