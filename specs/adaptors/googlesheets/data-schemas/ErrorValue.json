{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/ErrorValue",
  "title": "ErrorValue",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/ErrorValue",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "An error in a cell.",
  "properties": {
    "message": {
      "type": "string",
      "description": "A message with more information about the error (in the spreadsheet's locale)."
    },
    "type": {
      "type": "string",
      "description": "The type of error.",
      "enum": [
        "ERROR_TYPE_UNSPECIFIED",
        "ERROR",
        "NULL_VALUE",
        "DIVIDE_BY_ZERO",
        "VALUE",
        "REF",
        "NAME",
        "NUM",
        "N_A",
        "LOADING"
      ]
    }
  }
