{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/SlicerSpec",
  "title": "SlicerSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/SlicerSpec",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "The specifications of a slicer.",
  "properties": {
    "textFormat": {
      "$ref": "TextFormat.json"
    },
    "horizontalAlignment": {
      "type": "string",
      "description": "The horizontal alignment of title in the slicer. If unspecified, defaults to `LEFT`",
      "enum": [
        "HORIZONTAL_ALIGN_UNSPECIFIED",
        "LEFT",
        "CENTER",
        "RIGHT"
      ]
    },
    "dataRange": {
      "$ref": "GridRange.json"
    },
    "filterCriteria": {
      "$ref": "FilterCriteria.json"
    },
    "backgroundColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "columnIndex": {
      "type": "integer",
      "format": "int32",
      "description": "The zero-based column index in the data table on which the filter is applied to."
    },
    "backgroundColor": {
      "$ref": "Color.json"
    },
    "applyToPivotTables": {
      "type": "boolean",
      "description": "True if the filter should apply to pivot tables. If not set, default to `True`."
    },
    "title": {
      "type": "string",
      "description": "The title of the slicer."
    }
  }
}
