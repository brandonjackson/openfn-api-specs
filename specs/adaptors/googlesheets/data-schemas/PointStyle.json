{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/PointStyle",
  "title": "PointStyle",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/PointStyle",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "The style of a point on the chart.",
  "properties": {
    "size": {
      "type": "number",
      "format": "double",
      "description": "The point size. If empty, a default size is used."
    },
    "shape": {
      "type": "string",
      "description": "The point shape. If empty or unspecified, a default shape is used.",
      "enum": [
        "POINT_SHAPE_UNSPECIFIED",
        "CIRCLE",
        "DIAMOND",
        "HEXAGON",
        "PENTAGON",
        "SQUARE",
        "STAR",
        "TRIANGLE",
        "X_MARK"
      ]
    }
  }
}
