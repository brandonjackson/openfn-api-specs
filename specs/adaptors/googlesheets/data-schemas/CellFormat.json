{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/CellFormat",
  "title": "CellFormat",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/CellFormat",
    "capturedAt": "2026-07-06"
  },
  "type": "object",
  "description": "The format of a cell.",
  "properties": {
    "textDirection": {
      "type": "string",
      "description": "The direction of the text in the cell.",
      "enum": [
        "TEXT_DIRECTION_UNSPECIFIED",
        "LEFT_TO_RIGHT",
        "RIGHT_TO_LEFT"
      ]
    },
    "verticalAlignment": {
      "type": "string",
      "description": "The vertical alignment of the value in the cell.",
      "enum": [
        "VERTICAL_ALIGN_UNSPECIFIED",
        "TOP",
        "MIDDLE",
        "BOTTOM"
      ]
    },
    "numberFormat": {
      "$ref": "NumberFormat.json"
    },
    "borders": {
      "$ref": "Borders.json"
    },
    "textFormat": {
      "$ref": "TextFormat.json"
    },
    "padding": {
      "$ref": "Padding.json"
    },
    "horizontalAlignment": {
      "type": "string",
      "description": "The horizontal alignment of the value in the cell.",
      "enum": [
        "HORIZONTAL_ALIGN_UNSPECIFIED",
        "LEFT",
        "CENTER",
        "RIGHT"
      ]
    },
    "wrapStrategy": {
      "type": "string",
      "description": "The wrap strategy for the value in the cell.",
      "enum": [
        "WRAP_STRATEGY_UNSPECIFIED",
        "OVERFLOW_CELL",
        "LEGACY_WRAP",
        "CLIP",
        "WRAP"
      ]
    },
    "hyperlinkDisplayType": {
      "type": "string",
      "description": "If one exists, how a hyperlink should be displayed in the cell.",
      "enum": [
        "HYPERLINK_DISPLAY_TYPE_UNSPECIFIED",
        "LINKED",
        "PLAIN_TEXT"
      ]
    },
    "backgroundColor": {
      "$ref": "Color.json"
    },
    "backgroundColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "textRotation": {
      "$ref": "TextRotation.json"
    }
  }
}
