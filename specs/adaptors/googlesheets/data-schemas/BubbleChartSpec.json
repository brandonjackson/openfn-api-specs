{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "googlesheets/BubbleChartSpec",
  "title": "BubbleChartSpec",
  "x-openfn-adaptor": "googlesheets",
  "x-source": {
    "openapi": "#/components/schemas/BubbleChartSpec",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A bubble chart.",
  "properties": {
    "groupIds": {
      "$ref": "ChartData.json"
    },
    "bubbleMaxRadiusSize": {
      "type": "integer",
      "format": "int32",
      "description": "The max radius size of the bubbles, in pixels. If specified, the field must be a positive value."
    },
    "legendPosition": {
      "type": "string",
      "description": "Where the legend of the chart should be drawn.",
      "enum": [
        "BUBBLE_CHART_LEGEND_POSITION_UNSPECIFIED",
        "BOTTOM_LEGEND",
        "LEFT_LEGEND",
        "RIGHT_LEGEND",
        "TOP_LEGEND",
        "NO_LEGEND",
        "INSIDE_LEGEND"
      ]
    },
    "bubbleLabels": {
      "$ref": "ChartData.json"
    },
    "bubbleMinRadiusSize": {
      "type": "integer",
      "format": "int32",
      "description": "The minimum radius size of the bubbles, in pixels. If specific, the field must be a positive value."
    },
    "bubbleSizes": {
      "$ref": "ChartData.json"
    },
    "bubbleBorderColor": {
      "$ref": "Color.json"
    },
    "bubbleBorderColorStyle": {
      "$ref": "ColorStyle.json"
    },
    "domain": {
      "$ref": "ChartData.json"
    },
    "bubbleOpacity": {
      "type": "number",
      "format": "float",
      "description": "The opacity of the bubbles between 0 and 1.0. 0 is fully transparent and 1 is fully opaque."
    },
    "series": {
      "$ref": "ChartData.json"
    },
    "bubbleTextStyle": {
      "$ref": "TextFormat.json"
    }
  }
}
