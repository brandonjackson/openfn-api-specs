{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openelis/FhirResource",
  "title": "FhirResource",
  "x-openfn-adaptor": "openelis",
  "x-source": {
    "openapi": "#/components/schemas/FhirResource",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Any FHIR R4 resource. Only the elements every resource carries are declared; the rest of the resource body varies by `resourceType` and is passed through.",
  "additionalProperties": true,
  "required": [
    "resourceType"
  ],
  "properties": {
    "resourceType": {
      "type": "string",
      "description": "FHIR resource type, e.g. `ServiceRequest`."
    },
    "id": {
      "type": "string",
      "description": "Logical id of the resource."
    },
    "meta": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "versionId": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "example": {
    "resourceType": "ServiceRequest",
    "id": "servicerequest-0001",
    "status": "active",
    "intent": "order",
    "subject": {
      "reference": "Patient/patient-0001"
    }
  }
}
