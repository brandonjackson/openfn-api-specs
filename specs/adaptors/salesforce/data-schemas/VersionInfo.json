{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "salesforce/VersionInfo",
  "title": "VersionInfo",
  "x-openfn-adaptor": "salesforce",
  "x-source": {
    "openapi": "#/components/schemas/VersionInfo",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One available Salesforce API version.",
  "properties": {
    "label": {
      "type": "string",
      "description": "Release label.",
      "example": "Summer '26"
    },
    "url": {
      "type": "string",
      "description": "Root URI of the version's resources.",
