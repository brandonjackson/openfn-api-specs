{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rapidpro/Contact",
  "title": "Contact",
  "x-openfn-adaptor": "rapidpro",
  "x-source": {
    "openapi": "#/components/schemas/Contact",
    "capturedAt": "2026-09-14"
  },
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string",
      "description": "Contact's unique identifier."
    },
    "name": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "blocked",
        "stopped",
        "archived"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "description": "3-letter ISO 639-3 code."
    },
    "urns": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Associated URNs, e.g. 'tel:+12065551212'."
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "ObjectRef.json"
      }
    },
    "fields": {
      "type": "object",
      "additionalProperties": true,
      "description": "Custom contact field values, keyed by field key."
    },
    "flow": {
      "allOf": [
        {
          "$ref": "ObjectRef.json"
        }
      ],
      "description": "The flow the contact is currently in, if any."
    },
    "created_on": {
      "type": "string",
      "format": "date-time"
    },
    "modified_on": {
      "type": "string",
      "format": "date-time"
    },
    "last_seen_on": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
