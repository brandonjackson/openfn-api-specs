{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rapidpro/Broadcast",
  "title": "Broadcast",
  "x-openfn-adaptor": "rapidpro",
  "x-source": {
    "openapi": "#/components/schemas/Broadcast",
    "capturedAt": "2026-09-14"
  },
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string"
    },
    "urns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "ObjectRef.json"
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "ObjectRef.json"
      }
    },
    "text": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Message text per language code, e.g. {\"eng\": \"Hello\"}."
    },
    "attachments": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "description": "Attachment URLs per language code."
    },
    "quick_replies": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "description": "Quick reply option sets per language code."
    },
    "base_language": {
      "type": "string",
      "description": "Default translation language code."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "queued",
        "started",
        "completed",
        "failed",
        "interrupted"
      ]
    },
    "created_on": {
      "type": "string",
      "format": "date-time"
    }
  }
}
