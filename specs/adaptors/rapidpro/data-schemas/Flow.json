{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rapidpro/Flow",
  "title": "Flow",
  "x-openfn-adaptor": "rapidpro",
  "x-source": {
    "openapi": "#/components/schemas/Flow",
    "capturedAt": "2026-09-14"
  },
  "type": "object",
  "properties": {
    "uuid": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "voice",
        "survey"
      ]
    },
    "archived": {
      "type": "boolean"
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "ObjectRef.json"
      }
    },
    "expires": {
      "type": "integer",
      "description": "Minutes of inactivity before a contact's run in this flow expires."
    },
    "runs": {
      "type": "object",
      "properties": {
        "active": {
          "type": "integer"
        },
        "completed": {
          "type": "integer"
        },
        "interrupted": {
          "type": "integer"
        },
        "expired": {
          "type": "integer"
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "The result keys this flow may save."
    },
    "parent_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_on": {
      "type": "string",
      "format": "date-time"
    },
    "modified_on": {
      "type": "string",
      "format": "date-time"
    }
  }
}
