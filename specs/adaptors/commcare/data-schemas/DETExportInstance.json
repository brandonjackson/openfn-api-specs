{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/DETExportInstance",
  "title": "DETExportInstance",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/DETExportInstance",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A Data Export Tool export instance and the URL of its config file.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Export instance identifier."
    },
    "name": {
      "type": "string",
      "description": "Export name."
    },
    "type": {
      "type": "string",
      "description": "Export type.",
      "enum": [
        "case",
        "form"
      ]
    },
    "export_format": {
      "type": "string",
      "description": "File format of the export, e.g. `csv` or `xlsx`."
    },
    "is_deidentified": {
      "type": "boolean",
      "description": "Whether the export is de-identified."
    },
    "case_type": {
      "type": [
        "string",
        "null"
      ],
      "description": "Case type exported, for case exports."
    },
    "xmlns": {
      "type": [
        "string",
        "null"
      ],
      "description": "Form XML namespace exported, for form exports."
    },
    "det_config_url": {
      "type": "string",
      "description": "Absolute URL of the Data Export Tool config file."
    }
  },
  "additionalProperties": true
}
