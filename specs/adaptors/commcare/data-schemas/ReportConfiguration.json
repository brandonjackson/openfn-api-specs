      "description": "Columns of the report."
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "ReportFilterConfig.json"
      },
      "description": "Filters the report accepts."
    },
    "resource_uri": {
      "type": "string",
      "description": "Tastypie resource URI."
    }
  },
  "additionalProperties": true
