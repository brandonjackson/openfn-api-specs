{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/Application",
  "title": "Application",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/Application",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "An application (CommCare app) and its module/form/question structure.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Application UUID."
    },
    "name": {
      "type": "string",
      "description": "Application name."
    },
    "version": {
      "type": "integer",
      "description": "Application version number."
    },
    "built_on": {
      "type": [
        "string",
        "null"
      ],
      "description": "When this build was made.",
      "format": "date-time"
    },
    "build_comment": {
      "type": [
        "string",
        "null"
      ],
      "description": "Comment recorded with the build."
    },
    "is_released": {
      "type": "boolean",
      "description": "Whether the build is marked released."
    },
    "built_from_app_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Application this build was made from."
    },
    "case_types": {
      "type": "object",
      "description": "Case properties per case type used by the app.",
      "properties": {},
      "additionalProperties": true
    },
    "modules": {
      "type": "array",
      "items": {
        "$ref": "ApplicationModule.json"
      },
      "description": "The modules of the application."
    },
    "versions_url": {
      "type": "string",
      "description": "URL listing the builds of this application."
    }
  },
  "additionalProperties": true
}
