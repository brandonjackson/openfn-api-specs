{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/WebUser",
  "title": "WebUser",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/WebUser",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A web user (a CommCare HQ account with access to the project space).",
  "properties": {
    "id": {
      "type": "string",
      "description": "User UUID."
    },
    "username": {
      "type": "string",
      "description": "Login email address."
    },
    "email": {
      "type": "string",
      "description": "Email address."
    },
    "first_name": {
      "type": "string",
      "description": "Given name."
    },
    "last_name": {
      "type": "string",
      "description": "Family name."
    },
    "is_admin": {
      "type": "boolean",
      "description": "Whether the user is a project-space admin."
    },
    "role": {
      "type": "string",
      "description": "Name of the user's role."
    },
    "permissions": {
      "$ref": "WebUserPermissions.json"
    },
    "default_phone_number": {
      "type": [
        "string",
        "null"
      ],
      "description": "Primary phone number."
    },
    "phone_numbers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "All phone numbers on the account."
    },
    "resource_uri": {
      "type": "string",
      "description": "Tastypie resource URI."
    }
  },
  "additionalProperties": true
}
