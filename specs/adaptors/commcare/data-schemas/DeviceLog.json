{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/DeviceLog",
  "title": "DeviceLog",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/DeviceLog",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One device log entry uploaded from a mobile device.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Log entry id."
    },
    "domain": {
      "type": "string",
      "description": "Project space."
    },
    "date": {
      "type": "string",
      "description": "When the entry was logged on the device.",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "Log category."
    },
    "msg": {
      "type": "string",
      "description": "Log message."
    },
    "app_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Application version on the device."
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Device identifier."
    },
    "username": {
      "type": [
        "string",
        "null"
      ],
      "description": "User the device was logged in as."
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "UUID of the user."
    },
    "xform_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Form submission that carried the log."
    },
    "resource_uri": {
      "type": "string",
      "description": "Tastypie resource URI."
    }
  },
  "additionalProperties": true
}
