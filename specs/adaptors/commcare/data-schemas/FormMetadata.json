{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/FormMetadata",
  "title": "FormMetadata",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/FormMetadata",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Device and timing metadata captured with the submission.",
  "properties": {
    "appVersion": {
      "type": [
        "string",
        "null"
      ],
      "description": "CommCare version string reported by the device."
    },
    "app_build_version": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Application build number."
    },
    "commcare_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "CommCare mobile version."
    },
    "deprecatedID": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the submission this one replaces."
    },
    "deviceID": {
      "type": [
        "string",
        "null"
      ],
      "description": "Identifier of the submitting device."
    },
    "doc_type": {
      "type": "string",
      "description": "Always `Metadata`."
    },
    "geo_point": {
      "type": [
        "string",
        "null"
      ],
      "description": "Location recorded with the submission."
    },
    "instanceID": {
      "type": "string",
      "description": "Unique identifier of the form instance."
    },
    "location": {
      "type": [
        "string",
        "null"
      ],
      "description": "Location recorded with the submission."
    },
    "timeEnd": {
      "type": "string",
      "description": "When the form was completed."
    },
    "timeStart": {
      "type": "string",
      "description": "When the form was started."
    },
    "userID": {
      "type": "string",
      "description": "UUID of the submitting user."
    },
    "username": {
      "type": "string",
      "description": "Username of the submitting user."
    }
  },
  "additionalProperties": true
}
