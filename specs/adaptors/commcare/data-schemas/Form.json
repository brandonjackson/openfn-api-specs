{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/Form",
  "title": "Form",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/Form",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A form submission. `form` holds the submitted XForm converted to JSON.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Form submission UUID (the XForm instance id)."
    },
    "domain": {
      "type": "string",
      "description": "Project space the submission belongs to."
    },
    "app_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Application the form belongs to."
    },
    "build_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Application build the form was submitted from."
    },
    "archived": {
      "type": "boolean",
      "description": "Whether the submission has been archived."
    },
    "attachments": {
      "type": "object",
      "description": "Attachments on the submission, keyed by file name.",
      "properties": {},
      "additionalProperties": true
    },
    "form": {
      "type": "object",
      "description": "The submitted form data, as JSON.",
      "properties": {},
      "additionalProperties": true
    },
    "metadata": {
      "$ref": "FormMetadata.json"
    },
    "initial_processing_complete": {
      "type": "boolean",
      "description": "Whether server-side processing finished."
    },
    "is_phone_submission": {
      "type": "boolean",
      "description": "Whether the submission came from a mobile device."
    },
    "problem": {
      "type": [
        "string",
        "null"
      ],
      "description": "Processing error, when the submission failed."
    },
    "received_on": {
      "type": "string",
      "description": "When the server received the submission.",
      "format": "date-time"
    },
    "server_modified_on": {
      "type": "string",
      "description": "When the submission was last modified on the server.",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "description": "Form document type, normally `data`."
    },
    "uiversion": {
      "type": [
        "string",
        "null"
      ],
      "description": "Form UI version."
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "description": "Form version."
    },
    "md5": {
      "type": "string",
      "description": "Obsolete; always `OBSOLETED`."
    },
    "resource_uri": {
      "type": "string",
      "description": "Tastypie resource URI."
    }
  },
  "additionalProperties": true
}
