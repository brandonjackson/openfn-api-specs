{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commcare/Case",
  "title": "Case",
  "x-openfn-adaptor": "commcare",
  "x-source": {
    "openapi": "#/components/schemas/Case",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A case as returned by the Case Data API v1. Editable case properties live under `properties`.",
  "properties": {
    "case_id": {
      "type": "string",
      "description": "Case UUID."
    },
    "domain": {
      "type": "string",
      "description": "Project space the case belongs to."
    },
    "closed": {
      "type": "boolean",
      "description": "Whether the case is closed."
    },
    "date_closed": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the case was closed.",
      "format": "date-time"
    },
    "date_modified": {
      "type": "string",
      "description": "When the case was last modified on the device.",
      "format": "date-time"
    },
    "server_date_modified": {
      "type": "string",
      "description": "When the case was last modified on the server.",
      "format": "date-time"
    },
    "server_date_opened": {
      "type": [
        "string",
        "null"
      ],
      "description": "When the case first reached the server.",
      "format": "date-time"
    },
    "user_id": {
      "type": "string",
      "description": "UUID of the user that last modified the case."
    },
    "indices": {
      "type": "object",
      "description": "References to other cases, keyed by index name.",
      "properties": {},
      "additionalProperties": true
    },
    "properties": {
      "type": "object",
      "description": "Special and user-defined case properties.",
      "properties": {
        "case_name": {
          "type": "string",
          "description": "Name of the case."
        },
        "case_type": {
          "type": "string",
          "description": "Type of the case."
        },
        "date_opened": {
          "type": "string",
          "description": "When the case was opened.",
          "format": "date-time"
        },
        "external_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "External identifier."
        },
        "owner_id": {
          "type": [
            "string",
            "null"
          ],
          "description": "Owning user or group UUID."
        }
      },
      "additionalProperties": true
    },
    "version": {
      "type": "string",
      "description": "Case XML version."
    },
    "xform_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identifiers of the forms that touched this case."
    },
    "resource_uri": {
      "type": "string",
      "description": "Tastypie resource URI."
    }
  },
  "additionalProperties": true,
  "example": {
    "case_id": "45WKYXQRFFU3AT4Y022EX7HF2",
    "closed": false,
    "date_closed": null,
    "date_modified": "2012-03-13T18:21:52Z",
    "domain": "demo",
    "indices": {},
    "properties": {
      "case_name": "Example case",
      "case_type": "programmer",
      "date_opened": "2012-03-13T18:21:52Z",
      "external_id": "45WKYXQRFFU3AT4Y022EX7HF2",
      "owner_id": null
    },
    "server_date_modified": "2012-04-05T23:56:41Z",
    "server_date_opened": "2012-04-05T23:56:41Z",
    "user_id": "06414101dc45bcfdc963b8cb1a1ebdfd",
    "version": "1.0",
    "xform_ids": [
      "3HQEXR2S0GIRFY2GF40HAR7ZE"
    ]
  }
}
