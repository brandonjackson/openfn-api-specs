{
  "openapi": "3.0.3",
  "info": {
    "title": "Dagu pharmacy / dispensing API",
    "version": "unknown",
    "description": "Dagu is Ethiopia's facility-level pharmaceutical management system (store inventory plus the dispensing-unit patient service module), deployed per facility/region with EPSS. The dagu adaptor logs in with POST /account/login and then calls {baseUrl}/{path} with a Bearer token via get/post/request (JSON or multipart form bodies). Dagu's API reference is not public; this document covers the login endpoint and the four paths named in the adaptor's examples and tests.",
    "x-openfn-adaptor": "dagu"
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "description": "Dagu instance (configuration.baseUrl).",
      "variables": {
        "baseUrl": {
          "default": "https://dagu.example.org",
          "description": "Placeholder; instance-specific."
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "Dispensing Unit"
    },
    {
      "name": "Patient"
    }
  ],
  "paths": {
    "/account/login": {
      "post": {
        "operationId": "login",
        "summary": "Log in and get an access token",
        "tags": [
          "Account"
        ],
        "security": [],
        "description": "Called once per process by the adaptor (the token is cached).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          }
        }
      }
    },
    "/DispensingUnit/Dashboard/StockOutReport": {
      "get": {
        "operationId": "getStockOutReport",
        "summary": "Get the dispensing unit stock-out report",
        "tags": [
          "Dispensing Unit"
        ],
        "responses": {
          "200": {
            "description": "Report.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StockOutReport"
                }
              }
            }
          }
        }
      }
    },
    "/DispensingUnit/Request/History": {
      "post": {
        "operationId": "getRequestHistory",
        "summary": "Search dispensing-unit request history",
        "tags": [
          "Dispensing Unit"
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataTablesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A page of history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestHistory"
                }
              }
            }
          }
        }
      }
    },
    "/Patient/CheckPrescription": {
      "post": {
        "operationId": "checkPrescription",
        "summary": "Check a prescription",
        "tags": [
          "Patient"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prescriptionRowGuid"
                ],
                "properties": {
                  "prescriptionRowGuid": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Check result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrescriptionCheck"
                }
              }
            }
          }
        }
      }
    },
    "/Patient/Prescription/History": {
      "post": {
        "operationId": "getPrescriptionHistory",
        "summary": "Page through patient prescription history",
        "tags": [
          "Patient"
        ],
        "description": "The adaptor example sends this as multipart form data (options.contentType = \"form\").",
        "requestBody": {
          "required": false,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/DataTablesRequest"
              }
            },
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DataTablesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A page of history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrescriptionHistory"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "token.access_token from POST /account/login."
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "object",
            "required": [
              "access_token"
            ],
            "additionalProperties": true,
            "properties": {
              "access_token": {
                "type": "string"
              }
            }
          }
        }
      },
      "StockOutItem": {
        "type": "object",
        "properties": {
          "itemName": {
            "type": "string"
          },
          "unitName": {
            "type": "string"
          },
          "itemAmc": {
            "type": "number",
            "description": "Average monthly consumption."
          }
        }
      },
      "DataTablesPage": {
        "type": "object",
        "description": "DataTables-style server-side paging block.",
        "properties": {
          "draw": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "totalRecords": {
            "type": "integer"
          },
          "totalRecordsFiltered": {
            "type": "integer"
          },
          "recordsTotal": {
            "type": "integer"
          },
          "recordsFiltered": {
            "type": "integer"
          },
          "data": {
            "description": "Rows. The vendor Swagger example (copied into the adaptor fixtures) shows a string; the element type is not documented."
          },
          "additionalParameters": {
            "type": "object",
            "additionalProperties": true
          },
          "additionalResponse": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "DataTablesRequest": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer"
          },
          "length": {
            "type": "integer"
          },
          "draw": {
            "type": "integer"
          },
          "search": {
            "type": "object",
            "additionalProperties": true
          },
          "additionalParameters": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "filter": {
                "type": "array",
                "items": {}
              }
            }
          }
        }
      },
      "StockOutReport": {
        "type": "object",
        "description": "Stock-out report for the dispensing unit.",
        "properties": {
          "result": {
            "type": "integer",
            "description": "Status code from the Dagu API envelope."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StockOutItem"
            }
          }
        }
      },
      "PrescriptionHistory": {
        "type": "object",
        "description": "A page of patient prescription history.",
        "properties": {
          "result": {
            "type": "integer",
            "description": "Status code from the Dagu API envelope."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "$ref": "#/components/schemas/DataTablesPage"
          }
        }
      },
      "RequestHistory": {
        "type": "object",
        "description": "A page of dispensing-unit request (requisition) history.",
        "properties": {
          "result": {
            "type": "integer",
            "description": "Status code from the Dagu API envelope."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "$ref": "#/components/schemas/DataTablesPage"
          }
        }
      },
      "PrescriptionCheck": {
        "type": "object",
        "description": "Result of checking a prescription.",
        "properties": {
          "result": {
            "type": "integer",
            "description": "Status code from the Dagu API envelope."
          },
          "message": {
            "type": "string",
            "nullable": true
          },
          "model": {
            "description": "Not documented; no example in the adaptor."
          }
        }
      }
    }
  }
}
