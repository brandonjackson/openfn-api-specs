{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ghana-bdr/UtilityResponse",
  "title": "UtilityResponse",
  "x-openfn-adaptor": "ghana-bdr",
  "x-source": {
    "openapi": "#/components/schemas/UtilityResponse",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Standard response envelope carrying a coded-value lookup list.",
  "properties": {
    "api_code": {
      "type": "integer",
      "example": 200,
      "description": "HTTP-style status code repeated in the body."
    },
    "api_status": {
      "type": "string",
      "example": "success",
      "description": "success or error."
    },
    "api_message": {
      "type": "string",
      "example": "Your action has been processed.",
      "description": "Human-readable outcome."
    },
    "api_data": {
      "type": "array",
      "description": "The lookup rows. Location lookups return objects; flat lookups return plain strings.",
      "items": {
        "oneOf": [
          {
            "$ref": "UtilityValue.json"
          },
          {
            "type": "string"
          }
        ]
      }
    }
  }
}
