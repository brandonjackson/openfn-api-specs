{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartodb/ApiKey",
  "title": "ApiKey",
  "x-openfn-adaptor": "cartodb",
  "x-source": {
    "openapi": "#/components/schemas/ApiKey",
    "capturedAt": "2026-11-13"
  },
  "allOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "user": {
          "properties": {
            "username": {
              "type": "string"
            }
          }
        },
        "type": {
          "$ref": "ApiKeysTypes.json"
        },
        "token": {
          "type": "string"
        },
        "grants": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "ApisGrant.json"
              },
              {
                "$ref": "GrantDatabase.json"
              }
            ]
          }
        },
        "_links": {
          "type": "object",
          "properties": {
            "self": {
              "$ref": "Links.json",
              "description": "Link to the resource"
            }
          }
        }
      }
    },
    {
      "$ref": "AuthTimestamps.json"
    }
  ],
  "required": [
    "name",
    "type",
    "grants"
  ],
  "example": {
    "name": "MyTableApi",
    "user": {
      "username": "amartin"
    },
    "type": "regular",
    "token": "moLv8B-kotcjUL-uxMhbGg",
    "grants": [
      {
        "type": "apis",
        "apis": [
          "maps"
        ]
      },
      {
        "type": "database",
        "tables": [
          {
            "schema": "public",
            "name": "my_table",
            "permissions": [
              "insert",
              "select",
              "update"
            ]
          }
        ]
      }
    ],
    "created_at": "2018-02-14 13:23:12 +0000",
    "updated_at": "2018-02-14 13:23:12 +0000",
    "_links": {
      "self": {
        "href": "http://amartin.carto.com/api/v3/api_keys/MyTableApi"
      }
    }
  }
}
