{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "et-mfr/HealthReport",
  "title": "HealthReport",
  "x-openfn-adaptor": "et-mfr",
  "x-source": {
    "openapi": "#/components/schemas/HealthReport",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Readiness report for the MFR API and the services it depends on.",
  "properties": {
    "status": {
      "type": "string",
      "description": "Overall status, e.g. Healthy."
    },
    "environment": {
      "type": "string"
    },
    "application": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "totalDurationMs": {
      "type": "number"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "HealthDependency.json"
      }
    }
  }
}
