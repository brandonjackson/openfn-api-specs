{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asana/TaskTemplateResponse",
  "title": "TaskTemplateResponse",
  "x-openfn-adaptor": "asana",
  "x-source": {
    "openapi": "#/components/schemas/TaskTemplateResponse",
    "capturedAt": "2026-07-06"
  },
  "allOf": [
    {
      "$ref": "TaskTemplateBase.json"
    },
    {
      "type": "object",
      "properties": {
        "name": {
          "description": "Name of the task template.",
          "type": "string",
          "example": "Bug Report Template"
        },
        "project": {
          "description": "The project that this task template belongs to.",
          "allOf": [
            {
              "$ref": "ProjectCompact.json"
            }
          ]
        },
        "template": {
          "description": "The configuration for the task that will be created from this template.",
          "allOf": [
            {
              "$ref": "TaskTemplateRecipe.json"
            }
          ]
        },
        "created_by": {
          "description": "The user who created this task template.",
          "allOf": [
            {
              "$ref": "UserCompact.json"
            }
          ]
        },
        "created_at": {
          "description": "The time at which this task template was created.",
          "type": "string",
          "format": "date-time",
          "example": "2019-01-01T00:00:00.000Z"
        }
      }
    }
  ]
}
