{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asana/AiStudioRunResponse",
  "title": "AiStudioRunResponse",
  "x-openfn-adaptor": "asana",
  "x-source": {
    "openapi": "#/components/schemas/AiStudioRunResponse",
    "capturedAt": "2026-07-06"
  },
  "allOf": [
    {
      "$ref": "AiStudioRunCompact.json"
    },
    {
      "type": "object",
      "description": "A single AI Studio run (rule execution). The `gid` is stable and serves as the de-duplication key for incremental loads.",
      "properties": {
        "rule": {
          "type": "object",
          "readOnly": true,
          "description": "The rule (automation) that ran, as a compact reference. The Rules API is not yet public, so this is not dereferenceable today, but the shape is forward-compatible (consumers can key off `rule.gid`).",
          "properties": {
            "gid": {
              "type": "string",
              "readOnly": true,
              "example": "1208111111111111"
            },
            "resource_type": {
              "type": "string",
              "readOnly": true,
              "example": "rule"
            },
            "name": {
              "type": "string",
              "readOnly": true,
              "example": "Auto-summarize incoming requests"
            }
          }
        },
        "rule_owner": {
          "allOf": [
            {
              "$ref": "UserCompact.json"
            },
            {
              "type": "object",
              "readOnly": true,
              "description": "The user who owns the rule.",
              "properties": {
                "email": {
                  "type": "string",
                  "readOnly": true,
                  "example": "owner@example.com"
                }
              }
            }
          ]
        },
        "triggered_by": {
          "allOf": [
            {
              "$ref": "UserCompact.json"
            },
            {
              "type": "object",
              "readOnly": true,
              "description": "The user the run executed as, and to whom the credits are attributed. Usually the same as `rule_owner`, but can differ for chained or AI-teammate-triggered runs.",
              "properties": {
                "email": {
                  "type": "string",
                  "readOnly": true,
                  "example": "runner@example.com"
                }
              }
            }
          ]
        },
        "triggering_container": {
          "type": [
            "object",
            "null"
          ],
          "readOnly": true,
          "description": "The object the rule lives in (its container) — a project or portfolio — as a compact reference. `null` if the container is unavailable.",
          "properties": {
            "gid": {
              "type": "string",
              "readOnly": true,
              "example": "1206000000000001"
            },
            "resource_type": {
              "type": "string",
              "readOnly": true,
              "enum": [
                "project",
                "portfolio"
              ],
              "example": "project"
            }
          }
        },
        "division": {
          "type": [
            "object",
            "null"
          ],
          "readOnly": true,
          "description": "The division the actor belonged to at the time of the run, as a compact reference. `null` when division metering is not enabled for the domain. Not dereferenceable yet (no public Division API); `name` reflects the division's current state.",
          "properties": {
            "gid": {
              "type": "string",
              "readOnly": true,
              "example": "1205000000000003"
            },
            "resource_type": {
              "type": "string",
              "readOnly": true,
              "example": "division"
            },
            "name": {
              "type": "string",
              "readOnly": true,
              "example": "Engineering"
            }
          }
        },
        "run_started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "readOnly": true,
          "description": "When the run was triggered.",
          "example": "2026-05-01T14:03:12.000Z"
        },
        "run_completed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "readOnly": true,
          "description": "When the run finished. `null` for runs that did not complete (e.g. cancelled). Runs still in progress don't appear in this endpoint (a usage record exists only once a run is metered), so this is non-null for every success/failed run.",
          "example": "2026-05-01T14:03:15.220Z"
        },
        "status": {
          "type": "string",
          "readOnly": true,
          "description": "The outcome of the run.",
          "enum": [
            "success",
            "failed",
            "cancelled"
          ]
        },
        "model": {
          "type": "string",
          "readOnly": true,
          "description": "The LLM model used for the run.",
          "example": "claude-sonnet-4-6"
        },
        "credits_used": {
          "type": "number",
          "readOnly": true,
          "description": "The number of credits consumed by the run.",
          "example": 12
        },
        "credit_source": {
          "type": "string",
          "readOnly": true,
          "description": "Whether the credits were drawn from a paid or free balance.",
          "enum": [
            "paid",
            "free"
          ]
        }
      }
    }
  ]
}
