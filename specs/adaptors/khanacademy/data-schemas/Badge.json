{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khanacademy/Badge",
  "title": "Badge",
  "x-openfn-adaptor": "khanacademy",
  "x-source": {
    "openapi": "#/components/schemas/Badge",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "safe_extended_description": {
      "type": "string"
    },
    "badge_category": {
      "type": "integer",
      "description": "References BadgeCategory.category."
    },
    "points": {
      "type": "integer"
    },
    "user_badges": {
      "type": "array",
      "items": {
        "$ref": "UserBadge.json"
      },
      "description": "Only present on authenticated calls, when the user has earned the badge."
    }
  },
  "required": [
    "name"
  ],
  "example": {
    "name": "greattimedproblembadge",
    "description": "Going Transonic",
    "safe_extended_description": "Quickly & correctly answer 10 exercise problems in a row",
    "badge_category": 1,
    "points": 500
  }
}
