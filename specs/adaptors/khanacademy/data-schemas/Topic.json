{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "khanacademy/Topic",
  "title": "Topic",
  "x-openfn-adaptor": "khanacademy",
  "x-source": {
    "openapi": "#/components/schemas/Topic",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A node of the content topic tree.",
  "properties": {
    "id": {
      "type": "string",
      "description": "Topic slug; 'root' is the root of the tree."
    },
    "kind": {
      "type": "string",
      "enum": [
        "Topic"
      ]
    },
    "title": {
      "type": "string"
    },
    "standalone_title": {
      "type": "string"
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "extended_slug": {
      "type": "string"
    },
    "hide": {
      "type": "boolean"
    },
    "ka_url": {
      "type": "string",
      "format": "uri"
    },
    "relative_url": {
      "type": "string"
    },
    "topic_page_url": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "children": {
      "type": "array",
      "description": "Children: abbreviated entries on /topic/{id}; full Topic/Video/Exercise objects on /topictree.",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "id",
    "kind"
  ],
  "example": {
    "id": "addition-subtraction",
    "kind": "Topic",
    "title": "Addition and subtraction",
    "standalone_title": "Addition and subtraction",
    "description": "Adding and subtracting positive and negative whole numbers.",
    "extended_slug": "math/arithmetic/addition-subtraction",
    "hide": false,
    "ka_url": "http://www.khanacademy.org/#addition-subtraction",
    "relative_url": "/#addition-subtraction",
    "topic_page_url": "/math/arithmetic/addition-subtraction",
    "tags": [],
    "children": [
      {
        "hide": false,
        "id": "addition_3",
        "kind": "Exercise",
        "title": "Addition 3",
        "url": "http://www.khanacademy.org/exercise/addition_3"
      }
    ]
  }
}
