{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "siuben-rd/Beneficiario",
  "title": "Beneficiario",
  "x-openfn-adaptor": "siuben-rd",
  "x-source": {
    "openapi": "#/components/schemas/Beneficiario",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A person's SIUBEN registry entry and the household it belongs to.",
  "required": [
    "idHogar",
    "cedula",
    "provincia",
    "provinciaCodigo",
    "nombre",
    "apellidos"
  ],
  "properties": {
    "idHogar": {
      "type": "string",
      "description": "SIUBEN household identifier."
    },
    "cedula": {
      "type": "string",
      "description": "National ID (cédula)."
    },
    "provincia": {
      "type": "string",
      "description": "Province name."
    },
    "provinciaCodigo": {
      "type": "string",
      "description": "Province code."
    },
    "nombre": {
      "type": "string",
      "description": "Given name(s)."
    },
    "apellidos": {
      "type": "string",
      "description": "Surname(s)."
    },
    "categoria_pobreza": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Poverty category assigned by SIUBEN."
    },
    "categoriaIcv": {
      "type": [
        "integer",
        "null"
      ],
      "description": "Índice de Calidad de Vida (quality-of-life index) category."
    },
    "nocontrato": {
      "type": [
        "string",
        "null"
      ],
      "description": "Programme contract number, once recorded via PUT /api/Data/update/{cedula}."
    }
  },
  "example": {
    "idHogar": "HOGAR-0001",
    "cedula": "00000000000",
    "provincia": "EXAMPLE PROVINCE",
    "provinciaCodigo": "01",
    "nombre": "EXAMPLE",
    "apellidos": "PERSON",
    "categoria_pobreza": 1,
    "categoriaIcv": 2,
    "nocontrato": null
  }
}
