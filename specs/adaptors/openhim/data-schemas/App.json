{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/App",
  "title": "App",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/App",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A console portal application (internal page, external link or ES module).",
  "required": [
    "name",
    "url"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "internal",
        "external",
        "esmodule"
      ]
    },
    "category": {
      "type": "string"
    },
    "access_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "showInPortal": {
      "type": "boolean",
      "default": true
    },
    "showInSideBar": {
      "type": "boolean"
    }
  }
}
