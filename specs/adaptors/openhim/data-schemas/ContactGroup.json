{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/ContactGroup",
  "title": "ContactGroup",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/ContactGroup",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A named group of contacts that channel alerts notify.",
  "required": [
    "group"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "group": {
      "type": "string"
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "ContactUser.json"
      }
    }
  }
}
