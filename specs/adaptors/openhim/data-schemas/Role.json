{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Role",
  "title": "Role",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Role",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A named set of permissions. `admin`, `manager` and `operator` are created by default.",
  "required": [
    "name"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "name": {
      "type": "string"
    },
    "permissions": {
      "$ref": "RolePermissions.json"
    }
  }
}
