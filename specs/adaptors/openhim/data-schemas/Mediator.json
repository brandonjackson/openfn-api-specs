{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Mediator",
  "title": "Mediator",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Mediator",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A registered mediator: an external service that transforms or orchestrates messages for OpenHIM.",
  "required": [
    "urn",
    "version",
    "name"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "urn": {
      "type": "string",
      "description": "Unique mediator URN."
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "endpoints": {
      "type": "array",
      "items": {
        "$ref": "Route.json"
      }
    },
    "defaultChannelConfig": {
      "type": "array",
      "items": {
        "$ref": "Channel.json"
      }
    },
    "configDefs": {
      "type": "array",
      "items": {
        "$ref": "MediatorConfigDef.json"
      }
    },
    "config": {
      "type": "object"
    },
    "_configModifiedTS": {
      "type": "string",
      "format": "date-time"
    },
    "_uptime": {
      "type": "number"
    },
    "_lastHeartbeat": {
      "type": "string",
      "format": "date-time"
    }
  }
}
