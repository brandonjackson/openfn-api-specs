{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/ContactUser",
  "title": "ContactUser",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/ContactUser",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A contact inside a contact group.",
  "required": [
    "user",
    "method"
  ],
  "properties": {
    "user": {
      "type": "string",
      "description": "Email address or MSISDN, depending on `method`."
    },
    "method": {
      "type": "string",
      "enum": [
        "email",
        "sms"
      ]
    },
    "maxAlerts": {
      "type": "string",
      "enum": [
        "no max",
        "1 per hour",
        "1 per day"
      ],
      "default": "no max"
    }
  }
}
