{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Transaction",
  "title": "Transaction",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Transaction",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One message that passed through the OpenHIM router, with its request, response, routes and orchestrations.",
  "required": [
    "status"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "clientID": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$",
          "description": "24-character hex MongoDB ObjectId."
        }
      ]
    },
    "clientIP": {
      "type": "string"
    },
    "parentID": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$",
          "description": "24-character hex MongoDB ObjectId."
        }
      ]
    },
    "childIDs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$",
        "description": "24-character hex MongoDB ObjectId."
      }
    },
    "channelID": {
      "allOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$",
          "description": "24-character hex MongoDB ObjectId."
        }
      ]
    },
    "request": {
      "$ref": "TransactionRequest.json"
    },
    "response": {
      "$ref": "TransactionResponse.json"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "RouteMetadata.json"
      }
    },
    "orchestrations": {
      "type": "array",
      "items": {
        "$ref": "Orchestration.json"
      }
    },
    "properties": {
      "type": "object"
    },
    "canRerun": {
      "type": "boolean",
      "default": true
    },
    "autoRetry": {
      "type": "boolean",
      "default": false
    },
    "autoRetryAttempt": {
      "type": "integer"
    },
    "wasRerun": {
      "type": "boolean",
      "default": false
    },
    "error": {
      "$ref": "ErrorDetails.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "Processing",
        "Pending Async",
        "Successful",
        "Completed",
        "Completed with error(s)",
        "Failed"
      ]
    }
  },
  "example": {
    "_id": "74786e2d3100000000000000",
    "clientID": "636c69656e742d6368770000",
    "channelID": "6368616e2d63687700000000",
    "status": "Successful",
    "request": {
      "path": "/chw/encounter",
      "method": "POST",
      "timestamp": "2024-03-01T10:05:00.000Z"
    },
    "response": {
      "status": 201,
      "timestamp": "2024-03-01T10:05:01.000Z"
    }
  }
}
