{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Certificate",
  "title": "Certificate",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Certificate",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "An X.509 certificate held in the keystore.",
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "country": {
      "type": "string"
    },
    "state": {
      "type": "string"
    },
    "locality": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "organizationUnit": {
      "type": "string"
    },
    "commonName": {
      "type": "string"
    },
    "emailAddress": {
      "type": "string"
    },
    "validity": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time"
        },
        "end": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "data": {
      "type": "string",
      "description": "PEM-encoded certificate."
    },
    "fingerprint": {
      "type": "string"
    }
  }
}
