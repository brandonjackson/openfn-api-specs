{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/ChannelAudit",
  "title": "ChannelAudit",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/ChannelAudit",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One patch in a channel's change history, recorded by the patch-history plugin.",
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "ref": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "ops": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "updatedBy": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      }
    }
  }
}
