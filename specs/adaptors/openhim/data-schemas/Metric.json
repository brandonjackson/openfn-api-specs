{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Metric",
  "title": "Metric",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Metric",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "Aggregated transaction metrics for one bucket (overall, per channel, or per time-series interval).",
  "properties": {
    "total": {
      "type": "integer"
    },
    "avgResp": {
      "type": "number"
    },
    "minResp": {
      "type": [
        "number",
        "null"
      ]
    },
    "maxResp": {
      "type": [
        "number",
        "null"
      ]
    },
    "failed": {
      "type": "integer"
    },
    "successful": {
      "type": "integer"
    },
    "processing": {
      "type": "integer"
    },
    "completed": {
      "type": "integer"
    },
    "completedWErrors": {
      "type": "integer"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "_id": {
      "type": "object",
      "description": "Bucket key: the channel and the calendar parts of the interval.",
      "properties": {
        "channelID": {
          "type": [
            "string",
            "null"
          ]
        },
        "minute": {
          "type": "integer"
        },
        "hour": {
          "type": "integer"
        },
        "day": {
          "type": "integer"
        },
        "week": {
          "type": "integer"
        },
        "month": {
          "type": "integer"
        },
        "year": {
          "type": "integer"
        }
      }
    }
  }
}
