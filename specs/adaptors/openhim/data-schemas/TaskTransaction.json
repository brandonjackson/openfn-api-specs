{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/TaskTransaction",
  "title": "TaskTransaction",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/TaskTransaction",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "One transaction queued inside a rerun task.",
  "required": [
    "tid",
    "tstatus"
  ],
  "properties": {
    "tid": {
      "type": "string",
      "description": "Id of the transaction to rerun."
    },
    "tstatus": {
      "type": "string",
      "enum": [
        "Queued",
        "Processing",
        "Completed",
        "Failed"
      ],
      "default": "Queued"
    },
    "error": {
      "type": "string"
    },
    "rerunID": {
      "type": "string"
    },
    "rerunStatus": {
      "type": "string"
    }
  }
}
