{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Channel",
  "title": "Channel",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Channel",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A channel: a urlPattern plus the routes that requests matching it are forwarded to. Only `name` and `urlPattern` are required by the OpenHIM data model.",
  "required": [
    "name",
    "urlPattern"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "urlPattern": {
      "type": "string",
      "description": "Regular expression matched against the incoming request path."
    },
    "isAsynchronousProcess": {
      "type": "boolean",
      "default": false
    },
    "maxBodyAgeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36500
    },
    "lastBodyCleared": {
      "type": "string",
      "format": "date-time"
    },
    "timeout": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600000
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "DELETE",
          "CONNECT",
          "OPTIONS",
          "TRACE",
          "PATCH"
        ]
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "http",
        "tcp",
        "tls",
        "polling"
      ],
      "default": "http"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "description": "1 is the highest priority."
    },
    "tcpPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "tcpHost": {
      "type": "string"
    },
    "pollingSchedule": {
      "type": "string"
    },
    "requestBody": {
      "type": "boolean"
    },
    "responseBody": {
      "type": "boolean"
    },
    "allow": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Client roles allowed to use the channel."
    },
    "whitelist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IP addresses allowed without client auth."
    },
    "authType": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ],
      "default": "private"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "Route.json"
      }
    },
    "matchContentTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "matchContentRegex": {
      "type": "string"
    },
    "matchContentXpath": {
      "type": "string"
    },
    "matchContentJson": {
      "type": "string"
    },
    "matchContentValue": {
      "type": "string"
    },
    "properties": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "txViewAcl": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "txViewFullAcl": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "txRerunAcl": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "$ref": "ChannelAlert.json"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled",
        "deleted"
      ],
      "default": "enabled"
    },
    "rewriteUrls": {
      "type": "boolean",
      "default": false
    },
    "addAutoRewriteRules": {
      "type": "boolean",
      "default": true
    },
    "rewriteUrlsConfig": {
      "type": "array",
      "items": {
        "$ref": "RewriteRule.json"
      }
    },
    "autoRetryEnabled": {
      "type": "boolean",
      "default": false
    },
    "autoRetryPeriodMinutes": {
      "type": "integer",
      "minimum": 1,
      "default": 60
    },
    "autoRetryMaxAttempts": {
      "type": "integer",
      "minimum": 0,
      "description": "0 means unlimited."
    },
    "updatedBy": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$",
          "description": "24-character hex MongoDB ObjectId."
        },
        "name": {
          "type": "string"
        }
      }
    }
  },
  "example": {
    "_id": "6368616e2d63687700000000",
    "name": "CHW Encounters",
    "urlPattern": "^/chw/.*$",
    "type": "http",
    "status": "enabled",
    "authType": "private",
    "methods": [
      "POST"
    ],
    "allow": [
      "chw"
    ]
  }
}
