{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openhim/Visualizer",
  "title": "Visualizer",
  "x-openfn-adaptor": "openhim",
  "x-source": {
    "openapi": "#/components/schemas/Visualizer",
    "capturedAt": "2026-09-13"
  },
  "type": "object",
  "description": "A saved console visualiser layout.",
  "required": [
    "name"
  ],
  "properties": {
    "_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{24}$",
      "description": "24-character hex MongoDB ObjectId."
    },
    "name": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "items": {
        "$ref": "EventLink.json"
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "EventLink.json"
      }
    },
    "mediators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mediator": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "display": {
            "type": "string"
          }
        }
      }
    },
    "color": {
      "type": "object",
      "properties": {
        "inactive": {
          "type": "string"
        },
        "active": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "size": {
      "type": "object",
      "properties": {
        "responsive": {
          "type": "boolean"
        },
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "padding": {
          "type": "integer"
        }
      }
    },
    "time": {
      "type": "object",
      "properties": {
        "updatePeriod": {
          "type": "integer"
        },
        "minDisplayPeriod": {
          "type": "integer"
        },
        "maxSpeed": {
          "type": "integer"
        },
        "maxTimeout": {
          "type": "integer"
        }
      }
    }
  }
}
