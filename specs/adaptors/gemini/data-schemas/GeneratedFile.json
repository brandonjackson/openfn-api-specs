{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gemini/GeneratedFile",
  "title": "GeneratedFile",
  "x-openfn-adaptor": "gemini",
  "x-source": {
    "openapi": "#/components/schemas/GeneratedFile",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "description": "A file generated on behalf of a user.",
  "properties": {
    "mimeType": {
      "type": "string",
      "description": "MIME type of the generatedFile."
    },
    "error": {
      "$ref": "Status.json"
    },
    "name": {
      "type": "string",
      "description": "Identifier. The name of the generated file. Example: `generatedFiles/abc-123`"
    },
    "state": {
      "type": "string",
      "description": "Output only. The state of the GeneratedFile.",
      "enum": [
        "STATE_UNSPECIFIED",
        "GENERATING",
        "GENERATED",
        "FAILED"
      ],
      "readOnly": true
    }
  }
}
