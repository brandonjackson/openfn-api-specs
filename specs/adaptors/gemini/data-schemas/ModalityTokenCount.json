{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gemini/ModalityTokenCount",
  "title": "ModalityTokenCount",
  "x-openfn-adaptor": "gemini",
  "x-source": {
    "openapi": "#/components/schemas/ModalityTokenCount",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
