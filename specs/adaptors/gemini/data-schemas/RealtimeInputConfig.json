{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gemini/RealtimeInputConfig",
  "title": "RealtimeInputConfig",
  "x-openfn-adaptor": "gemini",
  "x-source": {
    "openapi": "#/components/schemas/RealtimeInputConfig",
    "capturedAt": "2026-09-03"
  },
  "type": "object",
  "description": "Configures the realtime input behavior in `BidiGenerateContent`.",
  "properties": {
    "activityHandling": {
      "type": "string",
      "description": "Optional. Defines what effect activity has.",
      "enum": [
        "ACTIVITY_HANDLING_UNSPECIFIED",
        "START_OF_ACTIVITY_INTERRUPTS",
        "NO_INTERRUPTION"
      ]
    },
    "turnCoverage": {
      "type": "string",
      "description": "Optional. Defines which input is included in the user's turn.",
      "enum": [
        "TURN_COVERAGE_UNSPECIFIED",
        "TURN_INCLUDES_ONLY_ACTIVITY",
        "TURN_INCLUDES_ALL_INPUT",
        "TURN_INCLUDES_AUDIO_ACTIVITY_AND_ALL_VIDEO"
      ]
    },
    "automaticActivityDetection": {
      "$ref": "AutomaticActivityDetection.json"
    }
  }
}
