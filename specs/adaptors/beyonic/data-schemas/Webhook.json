{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/Webhook",
  "title": "Webhook",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/Webhook",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A callback URL subscribed to one event type.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique object identifier."
    },
    "user": {
      "type": "integer",
      "description": "ID of the user who created the webhook."
    },
    "event": {
      "type": "string",
      "description": "Event type.",
      "enum": [
        "payment.status.changed",
        "collection.received",
        "contact.created",
        "collectionrequest.status.changed"
      ]
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "When the webhook was created (UTC)."
    },
    "updated": {
      "type": "string",
      "format": "date-time",
      "description": "When the webhook was last modified (UTC)."
    },
    "target": {
      "type": "string",
      "description": "HTTPS URL events are POSTed to.",
      "format": "uri"
    }
  },
  "example": {
    "id": 53,
    "created": "2015-08-01T16:56:29Z",
    "updated": "2015-08-01T16:56:29Z",
    "event": "payment.status.changed",
    "target": "https://example.com/callback",
    "user": 42
  }
}
