{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/SubscriptionSettings",
  "title": "SubscriptionSettings",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/SubscriptionSettings",
    "capturedAt": "2026-11-13"
  },
  "type": [
    "object",
    "null"
  ],
  "description": "Recurring collection request settings. Dates use DD/MM/YYYY HH:MM:SS (UTC).",
  "properties": {
    "start_date": {
      "type": "string",
      "description": "Subscription start."
    },
    "end_date": {
      "type": "string",
      "description": "Subscription end; must be after start_date."
    },
    "weekdays": {
      "type": "string",
      "description": "Comma-separated weekdays, e.g. \"Monday, Tuesday\"."
    },
    "months": {
      "type": "string",
      "description": "Comma-separated months, e.g. \"January, February\"."
    },
    "frequency": {
      "type": "string",
      "description": "Comma-separated: yearly, monthly, weekly, daily, hourly, minutely."
    }
  }
}
