      "description": "Latest USD exchange rate."
    }
  },
  "example": {
    "id": 7,
    "name": "Rwandan Francs",
    "code": "RWF",
    "country": {
      "iso": "RW",
      "iso3": "RWA",
      "iso_numeric": 646,
      "name": "RWANDA",
