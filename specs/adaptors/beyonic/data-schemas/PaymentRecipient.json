{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/PaymentRecipient",
  "title": "PaymentRecipient",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/PaymentRecipient",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "One recipient of a payment (v5+ phone_nos entry).",
  "properties": {
    "phonenumber": {
      "type": "string",
      "description": "Recipient phone number, international format."
    },
    "amount": {
      "type": "string",
      "description": "Amount sent to this recipient. Decimal serialised as a string, e.g. \"3000.0000\"."
    },
    "description": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "description": "Individual payment state: new, processing, pending_confirmation, complete, error, paused, parked, paused_for_admin_action, queued, aborted."
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ],
      "description": "Latest error for this recipient."
    },
    "contact": {
      "type": "string",
      "description": "Contact ID."
    },
    "batch_id": {
      "type": "integer"
    },
    "payment_id": {
      "type": "integer"
    },
    "metadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    }
  }
}
