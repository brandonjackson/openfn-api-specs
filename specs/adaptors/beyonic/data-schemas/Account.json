{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/Account",
  "title": "Account",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/Account",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A Beyonic account (balance per currency).",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique object identifier."
    },
    "organization": {
      "type": "integer",
      "description": "ID of the organization the account belongs to."
    },
    "balance": {
      "type": "number",
      "description": "Current balance."
    },
    "currency": {
      "description": "Currency code (e.g. KES); the nested account inside a Collection transaction shows a currency ID instead.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "status": {
      "type": "string",
      "description": "active or inactive."
    },
    "label": {
      "type": "string",
      "description": "Account label (seen on the nested account in Collection samples)."
    },
    "description": {
      "type": "string"
    },
    "low_balance_threshold": {
      "type": [
        "number",
        "null"
      ]
    },
    "low_balance_notification_last_send_time": {
      "type": [
        "string",
        "null"
      ],
      "description": "Last low-balance notification time."
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "When the object was created (UTC)."
    },
    "author": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ID of the user who created the object."
    },
    "modified": {
      "type": "string",
      "format": "date-time",
      "description": "When the object was last modified (UTC)."
    },
    "updated_by": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ID of the user who last updated the object."
    }
  },
  "example": {
    "id": 1146,
    "organization": 1,
    "balance": 200,
    "currency": "KES",
    "status": "active",
    "created": "2015-02-13T04:22:31Z",
    "author": 7,
    "modified": "2015-02-26T13:00:35Z",
    "updated_by": 1
  }
}
