{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/Network",
  "title": "Network",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/Network",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "A supported mobile network.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique object identifier."
    },
    "name": {
      "type": "string"
    },
    "country": {
      "$ref": "Country.json"
    },
    "phone_regex": {
      "type": "string",
      "description": "POSIX regex for phone numbers on the network."
    }
  },
  "example": {
    "id": 15,
    "name": "HALOTEL",
    "country": {
      "iso": "TZ",
      "iso3": "TZA",
      "iso_numeric": 834,
      "name": "TANZANIA, UNITED REPUBLIC OF",
      "printable_name": "Tanzania, United Republic of",
      "phone_prefix": "255",
      "supported": true
    },
    "phone_regex": "^[[.plus-sign.]]25562[0-9]{7}"
  }
}
