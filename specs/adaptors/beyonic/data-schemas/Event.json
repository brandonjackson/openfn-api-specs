{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "beyonic/Event",
  "title": "Event",
  "x-openfn-adaptor": "beyonic",
  "x-source": {
    "openapi": "#/components/schemas/Event",
    "capturedAt": "2026-11-13"
  },
  "type": "object",
  "description": "Something that happened in your organization.",
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique object identifier."
    },
    "organization": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "description": "Event type.",
      "enum": [
        "payment.status.changed",
        "collection.received",
        "contact.created",
        "collectionrequest.status.changed"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": true,
      "description": "The object that triggered the event (Payment, Collection, Contact or CollectionRequest)."
    },
    "created": {
      "type": "string",
      "format": "date-time",
      "description": "When the object was created (UTC)."
    },
    "author": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ID of the user who created the object."
    },
    "modified": {
      "type": "string",
      "format": "date-time",
      "description": "When the object was last modified (UTC)."
    },
    "updated_by": {
      "type": [
        "integer",
        "null"
      ],
      "description": "ID of the user who last updated the object."
    }
  }
}
